<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:CharManJur.Converters"
             xmlns:local="clr-namespace:CharManJur"
             x:Class="CharManJur.App">
    <Application.Resources>
        <ResourceDictionary>
            
            <!--==Destroy Item Button Converters==-->
            <converters:DestroyModeBorderColorConverter x:Key="DestroyModeBorderColorConverter" />
            <converters:DestroyModeBorderThicknessConverter x:Key="DestroyModeBorderThicknessConverter" />
            <converters:DestroyModeBackgroundConverter x:Key="DestroyModeBackgroundConverter" />
            <converters:DestroyModeTextColorConverter x:Key="DestroyModeTextColorConverter" />
            <converters:DestroyModeButtonColorConverter x:Key="DestroyModeButtonColorConverter" />
            <converters:DestroyModeButtonTextConverter x:Key="DestroyModeButtonTextConverter" />
            <converters:DestroyModeItemBorderConverter x:Key="DestroyModeItemBorderConverter" />
            <converters:DestroyModeItemBorderThicknessConverter x:Key="DestroyModeItemBorderThicknessConverter" />

            <!--==Background Creator Converters==-->
            <converters:ConfirmButtonTextConverter x:Key="ConfirmButtonTextConverter" />
            <converters:ConfirmButtonColorConverter x:Key="ConfirmButtonColorConverter" />

            <converters:LanguageBorderConverter x:Key="LanguageBorderConverter" />
            <converters:LanguageBorderThicknessConverter x:Key="LanguageBorderThicknessConverter" />
            <converters:LanguageBackgroundConverter x:Key="LanguageBackgroundConverter" />
            <converters:EquipmentStateColorConverter x:Key="EquipmentStateColorConverter" />
