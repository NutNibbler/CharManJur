		<Compile Include="..\CharManJur\Services\Network\Protocol\*.cs" LinkBase="Network\Protocol" />
		<Compile Include="..\CharManJur\Services\Network\Transport\*.cs" LinkBase="Network\Transport" />
		<Compile Include="..\CharManJur\Services\Network\Session\*.cs" LinkBase="Network\Session" />
		<Compile Include="..\CharManJur\Models\Network\NetMessages.cs" LinkBase="Network" />
		<Compile Include="..\CharManJur\Services\Network\GmSessionHub.cs" LinkBase="Network" />
		<Compile Include="..\CharManJur\Services\Network\Security\*.cs" LinkBase="Services\Network\Security" />
		<Compile Include="..\CharManJur\Services\Network\Discovery\*.cs" LinkBase="Services\Network\Discovery" />
		<Compile Include="Network\**\*.cs" />
	</ItemGroup>

</Project>