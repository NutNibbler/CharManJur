<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:CharManJur.Converters"
             xmlns:viewmodels="clr-namespace:CharManJur.ViewModels.Godrick_LiveGame"
             x:Class="CharManJur.Views.Godrick_LiveGame.CharacterHomePage"
             Title="Character Home"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#1a1a2e">

    <Grid RowDefinitions="Auto, Auto, *, Auto"
          Padding="15"
          RowSpacing="10">

        <!-- ===== HEADER SECTION - Row 0 ===== -->
        <Border Grid.Row="0"
                Stroke="#3498db"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                Padding="10"
                BackgroundColor="#16213e">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto, Auto, Auto"
                  RowDefinitions="Auto, Auto"
                  ColumnSpacing="10"
                  RowSpacing="5">

                <Label Grid.Row="0" Grid.Column="0"
                       Text="{Binding CharacterName}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White" />

                <Label Grid.Row="0" Grid.Column="1"
                       Text="HP"
                       FontSize="14"
                       TextColor="#888888"
                       HorizontalOptions="End" />
                <Label Grid.Row="0" Grid.Column="2"
                       Text="{Binding CurrentHP}"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#2ecc71" />
                <Label Grid.Row="0" Grid.Column="3"
                       Text="/"
                       FontSize="14"
                       TextColor="#888888" />
                <Label Grid.Row="0" Grid.Column="4"
                       Text="{Binding MaxHP}"
                       FontSize="16"
                       TextColor="#888888" />

                <Label Grid.Row="0" Grid.Column="5"
                       Text="Hands"
                       FontSize="14"
                       TextColor="#888888"
                       HorizontalOptions="End" />
                <Label Grid.Row="0" Grid.Column="6"
                       Text="{Binding EquippedHands}"
                       FontSize="14"
                       TextColor="#f39c12" />

                <Label Grid.Row="1" Grid.Column="0"
                       Text="{Binding PlayerName}"
                       FontSize="14"
                       TextColor="#aaaaaa" />

                <Label Grid.Row="1" Grid.Column="1"
                       Text="Languages"
                       FontSize="14"
                       TextColor="#888888"
                       HorizontalOptions="End" />
                <Label Grid.Row="1" Grid.Column="2"
                       Text="{Binding Languages}"
                       FontSize="14"
                       TextColor="#aaaaaa"
                       Grid.ColumnSpan="3" />

                <Label Grid.Row="1" Grid.Column="5"
                       Text="Belt"
                       FontSize="14"
                       TextColor="#888888"
                       HorizontalOptions="End" />
                <Label Grid.Row="1" Grid.Column="6"
                       Text="{Binding EquippedBelt}"
                       FontSize="14"
                       TextColor="#f39c12" />

            </Grid>
        </Border>

        <!-- ===== STAT SUMMARY SECTION - Row 1 ===== -->
        <Border Grid.Row="1"
        Stroke="#3498db"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 8"
        Padding="10"
        BackgroundColor="#16213e">
            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto" ColumnSpacing="15">

                <Label Grid.Row="0" Grid.Column="0" Text="Vigor" FontSize="12" TextColor="#e74c3c" FontAttributes="Bold" />
                <Label Grid.Row="0" Grid.Column="1" Text="Agility" FontSize="12" TextColor="#f39c12" FontAttributes="Bold" />

                <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="Auto, Auto, Auto" ColumnSpacing="5">
                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding StatVigor}" FontSize="18" FontAttributes="Bold" TextColor="White" />
                    <Label Grid.Row="0" Grid.Column="1" Text="ASM:" FontSize="12" TextColor="#888888" />
                    <Label Grid.Row="0" Grid.Column="2" Text="{Binding ASMStatVigor}" FontSize="16" TextColor="#4fc3f7" />
                </Grid>
                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto, Auto, Auto" ColumnSpacing="5">
                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding StatAgility}" FontSize="18" FontAttributes="Bold" TextColor="White" />
                    <Label Grid.Row="0" Grid.Column="1" Text="ASM:" FontSize="12" TextColor="#888888" />
                    <Label Grid.Row="0" Grid.Column="2" Text="{Binding ASMStatAgility}" FontSize="16" TextColor="#4fc3f7" />
                </Grid>

                <Label Grid.Row="2" Grid.Column="0" Text="Mind" FontSize="12" TextColor="#3498db" FontAttributes="Bold" Margin="0,5,0,0" />
                <Label Grid.Row="2" Grid.Column="1" Text="Spirit" FontSize="12" TextColor="#9b59b6" FontAttributes="Bold" Margin="0,5,0,0" />

                <Grid Grid.Row="3" Grid.Column="0" ColumnDefinitions="Auto, Auto, Auto" ColumnSpacing="5">
                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding StatMind}" FontSize="18" FontAttributes="Bold" TextColor="White" />
                    <Label Grid.Row="0" Grid.Column="1" Text="ASM:" FontSize="12" TextColor="#888888" />
                    <Label Grid.Row="0" Grid.Column="2" Text="{Binding ASMStatMind}" FontSize="16" TextColor="#4fc3f7" />
                </Grid>
                <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="Auto, Auto, Auto" ColumnSpacing="5">
                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding StatSpirit}" FontSize="18" FontAttributes="Bold" TextColor="White" />
                    <Label Grid.Row="0" Grid.Column="1" Text="ASM:" FontSize="12" TextColor="#888888" />
                    <Label Grid.Row="0" Grid.Column="2" Text="{Binding ASMStatSpirit}" FontSize="16" TextColor="#4fc3f7" />
                </Grid>
            </Grid>
        </Border>

        <!-- ===== EQUIPMENT & INVENTORY SECTION - Row 2 ===== -->
        <Grid Grid.Row="2" ColumnDefinitions="0.35*, 0.65*" ColumnSpacing="10">

            <!-- LEFT: Equipment Summary - Column 0 -->
            <Border Grid.Row="0" Grid.Column="0"
        Stroke="#3498db"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 8"
        Padding="10"
        BackgroundColor="#16213e">
                <ScrollView>
                    <VerticalStackLayout Spacing="8">

                        <!-- ===== HAND SLOTS (Dynamic based on limb system) ===== -->
                        <Label Text="⚔️ Hand Slots"
                           FontAttributes="Bold"
                           FontSize="13"
                           TextColor="#f39c12" />

                        <!-- Dynamic Hand Slots Grid -->
                        <Grid x:Name="HandSlotsGrid"
                            ColumnDefinitions="*, *"
                            ColumnSpacing="5"
                            RowSpacing="3">
                            <!-- Hand slots will be generated dynamically in code-behind -->
                        </Grid>

                        <!-- Show combined label when bulky item equipped in hands -->
                        <Label Text="{Binding HandSlotsBulkyLabel}"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextColor="#f39c12"
                           HorizontalOptions="Center"
                           IsVisible="{Binding HasBulkyInHands}" />

                        <!-- ===== BELT SLOTS ===== -->
                        <Label Text="🪢 Belt Slots"
                            FontAttributes="Bold"
                            FontSize="13"
                            TextColor="#f39c12"
                            Margin="0,5,0,0" />

                        <Grid ColumnDefinitions="*, *" RowDefinitions=" *,*" ColumnSpacing="5" RowSpacing="3">
                            <!-- Belt Slot 1 -->
                            <Border Grid.Row="0" Grid.Column="0" 
                                Stroke="{Binding BeltSlot1Bulky, Converter={StaticResource BulkyBorderConverter}}"
                                StrokeThickness="{Binding BeltSlot1Bulky, Converter={StaticResource BulkyBorderThicknessConverter}}"
                                StrokeShape="RoundRectangle 4" 
                                Padding="4"
                                BackgroundColor="{Binding BeltSlot1Bulky, Converter={StaticResource BulkyBackgroundConverter}}">
                                <Label Text="{Binding BeltSlot1}" 
                                   FontSize="12" 
                                   TextColor="White"
                                   HorizontalOptions="Center" />
                            </Border>

                            <!-- Belt Slot 2 -->
                            <Border Grid.Row="0" Grid.Column="1" 
                                Stroke="{Binding BeltSlot2Bulky, Converter={StaticResource BulkyBorderConverter}}"
                                StrokeThickness="{Binding BeltSlot2Bulky, Converter={StaticResource BulkyBorderThicknessConverter}}"
                                StrokeShape="RoundRectangle 4" 
                                Padding="4"
                                BackgroundColor="{Binding BeltSlot2Bulky, Converter={StaticResource BulkyBackgroundConverter}}">
                                <Label Text="{Binding BeltSlot2}" 
                                   FontSize="12" 
                                   TextColor="White"
                                   HorizontalOptions="Center" />
                            </Border>

                            <!-- Belt Slot 3 -->
                            <Border Grid.Row="1" Grid.Column="0" 
                                Stroke="{Binding BeltSlot3Bulky, Converter={StaticResource BulkyBorderConverter}}"
                                StrokeThickness="{Binding BeltSlot3Bulky, Converter={StaticResource BulkyBorderThicknessConverter}}"
                                StrokeShape="RoundRectangle 4" 
                                Padding="4"
                                BackgroundColor="{Binding BeltSlot3Bulky, Converter={StaticResource BulkyBackgroundConverter}}">
                                <Label Text="{Binding BeltSlot3}" 
                                   FontSize="12" 
                                   TextColor="White"
                                   HorizontalOptions="Center" />
                            </Border>

                            <!-- Belt Slot 4 -->
                            <Border Grid.Row="1" Grid.Column="1" 
                                Stroke="{Binding BeltSlot4Bulky, Converter={StaticResource BulkyBorderConverter}}"
                                StrokeThickness="{Binding BeltSlot4Bulky, Converter={StaticResource BulkyBorderThicknessConverter}}"
                                StrokeShape="RoundRectangle 4" 
                                Padding="4"
                                BackgroundColor="{Binding BeltSlot4Bulky, Converter={StaticResource BulkyBackgroundConverter}}">
                                <Label Text="{Binding BeltSlot4}" 
                                   FontSize="12" 
                                   TextColor="White"
                                   HorizontalOptions="Center" />
                            </Border>
                        </Grid>

                        <!-- Show combined label when bulky item equipped in belt -->
                        <Label Text="{Binding BeltSlotsBulkyLabel}"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextColor="#f39c12"
                           HorizontalOptions="Center"
                           IsVisible="{Binding HasBulkyInBelt}" />

                        <BoxView HeightRequest="1" Color="#333333" />

                        <!-- ===== ARMOR ===== -->
                        <Label Text="🛡️ Armor"
                           FontAttributes="Bold"
                           FontSize="13"
                           TextColor="#f39c12" />

                        <Border Stroke="#444444" StrokeThickness="0.5" StrokeShape="RoundRectangle 4" Padding="5">
                            <Grid ColumnDefinitions="*, *">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding EquippedArmor}" FontSize="12" TextColor="White" />
                                <Label Grid.Row="0" Grid.Column="1" Text="Fatigue:" FontSize="11" TextColor="#888888" HorizontalOptions="End" />
                                <Label Grid.Row="0" Grid.Column="2" Text="{Binding Fatigue}" FontSize="12" TextColor="#e74c3c" />
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>
            </Border>

            <!-- RIGHT: Inventory Panel - Column 1 -->
            <Border Grid.Row="0" Grid.Column="1"
                    x:Name="InventoryBorder"
                    Stroke="{Binding IsDestroyModeActive, Converter={StaticResource DestroyModeBorderColorConverter}}"
                    StrokeThickness="{Binding IsDestroyModeActive, Converter={StaticResource DestroyModeBorderThicknessConverter}}"
                    StrokeShape="RoundRectangle 8"
                    Padding="10"
                    BackgroundColor="{Binding IsDestroyModeActive, Converter={StaticResource DestroyModeBackgroundConverter}}">
                <Grid RowDefinitions="Auto, *, Auto, Auto"
                      RowSpacing="5">

                    <!-- Inventory Header - Row 0 -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                        <Label Grid.Row="0" Grid.Column="0" 
                               Text="🎒 Inventory"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="{Binding IsDestroyModeActive, Converter={StaticResource DestroyModeTextColorConverter}}" />

                        <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="8">
                            <Label Text="{Binding InventorySlotsUsed, StringFormat='Slots: {0}'}"
                                   FontSize="11"
                                   TextColor="#aaaaaa" />
                            <Label Text="{Binding InventorySlotsTotal, StringFormat='/{0}'}"
                                   FontSize="11"
                                   TextColor="#aaaaaa" />
                            <Label Text="⚠️ ENCUMBERED"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#e74c3c"
                                   IsVisible="{Binding IsEncumbered}" />

                            <Border BackgroundColor="#ff000033"
                                    Padding="4,2"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 4"
                                    IsVisible="{Binding IsDestroyModeActive}">
                                <Label Text="🗑️ DESTROY MODE"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       TextColor="#ff4444" />
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Inventory Grid - Row 1 -->
                    <CollectionView Grid.Row="1"
                        x:Name="InventoryCollectionView"
                        ItemsSource="{Binding InventoryItems}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedInventoryItem, Mode=TwoWay}"
                        ItemsLayout="VerticalGrid, 3">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="{Binding IsDestroyMode, Converter={StaticResource DestroyModeItemBorderConverter}}"
                                        StrokeThickness="{Binding IsDestroyMode, Converter={StaticResource DestroyModeItemBorderThicknessConverter}}"
                                        StrokeShape="RoundRectangle 4"
                                        Padding="6"
                                        Margin="2"
                                        BackgroundColor="{Binding IsEmpty, Converter={StaticResource EmptyItemColorConverter}}">
                                    <VerticalStackLayout Spacing="1">
                                        <Label Text="{Binding DisplayName}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Quantity, StringFormat='x{0}'}"
                                               FontSize="9"
                                               TextColor="#888888"
                                               IsVisible="{Binding Quantity, Converter={StaticResource IsGreaterThanOneConverter}}" />
                                        <Label Text="⚠️ Empty"
                                               FontSize="9"
                                               TextColor="#e74c3c"
                                               IsVisible="{Binding IsEmpty}" />
                                        <Label Text="{Binding EquipmentState}"
                                               FontSize="8"
                                               TextColor="{Binding EquipmentState, Converter={StaticResource EquipmentStateColorConverter}}"
                                               IsVisible="{Binding IsEquipped}" />

                                        <Border BackgroundColor="#ff000033"
                                                Padding="3,1"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 2"
                                                IsVisible="{Binding IsDestroyMode}">
                                            <Label Text="🗑️ Destroy"
                                                   FontSize="8"
                                                   FontAttributes="Bold"
                                                   TextColor="#ff4444" />
                                        </Border>
                                    </VerticalStackLayout>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDestroyItemTapped"
                                                              NumberOfTapsRequired="1" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Item Details Panel - Row 2 -->
                    <Border Grid.Row="2"
                        Stroke="#444444"
                        StrokeThickness="0.5"
                        StrokeShape="RoundRectangle 4"
                        Padding="8"
                        IsVisible="{Binding HasSelectedItem}">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">

                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                <Label Text="{Binding SelectedItemName}" 
                   FontSize="13" 
                   FontAttributes="Bold" 
                   TextColor="#4fc3f7" />
                                <Label Text="{Binding SelectedItemDescription}" 
                   FontSize="11" 
                   TextColor="#aaaaaa" 
                   LineBreakMode="WordWrap" />
                                <Label Text="{Binding SelectedItemDetails}" 
                   FontSize="10" 
                   TextColor="#888888" />
                                <Label Text="{Binding SelectedItemPlayerNote}" 
                   FontSize="10" 
                   TextColor="#f39c12" 
                   IsVisible="{Binding HasPlayerNote}" />
                                <Label Text="🔒 Equipped"
                   FontSize="10"
                   TextColor="#4fc3f7"
                   IsVisible="{Binding SelectedItemIsEquipped}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                                <!-- Interact Button -->
                                <Button Text="⚙️"
                    BackgroundColor="#3498db"
                    TextColor="White"
                    CornerRadius="6"
                    WidthRequest="40"
                    HeightRequest="35"
                    FontSize="14"
                    Command="{Binding InteractCommand}" />

                                <!-- Make a Note Button -->
                                <Button Text="📝"
                    BackgroundColor="#9b59b6"
                    TextColor="White"
                    CornerRadius="6"
                    WidthRequest="40"
                    HeightRequest="35"
                    FontSize="14"
                    Command="{Binding EditNoteCommand}" />

                                <!-- Uses Adjuster -->
                                <VerticalStackLayout Spacing="1" 
                                 IsVisible="{Binding HasUses}"
                                 HorizontalOptions="Center">
                                    <Label Text="Uses:"
                       FontSize="8"
                       TextColor="#888888"
                       HorizontalOptions="Center" />
                                    <Grid ColumnDefinitions="Auto, Auto, Auto" ColumnSpacing="3">
                                        <Button Grid.Row="0" Grid.Column="0"
                            Text="−"
                            BackgroundColor="#e74c3c"
                            TextColor="White"
                            CornerRadius="3"
                            WidthRequest="18"
                            HeightRequest="18"
                            FontSize="10"
                            Command="{Binding DecrementUsesCommand}" />
                                        <Label Grid.Row="0" Grid.Column="1"
                           Text="{Binding SelectedItemRemainingUses}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           WidthRequest="24"
                           HorizontalTextAlignment="Center" />
                                        <Button Grid.Row="0" Grid.Column="2"
                            Text="+"
                            BackgroundColor="#2ecc71"
                            TextColor="White"
                            CornerRadius="3"
                            WidthRequest="18"
                            HeightRequest="18"
                            FontSize="10"
                            Command="{Binding IncrementUsesCommand}" />
                                    </Grid>
                                </VerticalStackLayout>

                                <Label Text="⚠️ EMPTY"
                   FontSize="10"
                   FontAttributes="Bold"
                   TextColor="#e74c3c"
                   HorizontalOptions="Center"
                   IsVisible="{Binding SelectedItemIsEmpty}" />
                            </VerticalStackLayout>

                        </Grid>
                    </Border>

                    <!-- Action Buttons - Row 3 -->
                    <Grid Grid.Row="3" ColumnDefinitions="*, *" ColumnSpacing="8">
                        <Button Grid.Row="0" Grid.Column="0"
                                Text="📦 Bestow"
                                BackgroundColor="#2ecc71"
                                TextColor="White"
                                CornerRadius="6"
                                HeightRequest="35"
                                FontSize="12"
                                Command="{Binding BestowCommand}" />

                        <Button Grid.Row="0" Grid.Column="1"
                                Text="{Binding IsDestroyModeActive, Converter={StaticResource DestroyModeButtonTextConverter}}"
                                BackgroundColor="{Binding IsDestroyModeActive, Converter={StaticResource DestroyModeButtonColorConverter}}"
                                TextColor="White"
                                CornerRadius="6"
                                HeightRequest="35"
                                FontSize="12"
                                FontAttributes="Bold"
                                Command="{Binding ToggleDestroyModeCommand}" />
                    </Grid>

                    <!-- Empty State - Row 1 (overlay) -->
                    <Label Grid.Row="1"
                           Text="No items in inventory"
                           FontSize="13"
                           TextColor="#888888"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           IsVisible="{Binding InventoryItems.Count, Converter={StaticResource IsZeroConverter}}" />

                </Grid>
            </Border>

        </Grid>

        <!-- ===== ACTION BUTTONS - Row 3 ===== -->
        <Grid Grid.Row="3"
              ColumnDefinitions="*, *, *, *, *, *, *"
              ColumnSpacing="5"
              Margin="0,5,0,0">

            <Button Grid.Row="0" Grid.Column="0"
                    Text="📜 Spells"
                    BackgroundColor="#8e44ad"
                    TextColor="White"
                    CornerRadius="6"
                    HeightRequest="35"
                    FontSize="11"
                    Command="{Binding NavigateToSpellsCommand}" />

            <Button Grid.Row="0" Grid.Column="1"
                    Text="⚡ Quips"
                    BackgroundColor="#9b59b6"
                    TextColor="White"
                    CornerRadius="6"
                    HeightRequest="35"
                    FontSize="11"
                    Command="{Binding NavigateToQuipsCommand}" />

            <Button Grid.Row="0" Grid.Column="2"
                    Text="📐 Blueprints"
                    BackgroundColor="#2980b9"
                    TextColor="White"
                    CornerRadius="6"
                    HeightRequest="35"
                    FontSize="11"
                    Command="{Binding NavigateToBlueprintsCommand}" />

            <Button Grid.Row="0" Grid.Column="3"
                    Text="⚙️ Features"
                    BackgroundColor="#27ae60"
                    TextColor="White"
                    CornerRadius="6"
                    HeightRequest="35"
                    FontSize="11"
                    Command="{Binding NavigateToFeaturesCommand}" />

            <Button Grid.Row="0" Grid.Column="4"
                    Text="🐾 Familiars"
                    BackgroundColor="#d35400"
                    TextColor="White"
                    CornerRadius="6"
                    HeightRequest="35"
                    FontSize="11"
                    Command="{Binding NavigateToFamiliarsCommand}" />

            <Button Grid.Row="0" Grid.Column="5"
                    Text="🏪 Shop"
                    BackgroundColor="#f39c12"
                    TextColor="White"
                    CornerRadius="6"
                    HeightRequest="35"
                    FontSize="11"
                    Command="{Binding NavigateToShopCommand}" />

            <Button Grid.Row="0" Grid.Column="6"
                    Text="🚪 Quit"
                    BackgroundColor="#e74c3c"
                    TextColor="White"
                    CornerRadius="6"
                    HeightRequest="35"
                    FontSize="11"
                    Command="{Binding QuitCommand}" />

        </Grid>

    </Grid>
</ContentPage>