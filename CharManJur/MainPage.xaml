<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             x:Class="CharManJur.MainPage"
             Shell.NavBarIsVisible="False"
             Title="Character Manager">

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="20">

        <!-- Title -->
        <Label Grid.Row="0"
               Text="⚔️ DnD Character Manager"
               FontSize="32"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,40,0,20"/>

        <!-- Menu Buttons -->
        <VerticalStackLayout Grid.Row="1"
                             Spacing="20"
                             MaximumWidthRequest="800"
                             VerticalOptions="Center">

            <skin:SkinHost SkinKey="create"
                           FallbackColor="{DynamicResource ThemeCreateButtonColor}">
                <Button Text="Create New Character"
                        TextColor="White"
                        FontSize="18"
                        CornerRadius="10"
                        HeightRequest="60"
                        Clicked="OnCreateNewCharacterClicked"/>
            </skin:SkinHost>

            <skin:SkinHost SkinKey="warning"
                           FallbackColor="{DynamicResource ThemeWarningButtonColor}">
                <Button Text="📂 Resume Character"
                        TextColor="White"
                        FontSize="18"
                        CornerRadius="10"
                        HeightRequest="60"
                        Clicked="OnResumeCharacterClicked"/>
            </skin:SkinHost>

            <skin:SkinHost SkinKey="primary"
                           FallbackColor="{DynamicResource ThemePrimaryButtonColor}">
                <Button Text="Load Character"
                        TextColor="White"
                        FontSize="18"
                        CornerRadius="10"
                        HeightRequest="60"
                        Clicked="OnLoadCharacterClicked"/>
            </skin:SkinHost>

            <skin:SkinHost SkinKey="neutral"
                           FallbackColor="{DynamicResource ThemeNeutralButtonColor}"
                           Margin="0,40,0,0">
                <Button Text="⚙️ Settings"
                        TextColor="White"
                        FontSize="16"
                        CornerRadius="10"
                        HeightRequest="50"
                        Clicked="OnSettingsClicked"/>
            </skin:SkinHost>

        </VerticalStackLayout>

        <!-- Version Footer -->
        <Label Grid.Row="2"
               Text="v0.3.0"
               FontSize="14"
               TextColor="Gray"
               HorizontalOptions="Center"
               Margin="0,0,0,20"/>

    </Grid>
</ContentPage>