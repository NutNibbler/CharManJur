<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:CharManJur.Converters"
             xmlns:viewmodels="clr-namespace:CharManJur.ViewModels"
             x:Class="CharManJur.Views.CharBuilder_Godrick_HinderanceSelection"
             Title="Hinderance Selection"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#1a1a2e">

    <Grid RowDefinitions="Auto, *, Auto"
          Padding="20"
          RowSpacing="10">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="5">
            <Label Text="⚠️ Hinderance Selection"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#e74c3c"
                   HorizontalOptions="Center" />

            <Label Text="Select a hinderance to gain a bonus to a stat or training point."
                   FontSize="14"
                   TextColor="#aaaaaa"
                   HorizontalOptions="Center" />

            <Label Text="You may select no hinderance."
                   FontSize="12"
                   TextColor="#888888"
                   HorizontalOptions="Center" />

            <BoxView HeightRequest="2" Color="#e74c3c" />
        </VerticalStackLayout>

        <!-- Content -->
        <Grid Grid.Row="1" ColumnDefinitions="0.40*, 0.60*" ColumnSpacing="15">

            <!-- LEFT: Hinderance List -->
            <Border Stroke="#e74c3c" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="0">
                <CollectionView x:Name="HinderancesCollectionView"
                                ItemsSource="{Binding Hinderances}"
                                SelectedItem="{Binding SelectedHinderance}"
                                SelectionMode="Single">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10">
                                <Border Stroke="#e74c3c"
                                    StrokeThickness="0.5"
                                    StrokeShape="RoundRectangle 4"
                                    Padding="10">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
                                        <Label Grid.Column="0"
                                           Text="{Binding Name}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           VerticalTextAlignment="Center" />

                                        <!-- Edit Button - Only visible for custom hinderances -->
                                        <Button Grid.Column="1"
                                            Text="✏️"
                                            BackgroundColor="#3498db"
                                            TextColor="White"
                                            CornerRadius="15"
                                            WidthRequest="35"
                                            HeightRequest="35"
                                            FontSize="12"
                                            IsVisible="{Binding IsPlayerCreated}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCustomHinderanceCommand}"
                                            CommandParameter="{Binding .}"/>

                                        <!-- Delete Button - Only visible for custom hinderances -->
                                        <Button Grid.Column="2"
                                            Text="🗑️"
                                            BackgroundColor="#e74c3c"
                                            TextColor="White"
                                            CornerRadius="15"
                                            WidthRequest="35"
                                            HeightRequest="35"
                                            FontSize="12"
                                            IsVisible="{Binding IsPlayerCreated}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCustomHinderanceCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <!-- RIGHT: Hinderance Details -->
            <Border Grid.Column="1" Stroke="#e74c3c" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10">
                <ScrollView>
                    <VerticalStackLayout Spacing="10">

                        <Label Text="Hinderance Details"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="#e74c3c" />

                        <!-- Name -->
                        <Label Text="{Binding SelectedHinderanceName}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White" />

                        <!-- Description -->
                        <Label Text="{Binding SelectedHinderanceDescription}"
                               FontSize="14"
                               TextColor="#aaaaaa"
                               LineBreakMode="WordWrap" />

                        <BoxView HeightRequest="1" Color="#333333" />

                        <!-- Reward Selection (Only visible when a hinderance is selected) -->
                        <VerticalStackLayout IsVisible="{Binding HasSelectedHinderance}" Spacing="8">
                            <Label Text="Select Your Reward:"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="#f39c12" />

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                <Button Grid.Column="0"
                                    Text="+1 Stat Bonus"
                                    BackgroundColor="{Binding IsStatBonusSelected, Converter={StaticResource RewardButtonColorConverter}}"
                                    TextColor="White"
                                    CornerRadius="8"
                                    HeightRequest="40"
                                    Command="{Binding SelectStatBonusCommand}" />

                                <Button Grid.Column="1"
                                    Text="+1 Training Point"
                                    BackgroundColor="{Binding IsTrainingPointSelected, Converter={StaticResource RewardButtonColorConverter}}"
                                    TextColor="White"
                                    CornerRadius="8"
                                    HeightRequest="40"
                                    Command="{Binding SelectTrainingPointCommand}" />
                            </Grid>

                            <!-- Stat Selection (only visible when stat bonus is chosen) -->
                            <VerticalStackLayout IsVisible="{Binding IsStatBonusSelected}" Spacing="5">
                                <Label Text="Choose a stat to increase:"
                                   FontAttributes="Bold"
                                   FontSize="13"
                                   TextColor="#f39c12" />

                                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto,Auto" ColumnSpacing="5" RowSpacing="5">
                                    <Button Grid.Column="0" Grid.Row="0"
                                        Text="Vigor"
                                        BackgroundColor="{Binding SelectedStat, Converter={StaticResource StatButtonColorConverter}, ConverterParameter=Vigor}"
                                        TextColor="White"
                                        CornerRadius="6"
                                        HeightRequest="35"
                                        Command="{Binding SelectStatToIncreaseCommand}"
                                        CommandParameter="Vigor" />

                                    <Button Grid.Column="1" Grid.Row="0"
                                        Text="Agility"
                                        BackgroundColor="{Binding SelectedStat, Converter={StaticResource StatButtonColorConverter}, ConverterParameter=Agility}"
                                        TextColor="White"
                                        CornerRadius="6"
                                        HeightRequest="35"
                                        Command="{Binding SelectStatToIncreaseCommand}"
                                        CommandParameter="Agility" />

                                    <Button Grid.Column="0" Grid.Row="1"
                                        Text="Mind"
                                        BackgroundColor="{Binding SelectedStat, Converter={StaticResource StatButtonColorConverter}, ConverterParameter=Mind}"
                                        TextColor="White"
                                        CornerRadius="6"
                                        HeightRequest="35"
                                        Command="{Binding SelectStatToIncreaseCommand}"
                                        CommandParameter="Mind" />

                                    <Button Grid.Column="1" Grid.Row="1"
                                        Text="Spirit"
                                        BackgroundColor="{Binding SelectedStat, Converter={StaticResource StatButtonColorConverter}, ConverterParameter=Spirit}"
                                        TextColor="White"
                                        CornerRadius="6"
                                        HeightRequest="35"
                                        Command="{Binding SelectStatToIncreaseCommand}"
                                        CommandParameter="Spirit" />
                                </Grid>
                            </VerticalStackLayout>

                            <!-- Training Point Info (visible when training point is chosen) -->
                            <VerticalStackLayout IsVisible="{Binding IsTrainingPointSelected}" Spacing="5">
                                <Label Text="You will receive +1 Training Point to allocate on the Training page."
                                   FontSize="13"
                                   TextColor="#4fc3f7"
                                   HorizontalOptions="Center" />
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="#333333" />
                            <Label Text="{Binding RewardSummary}"
                               FontSize="13"
                               TextColor="#4fc3f7"
                               HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <!-- No Hinderance Selected Message -->
                        <VerticalStackLayout IsVisible="{Binding HasSelectedHinderance, Converter={StaticResource InvertedBoolConverter}}"
                                             Spacing="10"
                                             VerticalOptions="Center">
                            <Label Text="Select a hinderance from the list, or use the 'Skip' button to proceed without one."
                                   FontSize="14"
                                   TextColor="#888888"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>
            </Border>

        </Grid>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*, *, *, *, *, *" ColumnSpacing="3">

            <Button Grid.Column="5"
                    Text="+ Create Custom"
                    BackgroundColor="#9b59b6"
                    TextColor="White"
                    FontSize="14"
                    CornerRadius="8"
                    HeightRequest="45"
                    Command="{Binding CreateCustomHinderanceCommand}" />
            
            <Button Grid.Column="1"
                    Text="Skip (No Hinderance)"
                    BackgroundColor="#95a5a6"
                    TextColor="White"
                    FontSize="14"
                    CornerRadius="8"
                    HeightRequest="45"
                    Command="{Binding SkipHinderanceCommand}" />

            <Button Grid.Column="4"
                    Text="💾 Save For Later"
                    BackgroundColor="#f39c12"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="45"
                    FontSize="14"
                    Clicked="OnSaveForLaterClicked" />

            <Button Grid.Column="2"
                    Text="← Back"
                    BackgroundColor="{AppThemeBinding Light=#95a5a6, Dark=#7f8c8d}"
                    TextColor="White"
                    FontSize="16"
                    CornerRadius="8"
                    HeightRequest="45"
                    Clicked="OnBackClicked" />

            <Button Grid.Column="3"
                    Text="Cancel"
                    BackgroundColor="#e74c3c"
                    TextColor="White"
                    FontSize="16"
                    CornerRadius="8"
                    HeightRequest="45"
                    Clicked="OnCancelClicked" />

            <Button Grid.Column="0"
                    Text="Next: Training"
                    BackgroundColor="#2ecc71"
                    TextColor="White"
                    FontSize="16"
                    CornerRadius="8"
                    HeightRequest="45"
                    FontAttributes="Bold"
                    Command="{Binding ConfirmHinderanceCommand}" />

        </Grid>

    </Grid>
</ContentPage>