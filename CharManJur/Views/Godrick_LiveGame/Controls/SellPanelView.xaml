<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             x:Class="CharManJur.Views.Godrick_LiveGame.Controls.SellPanelView">

    <ContentView.Resources>
        <!-- Size and look live on the Button; the host supplies the skin art -->
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="WidthRequest" Value="34" />
            <Setter Property="HeightRequest" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="White" />
        </Style>
        <Style x:Key="StepHostStyle" TargetType="skin:SkinHost">
            <Setter Property="SkinKey" Value="generic_small" />
            <Setter Property="FallbackColor" Value="{DynamicResource ThemeNeutralButtonColor}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentView.Resources>

    <Grid ColumnDefinitions="0.55*, 0.45*" ColumnSpacing="10">

        <!-- ===== LEFT: search and the character's sellable items ===== -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *" RowSpacing="8">

            <Border Grid.Row="0"
                    Stroke="{DynamicResource ThemeDetailBorderColor2}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{DynamicResource ThemePanelBackgroundColor}">
                <Entry Text="{Binding SearchText}"
                       Placeholder="Search your items..."
                       PlaceholderColor="Gray"
                       BackgroundColor="Transparent" />
            </Border>

            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding Rows}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="{DynamicResource ThemeDetailBorderColor2}"
                                StrokeThickness="0.5"
                                StrokeShape="RoundRectangle 4"
                                Padding="8"
                                Margin="2">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsBlocked}" Value="True">
                                    <Setter Property="Opacity" Value="0.5" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="0">
                                    <Label Text="{Binding Name}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding CategoryText}"
                                           FontSize="10"
                                           TextColor="Gray" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="{Binding QuantityText}"
                                       FontSize="12"
                                       TextColor="Gray"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding ShowQuantity}" />
                                <Label Grid.Column="2"
                                       Text="{Binding PriceText}"
                                       FontSize="12"
                                       TextColor="{DynamicResource ThemeWarningButtonColor}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Grid.Row="1"
                   Text="Nothing to sell."
                   FontSize="13"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   IsVisible="{Binding HasNoRows}" />
        </Grid>

        <!-- ===== RIGHT: details and sale ===== -->
        <Border Grid.Column="1"
                StrokeShape="RoundRectangle 6"
                StrokeThickness="1"
                Stroke="{DynamicResource ThemeDetailBorderColor2}"
                BackgroundColor="{DynamicResource ThemePanelHeaderBackgroundColor}"
                Padding="10">
            <Grid RowDefinitions="*, Auto" RowSpacing="8">

                <ScrollView Grid.Row="0" IsVisible="{Binding HasSelection}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding SelectedName}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource ThemeDetailBorderColor1}" />
                        <Label Text="{Binding SelectedTraits}" FontSize="11" TextColor="Gray" />

                        <!-- Price -->
                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto" ColumnSpacing="10" RowSpacing="2">
                            <Label Grid.Row="0" Grid.Column="0" Text="Sells for" FontSize="11" TextColor="Gray" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding UnitPriceText}" FontSize="12"
                                   TextColor="{DynamicResource ThemeWarningButtonColor}" />
                            <Label Grid.Row="1" Grid.Column="0" Text="Total" FontSize="11" TextColor="Gray" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding TotalText}" FontSize="14" FontAttributes="Bold" />
                        </Grid>

                        <!-- No set price: the player names one, in Chips, with a readable conversion -->
                        <VerticalStackLayout Spacing="4" IsVisible="{Binding HasNoListedPrice}">
                            <Label Text="No set price. Enter one, in Chips (each):"
                                   FontSize="11"
                                   TextColor="Gray" />
                            <Border Stroke="{DynamicResource ThemeDetailBorderColor2}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 6"
                                    BackgroundColor="{DynamicResource ThemePanelBackgroundColor}"
                                    HeightRequest="38">
                                <Entry Text="{Binding CustomPriceText}"
                                       Placeholder="Price each, in Chips"
                                       PlaceholderColor="Gray"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent"
                                       VerticalOptions="Center"
                                       ToolTipProperties.Text="{Binding PriceConversionText}" />
                            </Border>
                            <Label Text="{Binding PriceConversionText}"
                                   FontSize="11"
                                   TextColor="{DynamicResource ThemeDetailBorderColor1}"
                                   LineBreakMode="WordWrap"
                                   IsVisible="{Binding HasPriceConversion}" />
                        </VerticalStackLayout>

                        <!-- Quantity -->
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Qty" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                            <skin:SkinHost Style="{StaticResource StepHostStyle}">
                                <Button Text="−" Style="{StaticResource StepButton}"
                                        Command="{Binding QuantityDownCommand}" />
                            </skin:SkinHost>
                            <Border Stroke="{DynamicResource ThemeDetailBorderColor2}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 6"
                                    BackgroundColor="{DynamicResource ThemePanelBackgroundColor}"
                                    WidthRequest="70"
                                    HeightRequest="34"
                                    VerticalOptions="Center">
                                <Entry Text="{Binding QuantityText}"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent"
                                       HorizontalTextAlignment="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <skin:SkinHost Style="{StaticResource StepHostStyle}">
                                <Button Text="+" Style="{StaticResource StepButton}"
                                        Command="{Binding QuantityUpCommand}" />
                            </skin:SkinHost>
                        </HorizontalStackLayout>

                        <Label Text="{Binding ReceiveText}"
                               FontSize="12"
                               LineBreakMode="WordWrap"
                               IsVisible="{Binding HasReceive}" />
                        <Label Text="{Binding StatusText}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource ThemeDangerButtonColor}"
                               LineBreakMode="WordWrap"
                               IsVisible="{Binding HasStatus}" />
                        <Label Text="{Binding ResultText}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource ThemeConfirmButtonColor}"
                               LineBreakMode="WordWrap"
                               IsVisible="{Binding HasResult}" />
                    </VerticalStackLayout>
                </ScrollView>

                <Label Grid.Row="0"
                       Text="Select one of your items to sell it."
                       FontSize="13"
                       TextColor="Gray"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       IsVisible="{Binding HasNoSelection}" />

                <!-- Sell -->
                <skin:SkinHost Grid.Row="1"
                               SkinKey="warning"
                               FallbackColor="{DynamicResource ThemeWarningButtonColor}">
                    <Button Text="💰 Sell"
                            TextColor="White"
                            CornerRadius="6"
                            HeightRequest="40"
                            Padding="14,0"
                            FontSize="13"
                            IsEnabled="{Binding CanSellSelected}"
                            Command="{Binding SellCommand}" />
                </skin:SkinHost>
            </Grid>
        </Border>
    </Grid>
</ContentView>