<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             x:Class="CharManJur.Views.Godrick_LiveGame.Controls.ProficiencyTrackerView">

    <VerticalStackLayout Spacing="10">

        <!-- Starting damage type: shown until chosen -->
        <skin:SkinPanel StrokeColor="{DynamicResource ThemeWarningButtonColor}"
                        StrokeThickness="1"
                        CornerRadius="8"
                        ContentPadding="10"
                        IsVisible="{Binding NeedsStartingChoice}">
            <VerticalStackLayout Spacing="6">
                <Label Text="You haven't chosen your starting damage type proficiency yet."
                       FontSize="12"
                       LineBreakMode="WordWrap" />
                <skin:SkinHost SkinKey="warning"
                               FallbackColor="{DynamicResource ThemeWarningButtonColor}"
                               HorizontalOptions="Start">
                    <Button Text="⚔️ Choose Starting Proficiency"
                            TextColor="White"
                            CornerRadius="6"
                            HeightRequest="36"
                            Padding="12,0"
                            FontSize="12"
                            Command="{Binding ChooseStartingCommand}" />
                </skin:SkinHost>
            </VerticalStackLayout>
        </skin:SkinPanel>

        <!-- Damage types -->
        <Label Text="⚔️ Damage Type Proficiency"
               FontAttributes="Bold"
               FontSize="14"
               TextColor="{DynamicResource ThemeWarningButtonColor}" />
        <Label Text="Every kill counts toward the weapon's own tally and its damage type's at the same time. 5 kills unlock each."
               FontSize="11"
               TextColor="Gray"
               LineBreakMode="WordWrap" />

        <skin:SkinPanel StrokeColor="{DynamicResource ThemeSectionBorderColor}"
                        StrokeThickness="1"
                        CornerRadius="8"
                        ContentPadding="10">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding TypeRows}" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*, Auto, 56, Auto" ColumnSpacing="6">
                            <VerticalStackLayout Grid.Column="0" Spacing="0">
                                <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" />
                                <Label Text="{Binding StatusText}" FontSize="11" TextColor="{DynamicResource ThemeDetailBorderColor1}" />
                                <Label Text="{Binding Description}" FontSize="10" TextColor="Gray" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                            <skin:SkinHost Grid.Column="1"
                                           SkinKey="generic_small"
                                           FallbackColor="{DynamicResource ThemeNeutralButtonColor}"
                                           VerticalOptions="Center">
                                <Button Text="−" TextColor="White" CornerRadius="4" WidthRequest="30" HeightRequest="28"
                                        Padding="0" FontSize="14" Command="{Binding DownCommand}" />
                            </skin:SkinHost>

                            <Label Grid.Column="2" Text="{Binding KillsText}" FontSize="14" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" VerticalOptions="Center" />

                            <skin:SkinHost Grid.Column="3"
                                           SkinKey="generic_small"
                                           FallbackColor="{DynamicResource ThemeNeutralButtonColor}"
                                           VerticalOptions="Center">
                                <Button Text="+" TextColor="White" CornerRadius="4" WidthRequest="30" HeightRequest="28"
                                        Padding="0" FontSize="14" Command="{Binding UpCommand}" />
                            </skin:SkinHost>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </skin:SkinPanel>

        <!-- Weapon skills: weapons you've earned or picked -->
        <Label Text="🗡️ Weapon Skill Proficiency"
               FontAttributes="Bold"
               FontSize="14"
               TextColor="{DynamicResource ThemeWarningButtonColor}" />
        <Label Text="A weapon's skills (Bleed, Shock, Sweep, Push, Counter, Brutal, Heavy) need 5 kills with that specific weapon, or a Warrior weapon pick. Only weapons that have such skills are listed. Lowering a weapon to 0 removes it; +Kill on a wielded weapon starts it again."
               FontSize="11"
               TextColor="Gray"
               LineBreakMode="WordWrap" />

        <skin:SkinPanel StrokeColor="{DynamicResource ThemeSectionBorderColor}"
                        StrokeThickness="1"
                        CornerRadius="8"
                        ContentPadding="10">
            <VerticalStackLayout Spacing="12">
                <Label Text="No weapon skills yet. A weapon with skills appears here after a kill with it, or when you pick it as a Warrior."
                       FontSize="12"
                       TextColor="Gray"
                       LineBreakMode="WordWrap"
                       IsVisible="{Binding HasNoWeapons}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding WeaponRows}" Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="4">

                                <Grid ColumnDefinitions="*, Auto, 56, Auto" ColumnSpacing="6">
                                    <VerticalStackLayout Grid.Column="0" Spacing="0">
                                        <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" />
                                        <Label Text="{Binding StatusText}" FontSize="10" TextColor="Gray" />
                                    </VerticalStackLayout>

                                    <skin:SkinHost Grid.Column="1"
                                                   SkinKey="generic_small"
                                                   FallbackColor="{DynamicResource ThemeNeutralButtonColor}"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding HasKills}">
                                        <Button Text="−" TextColor="White" CornerRadius="4" WidthRequest="30" HeightRequest="28"
                                                Padding="0" FontSize="14"
                                                IsVisible="{Binding HasKills}"
                                                Command="{Binding DownCommand}" />
                                    </skin:SkinHost>

                                    <Label Grid.Column="2" Text="{Binding KillsText}" FontSize="14" FontAttributes="Bold"
                                           HorizontalTextAlignment="Center" VerticalOptions="Center"
                                           IsVisible="{Binding HasKills}" />

                                    <skin:SkinHost Grid.Column="3"
                                                   SkinKey="generic_small"
                                                   FallbackColor="{DynamicResource ThemeNeutralButtonColor}"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding HasKills}">
                                        <Button Text="+" TextColor="White" CornerRadius="4" WidthRequest="30" HeightRequest="28"
                                                Padding="0" FontSize="14"
                                                IsVisible="{Binding HasKills}"
                                                Command="{Binding UpCommand}" />
                                    </skin:SkinHost>
                                </Grid>

                                <Label Text="{Binding NoteText}" FontSize="10" TextColor="Gray"
                                       LineBreakMode="WordWrap" IsVisible="{Binding HasNote}" />

                                <!-- One line per skill: the padlock and the name together, with what it does beside it -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Skills}" Spacing="2" Margin="8,0,0,0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                                <Label Grid.Column="0" Text="{Binding Title}" FontSize="12" FontAttributes="Bold"
                                                       TextColor="{DynamicResource ThemeWarningButtonColor}"
                                                       VerticalOptions="Start" />
                                                <Label Grid.Column="1" Text="{Binding Description}" FontSize="10" TextColor="Gray"
                                                       LineBreakMode="WordWrap" VerticalOptions="Start" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                    <BindableLayout.EmptyView>
                                        <Label Text="" />
                                    </BindableLayout.EmptyView>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </skin:SkinPanel>

    </VerticalStackLayout>
</ContentView>