<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             xmlns:controls="clr-namespace:CharManJur.Views.Godrick_LiveGame.Controls"
             x:Class="CharManJur.Views.Godrick_LiveGame.Controls.ShopPanelView">

    <ContentView.Resources>
        <!-- Size and look live on the Button; the host supplies the skin art -->
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="WidthRequest" Value="34" />
            <Setter Property="HeightRequest" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="White" />
        </Style>
        <Style x:Key="StepHostStyle" TargetType="skin:SkinHost">
            <Setter Property="SkinKey" Value="generic_small" />
            <Setter Property="FallbackColor" Value="{DynamicResource ThemeNeutralButtonColor}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentView.Resources>

    <Grid RowDefinitions="Auto, *" RowSpacing="8">

        <!-- ===== Buy / Sell toggle + mode banner ===== -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, *" ColumnSpacing="8">
            <skin:SkinHost Grid.Column="0"
                           SkinKey="neutral"
                           FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                <skin:SkinHost.Triggers>
                    <DataTrigger TargetType="skin:SkinHost" Binding="{Binding IsBuyMode}" Value="True">
                        <Setter Property="SkinKey" Value="confirm" />
                        <Setter Property="FallbackColor" Value="{DynamicResource ThemeConfirmButtonColor}" />
                    </DataTrigger>
                </skin:SkinHost.Triggers>
                <Button Text="🛒 Buy"
                        TextColor="White"
                        CornerRadius="6"
                        WidthRequest="110"
                        HeightRequest="32"
                        Padding="14,0"
                        FontSize="12"
                        Command="{Binding ShowBuyCommand}" />
            </skin:SkinHost>

            <skin:SkinHost Grid.Column="1"
                           SkinKey="neutral"
                           FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                <skin:SkinHost.Triggers>
                    <DataTrigger TargetType="skin:SkinHost" Binding="{Binding IsSellMode}" Value="True">
                        <Setter Property="SkinKey" Value="warning" />
                        <Setter Property="FallbackColor" Value="{DynamicResource ThemeWarningButtonColor}" />
                    </DataTrigger>
                </skin:SkinHost.Triggers>
                <Button Text="💰 Sell"
                        TextColor="White"
                        CornerRadius="6"
                        WidthRequest="110"
                        HeightRequest="32"
                        Padding="14,0"
                        FontSize="12"
                        Command="{Binding ShowSellCommand}" />
            </skin:SkinHost>

            <Label Grid.Column="2"
                   Text="{Binding ModeBannerText}"
                   FontSize="15"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   Margin="8,0,0,0"
                   TextColor="{DynamicResource ThemeConfirmButtonColor}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsSellMode}" Value="True">
                        <Setter Property="TextColor" Value="{DynamicResource ThemeWarningButtonColor}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </Grid>

        <!-- ===== SELL SIDE (own view model; wrapped so the visibility binds to this page's view model) ===== -->
        <Grid Grid.Row="1" IsVisible="{Binding IsSellMode}">
            <controls:SellPanelView BindingContext="{Binding Sell}" />
        </Grid>

        <!-- ===== BUY SIDE ===== -->
        <Grid Grid.Row="1"
              IsVisible="{Binding IsBuyMode}"
              ColumnDefinitions="0.55*, 0.45*"
              ColumnSpacing="10">

            <!-- ===== LEFT: search, category, item list ===== -->
            <Grid Grid.Column="0" RowDefinitions="Auto, *" RowSpacing="8">

                <Grid Grid.Row="0" ColumnDefinitions="*, 170" ColumnSpacing="8">
                    <Border Grid.Column="0"
                            Stroke="{DynamicResource ThemeDetailBorderColor2}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{DynamicResource ThemePanelBackgroundColor}">
                        <Entry Text="{Binding SearchText}"
                               Placeholder="Search items..."
                               PlaceholderColor="Gray"
                               BackgroundColor="Transparent" />
                    </Border>

                    <Picker Grid.Column="1"
                            Title="Category"
                            ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                            BackgroundColor="{DynamicResource ThemePanelBackgroundColor}"
                            TitleColor="Gray"
                            VerticalOptions="Center" />
                </Grid>

                <CollectionView Grid.Row="1"
                                ItemsSource="{Binding Rows}"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="{DynamicResource ThemeDetailBorderColor2}"
                                    StrokeThickness="0.5"
                                    StrokeShape="RoundRectangle 4"
                                    Padding="8"
                                    Margin="2">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="0">
                                        <Label Text="{Binding Name}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding CategoryText}"
                                               FontSize="10"
                                               TextColor="Gray" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="{Binding PriceText}"
                                           FontSize="12"
                                           TextColor="{DynamicResource ThemeWarningButtonColor}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Grid.Row="1"
                       Text="No items match."
                       FontSize="13"
                       TextColor="Gray"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       IsVisible="{Binding HasNoRows}" />
            </Grid>

            <!-- ===== RIGHT: details and purchase ===== -->
            <Border Grid.Column="1"
                    StrokeShape="RoundRectangle 6"
                    StrokeThickness="1"
                    Stroke="{DynamicResource ThemeDetailBorderColor2}"
                    BackgroundColor="{DynamicResource ThemePanelHeaderBackgroundColor}"
                    Padding="10">
                <Grid RowDefinitions="Auto, *, Auto" RowSpacing="8">

                    <!-- Funds -->
                    <Label Grid.Row="0"
                           Text="{Binding CoinsText}"
                           FontSize="13"
                           FontAttributes="Bold" />

                    <!-- Details -->
                    <ScrollView Grid.Row="1" IsVisible="{Binding HasSelection}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding SelectedName}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource ThemeDetailBorderColor1}" />
                            <Label Text="{Binding SelectedTraits}" FontSize="11" TextColor="Gray" />
                            <Label Text="{Binding SelectedDescription}"
                                   FontSize="12"
                                   TextColor="Gray"
                                   LineBreakMode="WordWrap"
                                   IsVisible="{Binding HasSelectedDescription}" />

                            <!-- Price -->
                            <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto" ColumnSpacing="10" RowSpacing="2">
                                <Label Grid.Row="0" Grid.Column="0" Text="Price each" FontSize="11" TextColor="Gray" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding UnitPriceText}" FontSize="12"
                                       TextColor="{DynamicResource ThemeWarningButtonColor}" />
                                <Label Grid.Row="1" Grid.Column="0" Text="Total" FontSize="11" TextColor="Gray" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding TotalText}" FontSize="14" FontAttributes="Bold" />
                            </Grid>

                            <!-- No set price: the player names one, in Chips, with a readable conversion -->
                            <VerticalStackLayout Spacing="4" IsVisible="{Binding HasNoListedPrice}">
                                <Label Text="No set price. Enter one, in Chips (each):"
                                       FontSize="11"
                                       TextColor="Gray" />
                                <Border Stroke="{DynamicResource ThemeDetailBorderColor2}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 6"
                                        BackgroundColor="{DynamicResource ThemePanelBackgroundColor}"
                                        HeightRequest="38">
                                    <Entry Text="{Binding CustomPriceText}"
                                           Placeholder="Price each, in Chips"
                                           PlaceholderColor="Gray"
                                           Keyboard="Numeric"
                                           BackgroundColor="Transparent"
                                           VerticalOptions="Center"
                                           ToolTipProperties.Text="{Binding PriceConversionText}" />
                                </Border>
                                <Label Text="{Binding PriceConversionText}"
                                       FontSize="11"
                                       TextColor="{DynamicResource ThemeDetailBorderColor1}"
                                       LineBreakMode="WordWrap"
                                       IsVisible="{Binding HasPriceConversion}" />
                            </VerticalStackLayout>

                            <!-- Quantity -->
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="Qty" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                <skin:SkinHost Style="{StaticResource StepHostStyle}">
                                    <Button Text="−" Style="{StaticResource StepButton}"
                                            Command="{Binding QuantityDownCommand}" />
                                </skin:SkinHost>
                                <Border Stroke="{DynamicResource ThemeDetailBorderColor2}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 6"
                                        BackgroundColor="{DynamicResource ThemePanelBackgroundColor}"
                                        WidthRequest="70"
                                        HeightRequest="34"
                                        VerticalOptions="Center">
                                    <Entry Text="{Binding QuantityText}"
                                           Keyboard="Numeric"
                                           BackgroundColor="Transparent"
                                           HorizontalTextAlignment="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <skin:SkinHost Style="{StaticResource StepHostStyle}">
                                    <Button Text="+" Style="{StaticResource StepButton}"
                                            Command="{Binding QuantityUpCommand}" />
                                </skin:SkinHost>
                            </HorizontalStackLayout>

                            <!-- Pay with (only when the character owns a Note) -->
                            <Picker Title="Pay with"
                                    ItemsSource="{Binding PayOptions}"
                                    ItemDisplayBinding="{Binding Label}"
                                    SelectedItem="{Binding SelectedPayOption, Mode=TwoWay}"
                                    BackgroundColor="{DynamicResource ThemePanelBackgroundColor}"
                                    TitleColor="Gray"
                                    IsVisible="{Binding HasNotes}" />

                            <Label Text="{Binding PlanText}"
                                   FontSize="12"
                                   LineBreakMode="WordWrap"
                                   IsVisible="{Binding HasPlan}" />
                            <Label Text="{Binding StatusText}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource ThemeDangerButtonColor}"
                                   LineBreakMode="WordWrap"
                                   IsVisible="{Binding HasStatus}" />
                            <Label Text="{Binding WarningText}"
                                   FontSize="12"
                                   TextColor="{DynamicResource ThemeWarningButtonColor}"
                                   LineBreakMode="WordWrap"
                                   IsVisible="{Binding HasWarning}" />
                            <Label Text="{Binding ResultText}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource ThemeConfirmButtonColor}"
                                   LineBreakMode="WordWrap"
                                   IsVisible="{Binding HasResult}" />
                        </VerticalStackLayout>
                    </ScrollView>

                    <Label Grid.Row="1"
                           Text="Select an item to see its details."
                           FontSize="13"
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           IsVisible="{Binding HasNoSelection}" />

                    <!-- Buy -->
                    <skin:SkinHost Grid.Row="2" MaximumWidthRequest="400"
                                   SkinKey="confirm"
                                   FallbackColor="{DynamicResource ThemeConfirmButtonColor}">
                        <Button Text="🛒 Buy"
                                TextColor="White"
                                CornerRadius="6"
                                HeightRequest="40"
                                Padding="14,0"
                                FontSize="13"
                                IsEnabled="{Binding CanBuy}"
                                Command="{Binding BuyCommand}" />
                    </skin:SkinHost>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentView>