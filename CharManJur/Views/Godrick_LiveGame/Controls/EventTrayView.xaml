<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             x:Class="CharManJur.Views.Godrick_LiveGame.Controls.EventTrayView">

    <Grid RowDefinitions="Auto, *, Auto" RowSpacing="8">

        <!-- Row 0: how many, and the advanced toggle -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="8">
            <Label Grid.Column="0"
                   Text="{Binding CountText}"
                   FontSize="12"
                   TextColor="Gray"
                   VerticalOptions="Center" />
            <skin:SkinHost Grid.Column="1"
                           SkinKey="neutral"
                           FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                <Button Text="{Binding AdvancedButtonText}"
                        TextColor="White"
                        CornerRadius="6"
                        WidthRequest="110"
                        HeightRequest="30"
                        Padding="10,0"
                        FontSize="11"
                        Command="{Binding ToggleAdvancedCommand}" />
            </skin:SkinHost>
        </Grid>

        <!-- Row 1: day headings and events, one flat list -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Rows}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Label Text="{Binding HeaderText}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource ThemeDetailBorderColor1}"
                               Margin="2,10,0,2"
                               IsVisible="{Binding IsHeader}" />

                        <Border Stroke="{DynamicResource ThemeDetailBorderColor2}"
                                StrokeThickness="0.5"
                                StrokeShape="RoundRectangle 4"
                                Padding="8"
                                Margin="2"
                                IsVisible="{Binding IsEntry}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsGm}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource ThemeWarningButtonColor}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsRuleSkating}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource ThemeDangerButtonColor}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{Binding Icon}" FontSize="20" VerticalOptions="Start" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6">
                                        <Label Grid.Column="0"
                                               Text="{Binding Label}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="1"
                                               Text="👑 GM"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource ThemeWarningButtonColor}"
                                               IsVisible="{Binding IsGm}" />
                                        <Label Grid.Column="1"
                                               Text="🛹 RULE SKATING"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource ThemeDangerButtonColor}"
                                               IsVisible="{Binding IsRuleSkating}" />
                                        <Label Grid.Column="2" Text="{Binding TimeText}" FontSize="10" TextColor="Gray" />
                                    </Grid>
                                    <Label Text="{Binding Summary}"
                                           FontSize="12"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="{Binding AdvancedText}"
                                           FontSize="9"
                                           TextColor="Gray"
                                           LineBreakMode="WordWrap"
                                           IsVisible="{Binding ShowAdvanced}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="1"
               Text="No events yet."
               FontSize="13"
               TextColor="Gray"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               IsVisible="{Binding HasNoEntries}" />

        <!-- Row 2: older events -->
        <skin:SkinHost Grid.Row="2"
                       SkinKey="neutral"
                       FallbackColor="{DynamicResource ThemeNeutralButtonColor}"
                       IsVisible="{Binding HasMore}">
            <Button Text="{Binding ShowOlderText}"
                    TextColor="White"
                    CornerRadius="6"
                    HeightRequest="34"
                    Padding="14,0"
                    FontSize="11"
                    IsVisible="{Binding HasMore}"
                    Command="{Binding ShowOlderCommand}" />
        </skin:SkinHost>
    </Grid>
</ContentView>