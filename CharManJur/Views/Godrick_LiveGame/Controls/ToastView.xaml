<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CharManJur.Views.Godrick_LiveGame.Controls.ToastView">

    <!-- Put one of these as the LAST child of a page's root grid. It never blocks taps. -->
    <Border x:Name="Card"
            IsVisible="False"
            InputTransparent="True"
            HorizontalOptions="Center"
            VerticalOptions="End"
            WidthRequest="380"
            Margin="0,0,0,80"
            Padding="14,10"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="2"
            Stroke="{DynamicResource ThemeDetailBorderColor1}"
            BackgroundColor="{DynamicResource ThemePanelBackgroundColor}">
        <VerticalStackLayout Spacing="2">
            <Label x:Name="SourceLabel"
                   Text="FROM YOUR GM"
                   FontSize="9"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource ThemeWarningButtonColor}"
                   IsVisible="False" />
            <Label x:Name="TitleLabel"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource ThemeDetailBorderColor1}" />
            <Label x:Name="MessageLabel"
                   FontSize="12"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </Border>
</ContentView>