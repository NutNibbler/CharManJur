<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             x:Class="CharManJur.Views.Godrick_LiveGame.ItemFlyout"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Transparent">

    <Grid>
        <!-- Transparent overlay -->
        <BoxView Grid.Row="0" Grid.Column="0"
                 BackgroundColor="Transparent"
                 InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDismissClicked" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Flyout Content -->
        <Border x:Name="FlyoutBorder"
                Grid.Row="0" Grid.Column="0"
                BackgroundColor="{DynamicResource ThemePanelBackgroundColor}"
                StrokeThickness="1"
                Stroke="{DynamicResource ThemeSectionBorderColor}"
                StrokeShape="RoundRectangle 8"
                Padding="10"
                WidthRequest="240"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <VerticalStackLayout Spacing="3">

                <!-- Header -->
                <Label Text="{Binding ItemName}"
                       FontSize="15"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Margin="0,0,0,2" />
                <BoxView HeightRequest="1" Color="{DynamicResource ThemeDetailBorderColor1}" />

                <!-- Slot Info Display -->
                <Label Text="{Binding SlotInfoDisplay}"
                       FontSize="11"
                       TextColor="{DynamicResource ThemeWarningButtonColor}"
                       HorizontalOptions="Center"
                       IsVisible="{Binding HasSlotInfo}" />

                <!-- Wear (Jewelry and Trinkets: no slot, no limit) -->
                <skin:SkinHost x:Name="WearHost"
                               SkinKey="generic"
                               FallbackColor="#27ae60"
                               IsVisible="False">
                    <Button x:Name="WearButton"
                            Text="💍 Wear"
                            TextColor="White"
                            CornerRadius="6"
                            HeightRequest="30"
                            Padding="14,0"
                            FontSize="11"
                            IsVisible="False"
                            Clicked="OnWearClicked" />
                </skin:SkinHost>

                <!-- Equip to Hand -->
                <skin:SkinHost x:Name="EquipHandHost"
                               SkinKey="generic"
                               FallbackColor="{Binding CanEquipHand, Converter={StaticResource EnabledButtonColorConverter}}">
                    <Button Text="🖐️ Equip to Hand"
                            TextColor="White"
                            CornerRadius="6"
                            HeightRequest="30"
                            Padding="14,0"
                            FontSize="11"
                            IsEnabled="{Binding CanEquipHand}"
                            Command="{Binding EquipHandCommand}" />
                </skin:SkinHost>

                <!-- Equip to Belt -->
                <skin:SkinHost x:Name="EquipBeltHost"
                               SkinKey="generic"
                               FallbackColor="{Binding CanEquipBelt, Converter={StaticResource EnabledButtonColorConverter}}">
                    <Button Text="🪢 Equip to Belt"
                            TextColor="White"
                            CornerRadius="6"
                            HeightRequest="30"
                            Padding="14,0"
                            FontSize="11"
                            IsEnabled="{Binding CanEquipBelt}"
                            Command="{Binding EquipBeltCommand}" />
                </skin:SkinHost>

                <!-- Equip as Armor -->
                <skin:SkinHost x:Name="EquipArmorHost"
                               SkinKey="generic"
                               FallbackColor="{Binding CanEquipArmor, Converter={StaticResource EnabledButtonColorConverter}}">
                    <Button Text="🛡️ Equip as Armor"
                            TextColor="White"
                            CornerRadius="6"
                            HeightRequest="30"
                            Padding="14,0"
                            FontSize="11"
                            IsEnabled="{Binding CanEquipArmor}"
                            Command="{Binding EquipArmorCommand}" />
                </skin:SkinHost>

                <!-- Unequip -->
                <skin:SkinHost SkinKey="warning"
                               FallbackColor="{DynamicResource ThemeWarningButtonColor}"
                               IsVisible="{Binding IsEquipped}">
                    <Button Text="↩️ Unequip"
                            TextColor="White"
                            CornerRadius="6"
                            HeightRequest="30"
                            Padding="14,0"
                            FontSize="11"
                            IsVisible="{Binding IsEquipped}"
                            Command="{Binding UnequipCommand}" />
                </skin:SkinHost>

                <!-- Divider -->
                <BoxView HeightRequest="1"
                         Color="{DynamicResource ThemeDetailBorderColor1}"
                         IsVisible="{Binding IsEquipped}" />

                <!-- Roll Usage Die (only for items that carry one) -->
                <skin:SkinHost x:Name="RollUsageDieHost"
                               SkinKey="create"
                               FallbackColor="#16a085"
                               IsVisible="False">
                    <Button x:Name="RollUsageDieButton"
                            Text="🎲 Roll Usage Die"
                            TextColor="White"
                            CornerRadius="6"
                            HeightRequest="30"
                            Padding="14,0"
                            FontSize="11"
                            IsVisible="False"
                            Clicked="OnRollUsageDieClicked" />
                </skin:SkinHost>

                <!-- Transfer -->
                <skin:SkinHost SkinKey="summary"
                               FallbackColor="{DynamicResource ThemeSummaryButtonColor}">
                    <Button Text="📤 Transfer"
                            TextColor="White"
                            CornerRadius="6"
                            HeightRequest="30"
                            Padding="14,0"
                            FontSize="11"
                            Command="{Binding TransferCommand}" />
                </skin:SkinHost>

                <skin:SkinHost x:Name="EditCustomHost" SkinKey="primary"
                    FallbackColor="{DynamicResource ThemePrimaryButtonColor}"
                    IsVisible="False">
                    <Button x:Name="EditCustomButton"
                        Text="🛠️ Edit Custom Item"
                        TextColor="White"
                        CornerRadius="6"
                        HeightRequest="30"
                        Padding="14,0"
                        FontSize="11"
                        IsVisible="False"
                        Clicked="OnEditCustomClicked" />
                </skin:SkinHost>

                <!-- Divider -->
                <BoxView HeightRequest="1" Color="{DynamicResource ThemeDetailBorderColor1}" />

                <!-- Cancel -->
                <skin:SkinHost SkinKey="neutral"
                               FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                    <Button Text="Cancel"
                            TextColor="White"
                            CornerRadius="6"
                            HeightRequest="30"
                            Padding="14,0"
                            FontSize="11"
                            Command="{Binding CancelCommand}" />
                </skin:SkinHost>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>