<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             x:Class="CharManJur.Views.Godrick_LiveGame.ItemInteractionPopup"
             Title="Item Actions"
             Shell.NavBarIsVisible="False">

    <Grid Padding="20" RowDefinitions="Auto, *, Auto">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="5">
            <Label Text="Item Actions"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource ThemeDetailBorderColor1}"
                   HorizontalOptions="Center" />
            <Label Text="{Binding ItemName}"
                   FontSize="18"
                   HorizontalOptions="Center" />
            <BoxView HeightRequest="2" Color="{DynamicResource ThemeDetailBorderColor1}" />
        </VerticalStackLayout>

        <!-- Action Buttons -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="10">

                <!-- Equip to Hand -->
                <skin:SkinHost SkinKey="primary"
                               FallbackColor="{DynamicResource ThemePrimaryButtonColor}"
                               IsVisible="{Binding CanEquipHand}">
                    <Button Text="🖐️ Equip to Hand"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="45"
                            Padding="14,0"
                            IsVisible="{Binding CanEquipHand}"
                            Command="{Binding EquipHandCommand}" />
                </skin:SkinHost>

                <!-- Equip to Belt -->
                <skin:SkinHost SkinKey="warning"
                               FallbackColor="{DynamicResource ThemeWarningButtonColor}"
                               IsVisible="{Binding CanEquipBelt}">
                    <Button Text="🪢 Equip to Belt"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="45"
                            Padding="14,0"
                            IsVisible="{Binding CanEquipBelt}"
                            Command="{Binding EquipBeltCommand}" />
                </skin:SkinHost>

                <!-- Equip as Armor -->
                <skin:SkinHost SkinKey="confirm"
                               FallbackColor="{DynamicResource ThemeConfirmButtonColor}"
                               IsVisible="{Binding CanEquipArmor}">
                    <Button Text="🛡️ Equip as Armor"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="45"
                            Padding="14,0"
                            IsVisible="{Binding CanEquipArmor}"
                            Command="{Binding EquipArmorCommand}" />
                </skin:SkinHost>

                <!-- Unequip -->
                <skin:SkinHost SkinKey="warning"
                               FallbackColor="{DynamicResource ThemeWarningButtonColor}"
                               IsVisible="{Binding IsEquipped}">
                    <Button Text="↩️ Unequip"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="45"
                            Padding="14,0"
                            IsVisible="{Binding IsEquipped}"
                            Command="{Binding UnequipCommand}" />
                </skin:SkinHost>

                <!-- Drop -->
                <skin:SkinHost SkinKey="danger"
                               FallbackColor="{DynamicResource ThemeDangerButtonColor}">
                    <Button Text="🗑️ Drop Item"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="45"
                            Padding="14,0"
                            Command="{Binding DropCommand}" />
                </skin:SkinHost>

                <!-- Transfer (Future) -->
                <skin:SkinHost SkinKey="summary"
                               FallbackColor="{DynamicResource ThemeSummaryButtonColor}">
                    <Button Text="📤 Transfer to Player"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="45"
                            Padding="14,0"
                            Command="{Binding TransferCommand}" />
                </skin:SkinHost>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Cancel Button -->
        <skin:SkinHost Grid.Row="2"
                       SkinKey="neutral"
                       FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
            <Button Text="Cancel"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="45"
                    Padding="14,0"
                    Command="{Binding CancelCommand}" />
        </skin:SkinHost>

    </Grid>
</ContentPage>