<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:CharManJur.Converters"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             xmlns:controls="clr-namespace:CharManJur.Views.Godrick_LiveGame.Controls"
             x:Class="CharManJur.Views.Godrick_LiveGame.BestowItemPage"
             Title="Bestow Item"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto" MaximumWidthRequest="1200"
          Padding="20"
          RowSpacing="10">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="5">
            <Label Text="📦 Bestow Item"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource ThemeDetailBorderColor1}"
                   HorizontalOptions="Center" />
            <Label Text="Select an item to grant to this character"
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalOptions="Center" />
            <!-- DEBUG: Show item count -->
            <Label x:Name="DebugItemCountLabel"
                   Text="Items: 0"
                   FontSize="12"
                   TextColor="{DynamicResource ThemeWarningButtonColor}"
                   HorizontalOptions="Center" />
            <HorizontalStackLayout x:Name="RecipientRow" Spacing="8" HorizontalOptions="Center" IsVisible="False">
                <Label Text="Give to:" FontSize="14" VerticalOptions="Center" />
                <Picker x:Name="RecipientPicker"
                        WidthRequest="280"
                        BackgroundColor="{DynamicResource ThemePanelBackgroundColor}"
                        TitleColor="Gray" />
            </HorizontalStackLayout>
            <BoxView HeightRequest="2" Color="{DynamicResource ThemeSectionBorderColor}" />
        </VerticalStackLayout>

        <!-- Search / Filter -->
        <Grid Grid.Row="1" RowDefinitions="Auto, *" RowSpacing="10">

            <!-- Filter Bar -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <Border Stroke="{DynamicResource ThemeDetailBorderColor2}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="{DynamicResource ThemePanelBackgroundColor}">
                    <Entry x:Name="SearchEntry"
                           Placeholder="Search items..."
                           BackgroundColor="Transparent"
                           PlaceholderColor="Gray"
                           TextChanged="OnSearchTextChanged" />
                </Border>

                <skin:SkinHost Grid.Column="1"
                               SkinKey="primary"
                               FallbackColor="{DynamicResource ThemePrimaryButtonColor}"
                               VerticalOptions="Center">
                    <Button Text="🔍"
                            TextColor="White"
                            CornerRadius="8"
                            WidthRequest="50"
                            HeightRequest="50"
                            Padding="0"
                            FontSize="18"
                            Clicked="OnSearchClicked" />
                </skin:SkinHost>
            </Grid>

            <!-- Item List -->
            <CollectionView Grid.Row="1"
                            x:Name="ItemsCollectionView"
                            ItemsSource="{Binding FilteredItems}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedItem}"
                            SelectionChanged="OnItemSelectionChanged"
                            HeightRequest="400">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="{DynamicResource ThemeDetailBorderColor2}"
                                StrokeThickness="0.5"
                                StrokeShape="RoundRectangle 4"
                                Padding="10"
                                Margin="3">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding Name}"
                                       FontSize="14"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding BaseDescription}"
                                       FontSize="12"
                                       TextColor="Gray"
                                       LineBreakMode="TailTruncation" />
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding Category}"
                                           FontSize="11"
                                           TextColor="Gray" />
                                    <Label Text="{Binding ValueInChips, StringFormat='🪙 {0}'}"
                                           FontSize="11"
                                           TextColor="{DynamicResource ThemeWarningButtonColor}"
                                           IsVisible="{Binding ValueInChips, Converter={StaticResource IsNotNullConverter}}" />
                                    <Label Text="📦 Stackable"
                                           FontSize="11"
                                           TextColor="{DynamicResource ThemeConfirmButtonColor}"
                                           IsVisible="{Binding IsStackableItem}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="10">

            <!-- Quantity Controls: grouped together -->
            <HorizontalStackLayout Grid.Row="0"
                                   Spacing="8"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                <Label Text="Qty:"
                       FontSize="14"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />

                <skin:SkinHost SkinKey="generic_small"
                               FallbackColor="{DynamicResource ThemeDangerButtonColor}"
                               VerticalOptions="Center">
                    <Button Text="−"
                            TextColor="White"
                            CornerRadius="6"
                            WidthRequest="40"
                            HeightRequest="35"
                            Padding="0"
                            FontSize="18"
                            Clicked="OnQuantityDecrement" />
                </skin:SkinHost>

                <Border Stroke="{DynamicResource ThemeDetailBorderColor2}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 6"
                        BackgroundColor="{DynamicResource ThemePanelBackgroundColor}"
                        WidthRequest="70"
                        HeightRequest="35">
                    <Entry x:Name="QuantityEntry"
                           Text="1"
                           Keyboard="Numeric"
                           BackgroundColor="Transparent"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center"
                           TextChanged="OnQuantityTextChanged" />
                </Border>

                <skin:SkinHost SkinKey="generic_small"
                               FallbackColor="{DynamicResource ThemePrimaryButtonColor}"
                               VerticalOptions="Center">
                    <Button Text="+"
                            TextColor="White"
                            CornerRadius="6"
                            WidthRequest="40"
                            HeightRequest="35"
                            Padding="0"
                            FontSize="18"
                            Clicked="OnQuantityIncrement" />
                </skin:SkinHost>
            </HorizontalStackLayout>

            <!-- Written value (only shown for Notes) -->
            <HorizontalStackLayout x:Name="NoteValueRow"
                                   Grid.Row="1"
                                   Spacing="8"
                                   HorizontalOptions="Center"
                                   IsVisible="False">
                <Label Text="Written value (Marks, min 10):"
                       FontSize="13"
                       VerticalOptions="Center" />
                <Border Stroke="{DynamicResource ThemeDetailBorderColor2}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 6"
                        BackgroundColor="{DynamicResource ThemePanelBackgroundColor}"
                        WidthRequest="90"
                        HeightRequest="35">
                    <Entry x:Name="NoteValueEntry"
                           Text="10"
                           Keyboard="Numeric"
                           BackgroundColor="Transparent"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center" />
                </Border>
            </HorizontalStackLayout>

            <!-- Starting uses (only for items that have uses; defaults to full) -->
            <controls:StartingUsesView x:Name="StartingUsesControl"
                                       Grid.Row="2"
                                       IsVisible="False" />

            <!-- Action Buttons -->
            <Grid Grid.Row="3" ColumnDefinitions="*, *, *" ColumnSpacing="10" MaximumWidthRequest="1200">
                <skin:SkinHost Grid.Column="0"
                               SkinKey="create"
                               FallbackColor="{DynamicResource ThemeCreateButtonColor}">
                    <Button Text="🛠️ Custom"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="45"
                            Padding="14,0"
                            FontSize="12"
                            Clicked="OnCreateCustomItemClicked" />
                </skin:SkinHost>

                <skin:SkinHost Grid.Column="1"
                               SkinKey="confirm"
                               FallbackColor="{DynamicResource ThemeConfirmButtonColor}">
                    <Button Text="✅ Bestow"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="45"
                            Padding="14,0"
                            FontSize="14"
                            FontAttributes="Bold"
                            IsEnabled="{Binding HasSelectedItem}"
                            Clicked="OnBestowClicked" />
                </skin:SkinHost>

                <skin:SkinHost Grid.Column="2"
                               SkinKey="danger"
                               FallbackColor="{DynamicResource ThemeDangerButtonColor}">
                    <Button Text="✖ Cancel"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="45"
                            Padding="14,0"
                            FontSize="14"
                            Clicked="OnCancelClicked" />
                </skin:SkinHost>
            </Grid>
        </Grid>

    </Grid>
</ContentPage>