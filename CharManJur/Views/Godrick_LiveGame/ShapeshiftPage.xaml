<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             x:Class="CharManJur.Views.Godrick_LiveGame.ShapeshiftPage"
             Title="Shapeshift"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <!-- Size and look live on the Button; the host supplies the skin art -->
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="WidthRequest" Value="34" />
            <Setter Property="HeightRequest" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="White" />
        </Style>
        <Style x:Key="StepHostStyle" TargetType="skin:SkinHost">
            <Setter Property="SkinKey" Value="generic_small" />
            <Setter Property="FallbackColor" Value="{DynamicResource ThemeNeutralButtonColor}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*, Auto" Padding="20" RowSpacing="10">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="12" MaximumWidthRequest="900">

                <Label Text="{Binding Title}"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource ThemeDetailBorderColor1}"
                       HorizontalOptions="Center" />
                <Label Text="{Binding Subtitle}" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                <BoxView HeightRequest="2" Color="{DynamicResource ThemeDetailBorderColor1}" />

                <Label Text="{Binding PoolShortText}"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource ThemeDangerButtonColor}"
                       IsVisible="{Binding PoolShort}" />

                <!-- Saved forms: re-use a form you made before -->
                <VerticalStackLayout Spacing="6" IsVisible="{Binding HasSavedForms}">
                    <Label Text="Your saved forms" FontSize="13" FontAttributes="Bold"
                           TextColor="{DynamicResource ThemeWarningButtonColor}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SavedForms}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="{DynamicResource ThemeDetailBorderColor2}"
                                        StrokeThickness="0.5"
                                        StrokeShape="RoundRectangle 4"
                                        Padding="8">
                                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6">
                                        <VerticalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Summary}" FontSize="10" TextColor="Gray" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <skin:SkinHost Grid.Column="1" SkinKey="primary"
                                                       FallbackColor="{DynamicResource ThemePrimaryButtonColor}"
                                                       VerticalOptions="Center">
                                            <Button Text="Use" TextColor="White" CornerRadius="6" WidthRequest="70"
                                                    HeightRequest="32" Padding="0" FontSize="12" Command="{Binding UseCommand}" />
                                        </skin:SkinHost>
                                        <skin:SkinHost Grid.Column="2" SkinKey="danger"
                                                       FallbackColor="{DynamicResource ThemeDangerButtonColor}"
                                                       VerticalOptions="Center">
                                            <Button Text="🗑️" TextColor="White" CornerRadius="6" WidthRequest="40"
                                                    HeightRequest="32" Padding="0" FontSize="12" Command="{Binding DeleteCommand}" />
                                        </skin:SkinHost>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <BoxView HeightRequest="1" Color="{DynamicResource ThemeDetailBorderColor1}" />
                </VerticalStackLayout>

                <!-- 1. How many dice -->
                <VerticalStackLayout Spacing="4" IsVisible="{Binding ShowRollControls}">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="Polymorph Dice to invest" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                        <skin:SkinHost Style="{StaticResource StepHostStyle}">
                            <Button Text="−" Style="{StaticResource StepButton}" Command="{Binding DiceDownCommand}" />
                        </skin:SkinHost>
                        <Label Text="{Binding DiceText}" FontSize="18" FontAttributes="Bold" WidthRequest="40"
                               HorizontalTextAlignment="Center" VerticalOptions="Center" />
                        <skin:SkinHost Style="{StaticResource StepHostStyle}">
                            <Button Text="+" Style="{StaticResource StepButton}" Command="{Binding DiceUpCommand}" />
                        </skin:SkinHost>
                    </HorizontalStackLayout>
                    <Label Text="{Binding DiceRangeText}" FontSize="11" TextColor="Gray" LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <!-- 2. Roll: the app rolls, or the player types what they rolled -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowRollControls}">
                    <HorizontalStackLayout Spacing="8">
                        <skin:SkinHost SkinKey="neutral" FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                            <skin:SkinHost.Triggers>
                                <DataTrigger TargetType="skin:SkinHost" Binding="{Binding IsAppRolls}" Value="True">
                                    <Setter Property="SkinKey" Value="primary" />
                                    <Setter Property="FallbackColor" Value="{DynamicResource ThemePrimaryButtonColor}" />
                                </DataTrigger>
                            </skin:SkinHost.Triggers>
                            <Button Text="🎲 App rolls" TextColor="White" CornerRadius="6" WidthRequest="130"
                                    HeightRequest="32" Padding="14,0" FontSize="12" Command="{Binding SetAppRollsCommand}" />
                        </skin:SkinHost>
                        <skin:SkinHost SkinKey="neutral" FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                            <skin:SkinHost.Triggers>
                                <DataTrigger TargetType="skin:SkinHost" Binding="{Binding IsManual}" Value="True">
                                    <Setter Property="SkinKey" Value="primary" />
                                    <Setter Property="FallbackColor" Value="{DynamicResource ThemePrimaryButtonColor}" />
                                </DataTrigger>
                            </skin:SkinHost.Triggers>
                            <Button Text="✍ I rolled" TextColor="White" CornerRadius="6" WidthRequest="130"
                                    HeightRequest="32" Padding="14,0" FontSize="12" Command="{Binding SetManualCommand}" />
                        </skin:SkinHost>
                    </HorizontalStackLayout>

                    <skin:SkinHost SkinKey="create"
                                   FallbackColor="{DynamicResource ThemeCreateButtonColor}"
                                   HorizontalOptions="Start"
                                   IsVisible="{Binding IsAppRolls}">
                        <Button Text="🎲 Roll the dice" TextColor="White" CornerRadius="8" WidthRequest="200"
                                HeightRequest="42" Padding="14,0" FontSize="14"
                                IsVisible="{Binding IsAppRolls}" Command="{Binding RollCommand}" />
                    </skin:SkinHost>

                    <VerticalStackLayout Spacing="6" IsVisible="{Binding IsManual}">
                        <Label Text="Enter the dice you rolled, separated by spaces (e.g. 4 3 2):" FontSize="11" TextColor="Gray" />
                        <Border Stroke="{DynamicResource ThemeDetailBorderColor2}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 6"
                                BackgroundColor="{DynamicResource ThemePanelBackgroundColor}"
                                HeightRequest="38">
                            <Entry Text="{Binding ManualText}" Placeholder="4 3 2" PlaceholderColor="Gray"
                                   BackgroundColor="Transparent" VerticalOptions="Center" />
                        </Border>
                        <skin:SkinHost SkinKey="primary"
                                       FallbackColor="{DynamicResource ThemePrimaryButtonColor}"
                                       HorizontalOptions="Start">
                            <Button Text="Use these results" TextColor="White" CornerRadius="8" WidthRequest="200"
                                    HeightRequest="40" Padding="14,0" FontSize="13" Command="{Binding UseEnteredCommand}" />
                        </skin:SkinHost>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- 3. The roll, then the traits and the form -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasRolled}">
                    <Label Text="Your dice" FontSize="12" FontAttributes="Bold"
                           TextColor="{DynamicResource ThemeDetailBorderColor1}" />

                    <FlexLayout BindableLayout.ItemsSource="{Binding Dice}" Wrap="Wrap" Direction="Row">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border WidthRequest="56"
                                        HeightRequest="56"
                                        StrokeShape="RoundRectangle 8"
                                        Margin="0,0,8,8"
                                        Stroke="{DynamicResource ThemeDetailBorderColor2}"
                                        StrokeThickness="1"
                                        BackgroundColor="{DynamicResource ThemePanelHeaderBackgroundColor}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsHigh}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource ThemeWarningButtonColor}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding Value}" FontSize="22" FontAttributes="Bold"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Border Stroke="{DynamicResource ThemeDetailBorderColor2}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 6"
                            BackgroundColor="{DynamicResource ThemePanelHeaderBackgroundColor}"
                            Padding="10">
                        <Label Text="{Binding ResultText}" FontSize="14" FontAttributes="Bold" LineBreakMode="WordWrap" />
                    </Border>

                    <BoxView HeightRequest="1" Color="{DynamicResource ThemeDetailBorderColor1}" />

                    <Label Text="{Binding TraitsHeader}"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource ThemeWarningButtonColor}" />

                    <skin:SkinHost SkinKey="create"
                        FallbackColor="{DynamicResource ThemeCreateButtonColor}"
                        HorizontalOptions="Start">
                        <Button Text="➕ Create custom trait"
                            TextColor="White" CornerRadius="6" HeightRequest="32"
                            Padding="12,0" FontSize="11"
                            Command="{Binding OpenTraitCreatorCommand}" />
                    </skin:SkinHost>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Traits}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="{DynamicResource ThemeDetailBorderColor2}"
                                        StrokeThickness="0.5"
                                        StrokeShape="RoundRectangle 4"
                                        Padding="6">
                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalOptions="Start"
                                                  Color="{DynamicResource ThemeDetailBorderColor1}" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" />
                                                <Label Text="{Binding PdText}" FontSize="10" TextColor="Gray" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding Effect}" FontSize="11" TextColor="Gray" LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{DynamicResource ThemeDetailBorderColor1}" />

                    <Label Text="Your form" FontSize="14" FontAttributes="Bold"
                           TextColor="{DynamicResource ThemeWarningButtonColor}" />

                    <Border Stroke="{DynamicResource ThemeWarningButtonColor}"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 6"
                            BackgroundColor="{DynamicResource ThemePanelHeaderBackgroundColor}"
                            Padding="10"
                            IsVisible="{Binding HasClash}">
                        <Label Text="{Binding ClashText}"
                               FontSize="12"
                               TextColor="{DynamicResource ThemeWarningButtonColor}"
                               LineBreakMode="WordWrap" />
                    </Border>

                    <Grid ColumnDefinitions="Auto, 90, Auto, 90" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="VIG" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                        <Border Grid.Column="1"
                                Stroke="{DynamicResource ThemeDetailBorderColor2}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 6"
                                BackgroundColor="{DynamicResource ThemePanelBackgroundColor}"
                                HeightRequest="36">
                            <Entry Text="{Binding VigorText}" Keyboard="Numeric" BackgroundColor="Transparent"
                                   HorizontalTextAlignment="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="2" Text="AGI" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                        <Border Grid.Column="3"
                                Stroke="{DynamicResource ThemeDetailBorderColor2}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 6"
                                BackgroundColor="{DynamicResource ThemePanelBackgroundColor}"
                                HeightRequest="36">
                            <Entry Text="{Binding AgilityText}" Keyboard="Numeric" BackgroundColor="Transparent"
                                   HorizontalTextAlignment="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                    <Label Text="{Binding FormText}" FontSize="12" LineBreakMode="WordWrap" />
                    <Label Text="Your SPI stays the same as your normal form. VIG is only for feats of strength: Stability takes your damage."
                           FontSize="10" TextColor="Gray" LineBreakMode="WordWrap" />

                    <!-- Name and describe the transformation -->
                    <Label Text="Name your transformation" FontSize="12" FontAttributes="Bold" />
                    <Border Stroke="{DynamicResource ThemeDetailBorderColor2}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 6"
                            BackgroundColor="{DynamicResource ThemePanelBackgroundColor}">
                        <Entry Text="{Binding FormName}"
                               Placeholder="{Binding NamePlaceholder}"
                               PlaceholderColor="Gray"
                               MaxLength="40"
                               BackgroundColor="Transparent" />
                    </Border>

                    <Label Text="Describe it (what you turned into, anything outside the trait list)" FontSize="12" FontAttributes="Bold" />
                    <Border Stroke="{DynamicResource ThemeDetailBorderColor2}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 6"
                            BackgroundColor="{DynamicResource ThemePanelBackgroundColor}">
                        <Editor Text="{Binding FormDescription}"
                                Placeholder="e.g. A scarred black wolf with a torn ear"
                                PlaceholderColor="Gray"
                                HeightRequest="80"
                                MaxLength="600"
                                AutoSize="TextChanges"
                                BackgroundColor="Transparent" />
                    </Border>

                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding SaveForm, Mode=TwoWay}"
                                  VerticalOptions="Center"
                                  Color="{DynamicResource ThemeDetailBorderColor1}" />
                        <Label Text="💾 Save this form so I can use it again" FontSize="13" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding OverwriteHint}"
                           FontSize="11"
                           TextColor="{DynamicResource ThemeWarningButtonColor}"
                           IsVisible="{Binding HasOverwriteHint}" />

                    <Border Stroke="{DynamicResource ThemeWarningButtonColor}"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 6"
                            BackgroundColor="{DynamicResource ThemePanelHeaderBackgroundColor}"
                            Padding="10"
                            IsVisible="{Binding HasWarnings}">
                        <Label Text="{Binding WarningsText}"
                               FontSize="12"
                               TextColor="{DynamicResource ThemeWarningButtonColor}"
                               LineBreakMode="WordWrap" />
                    </Border>
                </VerticalStackLayout>

                <Label Text="{Binding Error}"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource ThemeDangerButtonColor}"
                       LineBreakMode="WordWrap"
                       IsVisible="{Binding HasError}" />
            </VerticalStackLayout>
        </ScrollView>

        <HorizontalStackLayout Grid.Row="1" Spacing="10" HorizontalOptions="Center">
            <skin:SkinHost SkinKey="neutral" FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                <Button Text="Cancel" TextColor="White" CornerRadius="8" WidthRequest="140" HeightRequest="45"
                        Padding="14,0" Command="{Binding CancelCommand}" />
            </skin:SkinHost>
            <skin:SkinHost SkinKey="confirm"
                           FallbackColor="{DynamicResource ThemeConfirmButtonColor}"
                           IsVisible="{Binding HasRolled}">
                <Button Text="{Binding ConfirmText}" TextColor="White" CornerRadius="8" WidthRequest="200"
                        HeightRequest="45" Padding="14,0" FontAttributes="Bold"
                        IsVisible="{Binding HasRolled}"
                        IsEnabled="{Binding CanConfirm}" Command="{Binding ConfirmCommand}" />
            </skin:SkinHost>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>