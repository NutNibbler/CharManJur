<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             x:Class="CharManJur.Views.Godrick_LiveGame.RecoverItemPage"
             Title="Recover Item">

    <Grid RowDefinitions="Auto, *, Auto" Padding="15" RowSpacing="10" MaximumWidthRequest="1200">

        <Label Grid.Row="0"
               Text="♻️ Recoverable Items"
               FontSize="18"
               FontAttributes="Bold" />

        <skin:SkinPanel Grid.Row="1"
                        StrokeColor="{DynamicResource ThemeSectionBorderColor}"
                        StrokeThickness="1"
                        CornerRadius="8"
                        ContentPadding="10">
            <CollectionView ItemsSource="{Binding RecoverableItems}"
                             SelectionMode="Single"
                             SelectionChanged="OnItemSelectionChanged">
                <CollectionView.EmptyView>
                    <Label Text="No recoverable items"
                           FontSize="13"
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="{DynamicResource ThemeDetailBorderColor2}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 6"
                                Padding="10"
                                Margin="0,3">
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding DisplayName}"
                                           FontSize="14"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding DroppedAt, StringFormat='Dropped: {0:g}'}"
                                           FontSize="10"
                                           TextColor="Gray" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="{Binding Quantity, StringFormat='x{0}'}"
                                       FontSize="12"
                                       TextColor="{DynamicResource ThemeWarningButtonColor}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </skin:SkinPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="8">
            <skin:SkinHost Grid.Column="0"
                           SkinKey="confirm"
                           FallbackColor="{DynamicResource ThemeConfirmButtonColor}">
                <Button Text="♻️ Recover"
                        TextColor="White"
                        CornerRadius="6"
                        HeightRequest="40"
                        Padding="14,0"
                        FontSize="13"
                        IsEnabled="{Binding HasSelectedItem}"
                        Clicked="OnRecoverClicked" />
            </skin:SkinHost>

            <skin:SkinHost Grid.Column="1"
                           SkinKey="neutral"
                           FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                <Button Text="Cancel"
                        TextColor="White"
                        CornerRadius="6"
                        HeightRequest="40"
                        Padding="14,0"
                        FontSize="13"
                        Clicked="OnCancelClicked" />
            </skin:SkinHost>
        </Grid>

    </Grid>
</ContentPage>