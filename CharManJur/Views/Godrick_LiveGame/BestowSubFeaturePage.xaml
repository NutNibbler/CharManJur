<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             x:Class="CharManJur.Views.Godrick_LiveGame.BestowSubFeaturePage"
             Title="Bestow"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="20" RowSpacing="10" MaximumWidthRequest="1200">

        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <Label x:Name="TitleLabel"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource ThemeDetailBorderColor1}"
                   HorizontalOptions="Center" />
            <BoxView HeightRequest="2" Color="{DynamicResource ThemeDetailBorderColor1}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Stroke="{DynamicResource ThemeDetailBorderColor2}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                BackgroundColor="{DynamicResource ThemePanelBackgroundColor}">
            <Entry x:Name="SearchEntry"
                   PlaceholderColor="Gray"
                   BackgroundColor="Transparent"
                   TextChanged="OnSearchTextChanged" />
        </Border>

        <CollectionView x:Name="EntryList"
                        Grid.Row="2"
                        SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="{DynamicResource ThemeDetailBorderColor2}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{DynamicResource ThemePanelBackgroundColor}"
                            Padding="10"
                            Margin="0,0,0,6">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsOwned}" Value="True">
                                <Setter Property="Opacity" Value="0.55" />
                            </DataTrigger>
                        </Border.Triggers>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" />
                            <Label Text="{Binding DetailLine}"
                                   FontSize="11"
                                   TextColor="{DynamicResource ThemeWarningButtonColor}"
                                   IsVisible="{Binding HasDetailLine}" />
                            <Label Text="{Binding Description}"
                                   FontSize="12"
                                   TextColor="Gray"
                                   LineBreakMode="WordWrap"
                                   IsVisible="{Binding HasDescription}" />
                            <Label Text="✔ Already known"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource ThemeConfirmButtonColor}"
                                   IsVisible="{Binding IsOwned}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="3" Spacing="8" MaximumWidthRequest="800">
            <skin:SkinHost SkinKey="create" FallbackColor="{DynamicResource ThemeCreateButtonColor}">
                <Button x:Name="CreateButton"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="42"
                        Padding="14,0"
                        Clicked="OnCreateCustomClicked" />
            </skin:SkinHost>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <skin:SkinHost Grid.Column="0" SkinKey="neutral" FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                    <Button Text="Cancel"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="45"
                            Padding="14,0"
                            Clicked="OnCancelClicked" />
                </skin:SkinHost>
                <skin:SkinHost Grid.Column="1" SkinKey="confirm" FallbackColor="{DynamicResource ThemeConfirmButtonColor}">
                    <Button Text="Bestow Selected"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="45"
                            Padding="14,0"
                            FontAttributes="Bold"
                            Clicked="OnBestowClicked" />
                </skin:SkinHost>
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>