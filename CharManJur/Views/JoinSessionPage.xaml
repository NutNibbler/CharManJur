<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             x:Class="CharManJur.Views.JoinSessionPage"
             Shell.NavBarIsVisible="False"
             Title="Join Session">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15" MaximumWidthRequest="800">

            <Label Text="Join Session"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <!-- ===== WHILE CONNECTED ===== -->
            <skin:SkinPanel StrokeColor="{DynamicResource ThemeSectionBorderColor}"
                            StrokeThickness="1"
                            CornerRadius="8"
                            ContentPadding="12"
                            IsVisible="{Binding InSession}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding ConnectedBanner}"
                           FontSize="16"
                           FontAttributes="Bold"
                           LineBreakMode="WordWrap" />

                    <Label Text="{Binding ConnectionNote}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource ThemeWarningButtonColor}"
                           LineBreakMode="WordWrap"
                           IsVisible="{Binding HasConnectionNote}" />

                    <skin:SkinHost SkinKey="confirm"
                                   FallbackColor="{DynamicResource ThemeConfirmButtonColor}">
                        <Button Text="Open My Character"
                                TextColor="White"
                                CornerRadius="8"
                                HeightRequest="46"
                                Padding="12,0"
                                FontSize="14"
                                Command="{Binding OpenCharacterCommand}" />
                    </skin:SkinHost>

                    <skin:SkinHost SkinKey="danger"
                                   FallbackColor="{DynamicResource ThemeDangerButtonColor}">
                        <Button Text="Leave Session"
                                TextColor="White"
                                CornerRadius="8"
                                HeightRequest="46"
                                Padding="12,0"
                                FontSize="14"
                                Command="{Binding LeaveCommand}" />
                    </skin:SkinHost>
                </VerticalStackLayout>
            </skin:SkinPanel>

            <!-- ===== JOINING ===== -->
            <VerticalStackLayout Spacing="15" IsVisible="{Binding ShowJoinForm}">

                <skin:SkinPanel StrokeColor="{DynamicResource ThemeSectionBorderColor}"
                                StrokeThickness="1"
                                CornerRadius="8"
                                ContentPadding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🧙 Your character"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource ThemeWarningButtonColor}" />
                        <Picker ItemsSource="{Binding CharacterLabels}"
                                SelectedIndex="{Binding SelectedCharacterIndex, Mode=TwoWay}"
                                Title="Choose a character"
                                FontSize="14"
                                BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" />
                        <Label Text="No completed characters are saved. Finish a character first, then come back."
                               FontSize="11"
                               TextColor="Gray"
                               LineBreakMode="WordWrap"
                               IsVisible="{Binding HasNoCharacters}" />
                    </VerticalStackLayout>
                </skin:SkinPanel>

                <skin:SkinPanel StrokeColor="{DynamicResource ThemeSectionBorderColor}"
                                StrokeThickness="1"
                                CornerRadius="8"
                                ContentPadding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="📡 Sessions on your network"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource ThemeWarningButtonColor}" />
                        <Label Text="Looking for sessions… None found yet. If the GM's session doesn't appear, type its invite code below."
                               FontSize="11"
                               TextColor="Gray"
                               LineBreakMode="WordWrap"
                               IsVisible="{Binding HasNoSessions}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sessions}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                            <Label Text="{Binding Details}" FontSize="11" TextColor="Gray" LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                        <skin:SkinHost Grid.Column="1"
                                                       SkinKey="neutral"
                                                       FallbackColor="{DynamicResource ThemeNeutralButtonColor}"
                                                       VerticalOptions="Center">
                                            <Button Text="Use"
                                                    TextColor="White"
                                                    CornerRadius="6"
                                                    HeightRequest="34"
                                                    Padding="14,0"
                                                    FontSize="12"
                                                    Clicked="OnUseSessionClicked" />
                                        </skin:SkinHost>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </skin:SkinPanel>

                <skin:SkinPanel StrokeColor="{DynamicResource ThemeSectionBorderColor}"
                                StrokeThickness="1"
                                CornerRadius="8"
                                ContentPadding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🔗 Connect"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource ThemeWarningButtonColor}" />

                        <Entry Text="{Binding Address, Mode=TwoWay}"
                               Placeholder="Invite code or address (like 192.168.1.20:47200)"
                               PlaceholderColor="Gray"
                               BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" />

                        <Entry Text="{Binding Password, Mode=TwoWay}"
                               IsPassword="True"
                               Placeholder="Password (leave empty if the GM set none)"
                               PlaceholderColor="Gray"
                               BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" />

                        <Label Text="{Binding ErrorText}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource ThemeDangerButtonColor}"
                               LineBreakMode="WordWrap"
                               IsVisible="{Binding HasError}" />
                        <Label Text="{Binding StatusText}"
                               FontSize="12"
                               TextColor="Gray"
                               LineBreakMode="WordWrap"
                               IsVisible="{Binding HasStatus}" />

                        <skin:SkinHost SkinKey="confirm"
                                       FallbackColor="{DynamicResource ThemeConfirmButtonColor}">
                            <Button Text="Join Session"
                                    TextColor="White"
                                    CornerRadius="8"
                                    HeightRequest="50"
                                    Padding="12,0"
                                    FontSize="16"
                                    IsEnabled="{Binding CanJoin}"
                                    Command="{Binding JoinCommand}" />
                        </skin:SkinHost>
                    </VerticalStackLayout>
                </skin:SkinPanel>
            </VerticalStackLayout>

            <skin:SkinHost SkinKey="neutral"
                           FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                <Button Text="← Back to Menu"
                        TextColor="White"
                        FontSize="16"
                        CornerRadius="8"
                        HeightRequest="50"
                        Clicked="OnBackClicked" />
            </skin:SkinHost>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>