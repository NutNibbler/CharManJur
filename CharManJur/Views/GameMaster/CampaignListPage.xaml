<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             x:Class="CharManJur.Views.CampaignListPage"
             Shell.NavBarIsVisible="False"
             Title="Resume Campaign">

    <Grid RowDefinitions="Auto, *, Auto"
          Padding="20"
          RowSpacing="12"
          MaximumWidthRequest="800">

        <Label Grid.Row="0"
               Text="Resume Campaign"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Campaigns}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedCampaign, Mode=TwoWay}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="5">
                        <skin:SkinPanel StrokeColor="{DynamicResource ThemeSectionBorderColor}"
                                        StrokeThickness="1"
                                        CornerRadius="8"
                                        ContentPadding="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}"
                                       FontSize="18"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding Description}"
                                       FontSize="13"
                                       TextColor="Gray"
                                       LineBreakMode="WordWrap"
                                       IsVisible="{Binding HasDescription}" />
                                <Label Text="{Binding Detail}"
                                       FontSize="12"
                                       TextColor="Gray" />
                            </VerticalStackLayout>
                        </skin:SkinPanel>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="1"
               Text="No campaigns yet. Use Create Campaign on the main menu to make one."
               FontSize="13"
               TextColor="Gray"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               HorizontalTextAlignment="Center"
               IsVisible="{Binding HasNoCampaigns}" />

        <VerticalStackLayout Grid.Row="2" Spacing="10">
            <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="10">
                <skin:SkinHost Grid.Column="0" SkinKey="confirm"
                               FallbackColor="{DynamicResource ThemeConfirmButtonColor}">
                    <Button Text="Open Selected"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="50"
                            Padding="10,0"
                            IsEnabled="{Binding HasSelectedCampaign}"
                            Command="{Binding OpenSelectedCommand}" />
                </skin:SkinHost>

                <skin:SkinHost Grid.Column="1" SkinKey="primary"
                               FallbackColor="{DynamicResource ThemePrimaryButtonColor}">
                    <Button Text="Edit Selected"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="50"
                            Padding="10,0"
                            IsEnabled="{Binding HasSelectedCampaign}"
                            Command="{Binding EditSelectedCommand}" />
                </skin:SkinHost>

                <skin:SkinHost Grid.Column="2" SkinKey="danger"
                               FallbackColor="{DynamicResource ThemeDangerButtonColor}">
                    <Button Text="Delete Selected"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="50"
                            Padding="10,0"
                            IsEnabled="{Binding HasSelectedCampaign}"
                            Command="{Binding DeleteSelectedCommand}" />
                </skin:SkinHost>

                <skin:SkinHost Grid.Column="3" SkinKey="create"
                               FallbackColor="{DynamicResource ThemeCreateButtonColor}">
                    <Button Text="New Campaign"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="50"
                            Padding="10,0"
                            Command="{Binding NewCampaignCommand}" />
                </skin:SkinHost>
            </Grid>

            <skin:SkinHost SkinKey="neutral"
                           FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                <Button Text="← Back to Menu"
                        TextColor="White"
                        FontSize="16"
                        CornerRadius="8"
                        HeightRequest="50"
                        Padding="14,0"
                        Clicked="OnBackClicked" />
            </skin:SkinHost>
        </VerticalStackLayout>

    </Grid>
</ContentPage>