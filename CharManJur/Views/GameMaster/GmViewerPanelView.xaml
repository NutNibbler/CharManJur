<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             x:Class="CharManJur.Views.GmViewerPanelView">

    <Grid RowDefinitions="Auto, *" RowSpacing="10">

        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Pick a connected player to see their character screen, exactly as they see it."
                   FontSize="13"
                   LineBreakMode="WordWrap" />
            <Label Text="It shows their saved character as it is when you open it, and takes over the whole screen. Nothing you do there is saved or logged."
                   FontSize="11"
                   TextColor="Gray"
                   LineBreakMode="WordWrap" />
            <HorizontalStackLayout Spacing="8" Margin="0,4,0,0" IsVisible="{Binding IsOpening}">
                <ActivityIndicator IsRunning="{Binding IsOpening}"
                                   Color="{DynamicResource ThemeDetailBorderColor1}"
                                   WidthRequest="22"
                                   HeightRequest="22" />
                <Label Text="{Binding OpeningText}"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource ThemeDetailBorderColor1}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="8">

                <Label Text="No players are connected. Add test players on the dashboard first."
                       FontSize="12"
                       TextColor="Gray"
                       LineBreakMode="WordWrap"
                       IsVisible="{Binding HasNoPlayers}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Players}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="{DynamicResource ThemeDetailBorderColor2}"
                                    StrokeThickness="0.5"
                                    StrokeShape="RoundRectangle 6"
                                    BackgroundColor="{DynamicResource ThemePanelHeaderBackgroundColor}"
                                    Padding="10">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" />
                                        <Label Text="{Binding Stats}" FontSize="11" TextColor="Gray" />
                                    </VerticalStackLayout>

                                    <skin:SkinHost Grid.Column="1"
                                                   SkinKey="primary"
                                                   FallbackColor="{DynamicResource ThemePrimaryButtonColor}"
                                                   VerticalOptions="Center">
                                        <Button Text="👁️ View"
                                                TextColor="White"
                                                CornerRadius="6"
                                                HeightRequest="34"
                                                Padding="16,0"
                                                FontSize="12"
                                                Clicked="OnViewClicked" />
                                    </skin:SkinHost>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>