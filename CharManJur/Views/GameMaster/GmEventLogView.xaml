<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             x:Class="CharManJur.Views.GmEventLogView">

    <Grid RowDefinitions="Auto, *, Auto" RowSpacing="8">

        <!-- Row 0: count, search and the two filters -->
        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <Label Text="{Binding CountText}" FontSize="12" TextColor="Gray" />

            <Entry Text="{Binding SearchText, Mode=TwoWay}"
                   Placeholder="Search event messages"
                   PlaceholderColor="Gray"
                   FontSize="12"
                   BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" />

            <Picker Title="Player"
                    ItemsSource="{Binding PlayerLabels}"
                    SelectedIndex="{Binding PlayerIndex, Mode=TwoWay}"
                    FontSize="12"
                    TitleColor="Gray"
                    BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" />

            <Picker Title="Event type"
                    ItemsSource="{Binding TypeLabels}"
                    SelectedIndex="{Binding TypeIndex, Mode=TwoWay}"
                    FontSize="12"
                    TitleColor="Gray"
                    BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" />

            <skin:SkinHost SkinKey="neutral"
                           FallbackColor="{DynamicResource ThemeNeutralButtonColor}"
                           HorizontalOptions="Start"
                           IsVisible="{Binding HasFilters}">
                <Button Text="Clear filters"
                        TextColor="White"
                        CornerRadius="6"
                        HeightRequest="30"
                        Padding="12,0"
                        FontSize="11"
                        IsVisible="{Binding HasFilters}"
                        Command="{Binding ClearFiltersCommand}" />
            </skin:SkinHost>
        </VerticalStackLayout>

        <!-- Row 1: day headings and events, one flat list -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Rows}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Label Text="{Binding HeaderText}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource ThemeDetailBorderColor1}"
                               Margin="2,10,0,2"
                               IsVisible="{Binding IsHeader}" />

                        <Border Stroke="{DynamicResource ThemeDetailBorderColor2}"
                                StrokeThickness="0.5"
                                StrokeShape="RoundRectangle 4"
                                Padding="8"
                                Margin="2"
                                IsVisible="{Binding IsEntry}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsGm}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource ThemeWarningButtonColor}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsRuleSkating}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource ThemeDangerButtonColor}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{Binding Icon}" FontSize="20" VerticalOptions="Start" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6">
                                        <Label Grid.Column="0"
                                               Text="{Binding Label}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="1"
                                               Text="👑 GM"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource ThemeWarningButtonColor}"
                                               IsVisible="{Binding IsGm}" />
                                        <Label Grid.Column="1"
                                               Text="🛹 RULE SKATING"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource ThemeDangerButtonColor}"
                                               IsVisible="{Binding IsRuleSkating}" />
                                        <Label Grid.Column="2" Text="{Binding TimeText}" FontSize="10" TextColor="Gray" />
                                    </Grid>
                                    <Label Text="{Binding PlayerLabel}"
                                           FontSize="10"
                                           TextColor="{DynamicResource ThemeDetailBorderColor1}" />
                                    <Label Text="{Binding Summary}"
                                           FontSize="12"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="1"
               Text="{Binding EmptyText}"
               FontSize="13"
               TextColor="Gray"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               IsVisible="{Binding HasNoRows}" />

        <!-- Row 2: older events, and the archive note -->
        <VerticalStackLayout Grid.Row="2" Spacing="6">
            <skin:SkinHost SkinKey="neutral"
                           FallbackColor="{DynamicResource ThemeNeutralButtonColor}"
                           IsVisible="{Binding HasMore}">
                <Button Text="{Binding ShowOlderText}"
                        TextColor="White"
                        CornerRadius="6"
                        HeightRequest="34"
                        Padding="14,0"
                        FontSize="11"
                        IsVisible="{Binding HasMore}"
                        Command="{Binding ShowOlderCommand}" />
            </skin:SkinHost>

            <Label Text="{Binding ArchiveText}"
                   FontSize="10"
                   TextColor="Gray"
                   LineBreakMode="WordWrap"
                   IsVisible="{Binding HasArchive}" />
        </VerticalStackLayout>
    </Grid>
</ContentView>