<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             x:Class="CharManJur.Views.GmMapPanelView">

    <ContentView.Resources>
        <!-- Small buttons: no built-in minimum size or inner padding, so the text sits in the middle -->
        <Style TargetType="Button">
            <Setter Property="MinimumHeightRequest" Value="0" />
            <Setter Property="MinimumWidthRequest" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalOptions" Value="Fill" />
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="LineBreakMode" Value="NoWrap" />
        </Style>
        <Style TargetType="skin:SkinHost">
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentView.Resources>

    <Grid RowDefinitions="Auto, *" RowSpacing="6">

        <!-- ===== Row 0: the map list ===== -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto, Auto, Auto, Auto" ColumnSpacing="4">
            <Picker Grid.Column="0"
                    Title="Maps"
                    ItemsSource="{Binding MapNames}"
                    SelectedIndex="{Binding SelectedMapIndex, Mode=TwoWay}"
                    FontSize="12"
                    TitleColor="Gray"
                    BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" />

            <skin:SkinHost Grid.Column="1" SkinKey="create" FallbackColor="{DynamicResource ThemeCreateButtonColor}" WidthRequest="70" HeightRequest="32">
                <Button Text="➕ Map" TextColor="White" CornerRadius="6" FontSize="12" Command="{Binding NewMapCommand}" />
            </skin:SkinHost>
            <skin:SkinHost Grid.Column="2" SkinKey="generic_small" FallbackColor="{DynamicResource ThemeNeutralButtonColor}" WidthRequest="34" HeightRequest="32">
                <Button Text="✏️" TextColor="White" CornerRadius="4" FontSize="14" IsEnabled="{Binding HasMap}" Command="{Binding RenameMapCommand}" />
            </skin:SkinHost>
            <skin:SkinHost Grid.Column="3" SkinKey="danger" FallbackColor="{DynamicResource ThemeDangerButtonColor}" WidthRequest="34" HeightRequest="32">
                <Button Text="🗑️" TextColor="White" CornerRadius="4" FontSize="14" IsEnabled="{Binding HasMap}" Command="{Binding DeleteMapCommand}" />
            </skin:SkinHost>
            <skin:SkinHost Grid.Column="4" SkinKey="summary" FallbackColor="{DynamicResource ThemeSummaryButtonColor}" WidthRequest="84" HeightRequest="32">
                <Button Text="🖼️ Picture" TextColor="White" CornerRadius="6" FontSize="12" IsEnabled="{Binding HasMap}" Command="{Binding SetImageCommand}" />
            </skin:SkinHost>
            <skin:SkinHost Grid.Column="5" SkinKey="generic_small" FallbackColor="{DynamicResource ThemeNeutralButtonColor}" WidthRequest="34" HeightRequest="32"
                           IsVisible="{Binding HasBackground}">
                <Button Text="✖" TextColor="White" CornerRadius="4" FontSize="12" IsVisible="{Binding HasBackground}" Command="{Binding RemoveImageCommand}" />
            </skin:SkinHost>
        </Grid>

        <!-- ===== Row 1: the board, and the tools and symbols beside it ===== -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 196" ColumnSpacing="6">

            <Grid Grid.Column="0">
                <Border Stroke="{DynamicResource ThemeDetailBorderColor2}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 6"
                        BackgroundColor="#3a3a3a"
                        Padding="0"
                        IsVisible="{Binding HasMap}">
                    <GraphicsView x:Name="Surface"
                                  StartInteraction="OnSurfaceStart"
                                  DragInteraction="OnSurfaceDrag"
                                  EndInteraction="OnSurfaceEnd"
                                  CancelInteraction="OnSurfaceCancel"
                                  StartHoverInteraction="OnSurfaceHover"
                                  MoveHoverInteraction="OnSurfaceHover"
                                  EndHoverInteraction="OnSurfaceHoverEnd" />
                </Border>

                <Label Text="No maps yet. Press ➕ Map to make one (World, City, Dungeon...)."
                       FontSize="13"
                       TextColor="Gray"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="12"
                       IsVisible="{Binding HasNoMap}" />
            </Grid>

            <ScrollView Grid.Column="1">
                <VerticalStackLayout Spacing="8" Padding="2">

                    <!-- Tools -->
                    <FlexLayout Wrap="Wrap" Direction="Row">
                        <skin:SkinHost SkinKey="generic_small" FallbackColor="{DynamicResource ThemeNeutralButtonColor}" WidthRequest="38" HeightRequest="36" Margin="0,0,6,6">
                            <Button x:Name="BtnSelect" StyleId="Select" Text="↖" TextColor="White" CornerRadius="4" FontSize="16" Clicked="OnToolClicked" />
                        </skin:SkinHost>
                        <skin:SkinHost SkinKey="generic_small" FallbackColor="{DynamicResource ThemeNeutralButtonColor}" WidthRequest="38" HeightRequest="36" Margin="0,0,6,6">
                            <Button x:Name="BtnHand" StyleId="Hand" Text="✋" TextColor="White" CornerRadius="4" FontSize="14" Clicked="OnToolClicked" />
                        </skin:SkinHost>
                        <skin:SkinHost SkinKey="generic_small" FallbackColor="{DynamicResource ThemeNeutralButtonColor}" WidthRequest="38" HeightRequest="36" Margin="0,0,6,6">
                            <Button x:Name="BtnPen" StyleId="Pen" Text="✏️" TextColor="White" CornerRadius="4" FontSize="14" Clicked="OnToolClicked" />
                        </skin:SkinHost>
                        <skin:SkinHost SkinKey="generic_small" FallbackColor="{DynamicResource ThemeNeutralButtonColor}" WidthRequest="38" HeightRequest="36" Margin="0,0,6,6">
                            <Button x:Name="BtnLine" StyleId="Line" Text="╱" TextColor="White" CornerRadius="4" FontSize="16" Clicked="OnToolClicked" />
                        </skin:SkinHost>
                        <skin:SkinHost SkinKey="generic_small" FallbackColor="{DynamicResource ThemeNeutralButtonColor}" WidthRequest="38" HeightRequest="36" Margin="0,0,6,6">
                            <Button x:Name="BtnRect" StyleId="Rectangle" Text="▭" TextColor="White" CornerRadius="4" FontSize="16" Clicked="OnToolClicked" />
                        </skin:SkinHost>
                        <skin:SkinHost SkinKey="generic_small" FallbackColor="{DynamicResource ThemeNeutralButtonColor}" WidthRequest="38" HeightRequest="36" Margin="0,0,6,6">
                            <Button x:Name="BtnCircle" StyleId="Circle" Text="◯" TextColor="White" CornerRadius="4" FontSize="16" Clicked="OnToolClicked" />
                        </skin:SkinHost>
                        <skin:SkinHost SkinKey="generic_small" FallbackColor="{DynamicResource ThemeNeutralButtonColor}" WidthRequest="38" HeightRequest="36" Margin="0,0,6,6">
                            <Button x:Name="BtnText" StyleId="Text" Text="T" FontAttributes="Bold" TextColor="White" CornerRadius="4" FontSize="15" Clicked="OnToolClicked" />
                        </skin:SkinHost>
                        <skin:SkinHost SkinKey="generic_small" FallbackColor="{DynamicResource ThemeNeutralButtonColor}" WidthRequest="38" HeightRequest="36" Margin="0,0,6,6">
                            <Button x:Name="BtnErase" StyleId="Eraser" Text="🧽" TextColor="White" CornerRadius="4" FontSize="14" Clicked="OnToolClicked" />
                        </skin:SkinHost>
                    </FlexLayout>

                    <!-- Colors -->
                    <HorizontalStackLayout Spacing="10">
                        <Border x:Name="BtnBlack" StyleId="Black" BackgroundColor="#1a1a1a" Stroke="#cfcfcf" StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 6" WidthRequest="26" HeightRequest="26">
                            <Label x:Name="LblBlack" TextColor="White" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnColorTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border x:Name="BtnRed" StyleId="Red" BackgroundColor="#d62828" Stroke="#cfcfcf" StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 6" WidthRequest="26" HeightRequest="26">
                            <Label x:Name="LblRed" TextColor="White" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnColorTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border x:Name="BtnBlue" StyleId="Blue" BackgroundColor="#1d4ed8" Stroke="#cfcfcf" StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 6" WidthRequest="26" HeightRequest="26">
                            <Label x:Name="LblBlue" TextColor="White" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnColorTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                    </HorizontalStackLayout>

                    <!-- Snap, grid, undo, redo -->
                    <FlexLayout Wrap="Wrap" Direction="Row">
                        <skin:SkinHost SkinKey="generic_small" FallbackColor="{DynamicResource ThemeNeutralButtonColor}" WidthRequest="90" HeightRequest="28" Margin="0,0,6,6">
                            <Button x:Name="BtnSnap" TextColor="White" CornerRadius="4" Padding="4,0" FontSize="10" Clicked="OnSnapClicked" />
                        </skin:SkinHost>
                        <skin:SkinHost SkinKey="generic_small" FallbackColor="{DynamicResource ThemeNeutralButtonColor}" WidthRequest="90" HeightRequest="28" Margin="0,0,6,6">
                            <Button x:Name="BtnGrid" TextColor="White" CornerRadius="4" Padding="4,0" FontSize="10" Clicked="OnGridClicked" />
                        </skin:SkinHost>
                        <skin:SkinHost SkinKey="generic_small" FallbackColor="{DynamicResource ThemeNeutralButtonColor}" WidthRequest="38" HeightRequest="28" Margin="0,0,6,6">
                            <Button x:Name="BtnUndo" Text="↶" TextColor="White" CornerRadius="4" FontSize="16" Clicked="OnUndoClicked" />
                        </skin:SkinHost>
                        <skin:SkinHost SkinKey="generic_small" FallbackColor="{DynamicResource ThemeNeutralButtonColor}" WidthRequest="38" HeightRequest="28" Margin="0,0,6,6">
                            <Button x:Name="BtnRedo" Text="↷" TextColor="White" CornerRadius="4" FontSize="16" Clicked="OnRedoClicked" />
                        </skin:SkinHost>
                    </FlexLayout>

                    <!-- Zoom -->
                    <HorizontalStackLayout Spacing="6">
                        <skin:SkinHost SkinKey="generic_small" FallbackColor="{DynamicResource ThemeNeutralButtonColor}" WidthRequest="34" HeightRequest="28">
                            <Button Text="−" TextColor="White" CornerRadius="4" FontSize="16" Clicked="OnZoomOutClicked" />
                        </skin:SkinHost>
                        <Label x:Name="ZoomLabel" FontSize="12" WidthRequest="44" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                        <skin:SkinHost SkinKey="generic_small" FallbackColor="{DynamicResource ThemeNeutralButtonColor}" WidthRequest="34" HeightRequest="28">
                            <Button Text="+" TextColor="White" CornerRadius="4" FontSize="16" Clicked="OnZoomInClicked" />
                        </skin:SkinHost>
                        <skin:SkinHost SkinKey="generic_small" FallbackColor="{DynamicResource ThemeNeutralButtonColor}" WidthRequest="40" HeightRequest="28">
                            <Button Text="Fit" TextColor="White" CornerRadius="4" FontSize="12" Clicked="OnFitClicked" />
                        </skin:SkinHost>
                    </HorizontalStackLayout>

                    <!-- The selected symbol -->
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding HasSelectedSymbol}">
                        <BoxView HeightRequest="1" Color="{DynamicResource ThemeDetailBorderColor1}" />
                        <Label Text="Selected symbol" FontSize="12" FontAttributes="Bold"
                               TextColor="{DynamicResource ThemeWarningButtonColor}" />
                        <Label Text="Drag it to move it." FontSize="10" TextColor="Gray" />
                        <FlexLayout Wrap="Wrap" Direction="Row">
                            <skin:SkinHost SkinKey="generic_small" FallbackColor="{DynamicResource ThemeNeutralButtonColor}" WidthRequest="38" HeightRequest="32" Margin="0,0,6,6">
                                <Button Text="↺" TextColor="White" CornerRadius="4" FontSize="16" Command="{Binding RotateLeftCommand}" />
                            </skin:SkinHost>
                            <skin:SkinHost SkinKey="generic_small" FallbackColor="{DynamicResource ThemeNeutralButtonColor}" WidthRequest="38" HeightRequest="32" Margin="0,0,6,6">
                                <Button Text="↻" TextColor="White" CornerRadius="4" FontSize="16" Command="{Binding RotateRightCommand}" />
                            </skin:SkinHost>
                            <skin:SkinHost SkinKey="generic_small" FallbackColor="{DynamicResource ThemeNeutralButtonColor}" WidthRequest="38" HeightRequest="32" Margin="0,0,6,6">
                                <Button Text="−" TextColor="White" CornerRadius="4" FontSize="16" Command="{Binding SmallerCommand}" />
                            </skin:SkinHost>
                            <skin:SkinHost SkinKey="generic_small" FallbackColor="{DynamicResource ThemeNeutralButtonColor}" WidthRequest="38" HeightRequest="32" Margin="0,0,6,6">
                                <Button Text="+" TextColor="White" CornerRadius="4" FontSize="16" Command="{Binding BiggerCommand}" />
                            </skin:SkinHost>
                            <skin:SkinHost SkinKey="generic_small" FallbackColor="{DynamicResource ThemeNeutralButtonColor}" WidthRequest="38" HeightRequest="32" Margin="0,0,6,6">
                                <Button Text="⇧" TextColor="White" CornerRadius="4" FontSize="16" Command="{Binding FrontCommand}" />
                            </skin:SkinHost>
                            <skin:SkinHost SkinKey="generic_small" FallbackColor="{DynamicResource ThemeNeutralButtonColor}" WidthRequest="38" HeightRequest="32" Margin="0,0,6,6">
                                <Button Text="⧉" TextColor="White" CornerRadius="4" FontSize="16" Command="{Binding DuplicateCommand}" />
                            </skin:SkinHost>
                            <skin:SkinHost SkinKey="danger" FallbackColor="{DynamicResource ThemeDangerButtonColor}" WidthRequest="38" HeightRequest="32" Margin="0,0,6,6">
                                <Button Text="🗑️" TextColor="White" CornerRadius="4" FontSize="14" Command="{Binding DeleteSymbolCommand}" />
                            </skin:SkinHost>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <!-- The symbol library -->
                    <BoxView HeightRequest="1" Color="{DynamicResource ThemeDetailBorderColor1}" />
                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="4">
                        <Label Grid.Column="0" Text="Symbols" FontSize="12" FontAttributes="Bold"
                               TextColor="{DynamicResource ThemeWarningButtonColor}" VerticalOptions="Center" />
                        <skin:SkinHost Grid.Column="1" SkinKey="summary" FallbackColor="{DynamicResource ThemeSummaryButtonColor}" WidthRequest="46" HeightRequest="28">
                            <Button Text="📥" TextColor="White" CornerRadius="4" FontSize="13" Command="{Binding ImportSymbolsCommand}" />
                        </skin:SkinHost>
                        <skin:SkinHost Grid.Column="2" SkinKey="create" FallbackColor="{DynamicResource ThemeCreateButtonColor}" WidthRequest="46" HeightRequest="28">
                            <Button Text="➕ ●" TextColor="White" CornerRadius="4" FontSize="11" Command="{Binding NewTokenCommand}" />
                        </skin:SkinHost>
                    </Grid>
                    <Label Text="📥 imports PNG or JPG files. ➕ ● makes a colored token. Tap a symbol to place it in the middle of the map."
                           FontSize="10" TextColor="Gray" LineBreakMode="WordWrap" />

                    <FlexLayout BindableLayout.ItemsSource="{Binding SymbolRows}" Wrap="Wrap" Direction="Row">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid WidthRequest="58" Margin="0,0,6,6" RowDefinitions="58, Auto">
                                    <Border Grid.Row="0"
                                            Stroke="{DynamicResource ThemeDetailBorderColor2}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 6"
                                            BackgroundColor="{DynamicResource ThemePanelHeaderBackgroundColor}"
                                            Padding="3">
                                        <Grid>
                                            <Image Source="{Binding Preview}" Aspect="AspectFit" IsVisible="{Binding IsImage}" />
                                            <Border IsVisible="{Binding IsToken}"
                                                    BackgroundColor="{Binding TokenBackground}"
                                                    Stroke="{DynamicResource ThemeDetailBorderColor2}"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 20"
                                                    WidthRequest="38"
                                                    HeightRequest="38"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding TokenText}"
                                                       TextColor="{Binding TokenTextColor}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding PlaceCommand}" />
                                        </Border.GestureRecognizers>
                                    </Border>

                                    <Label Grid.Row="0"
                                           Text="✕"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource ThemeDangerButtonColor}"
                                           HorizontalOptions="End"
                                           VerticalOptions="Start"
                                           Margin="0,1,4,0">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding DeleteCommand}" />
                                        </Label.GestureRecognizers>
                                    </Label>

                                    <Label Grid.Row="1"
                                           Text="{Binding Name}"
                                           FontSize="9"
                                           TextColor="Gray"
                                           LineBreakMode="TailTruncation"
                                           HorizontalTextAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Label Text="Right-click cancels a shape. Middle mouse drags the map. The wheel zooms. (Windows)"
                           FontSize="10" TextColor="Gray" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentView>