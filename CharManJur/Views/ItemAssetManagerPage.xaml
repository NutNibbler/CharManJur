<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:CharManJur.Converters"
             x:Class="CharManJur.Views.ItemAssetManagerPage"
             Shell.NavBarIsVisible="False"
             Title="Item Asset Manager">

    <ContentPage.Resources>
        <converters:LoadedButtonTextConverter x:Key="LoadedButtonTextConverter" />
        <converters:PackIdToNameConverter x:Key="PackIdToNameConverter" />
    </ContentPage.Resources>

    <VerticalStackLayout Padding="0" Spacing="0">

        <Label Text="Custom Items"
               FontSize="32"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,15"/>

        <Picker Title="Filter by Pack"
        Margin="10,0"
        ItemsSource="{Binding AvailablePacks}"
        ItemDisplayBinding="{Binding Name}"
        SelectedItem="{Binding SelectedPackFilter}"/>

        <Button Text="+ Create New Item"
                Margin="10,0"
                BackgroundColor="{DynamicResource ThemeCreateButtonColor}"
                TextColor="White"
                CornerRadius="8"
                HeightRequest="45"
                Command="{Binding CreateNewCommand}"/>

        <Label Text="Installed Custom Items" FontSize="20" FontAttributes="Bold" Margin="10,15,10,0"/>

        <ScrollView HeightRequest="600">
            <VerticalStackLayout Padding="10" Spacing="8" BindableLayout.ItemsSource="{Binding CustomItems}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="{DynamicResource ThemeSectionBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" RowDefinitions="Auto,Auto">

                                <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                                       Text="{Binding Name}"
                                       FontSize="18"
                                       FontAttributes="Bold"/>

                                <Label Grid.Row="1" Grid.Column="0"
                                   FontSize="12"
                                   TextColor="Gray"
                                   VerticalTextAlignment="Center">
                                    <Label.Text>
                                        <MultiBinding Converter="{StaticResource PackIdToNameConverter}">
                                            <Binding Path="SourcePackId" />
                                            <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.AvailablePacks" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>

                                <Button Grid.Row="1" Grid.Column="1"
                                        Text="{Binding IsLoaded, Converter={StaticResource LoadedButtonTextConverter}}"
                                        FontSize="12"
                                        BackgroundColor="{DynamicResource ThemeConfirmButtonColor}"
                                        TextColor="White"
                                        CornerRadius="6"
                                        HeightRequest="36"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleLoadedCommand}"
                                        CommandParameter="{Binding .}"/>

                                <Button Grid.Row="1" Grid.Column="2"
                                        Text="Edit"
                                        FontSize="12"
                                        BackgroundColor="{DynamicResource ThemePrimaryButtonColor}"
                                        TextColor="White"
                                        CornerRadius="6"
                                        HeightRequest="36"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                                        CommandParameter="{Binding .}"/>

                                <Button Grid.Row="1" Grid.Column="3"
                                        Text="Delete"
                                        FontSize="12"
                                        BackgroundColor="{DynamicResource ThemeDangerButtonColor}"
                                        TextColor="White"
                                        CornerRadius="6"
                                        HeightRequest="36"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                        CommandParameter="{Binding .}"/>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <Button Text="← Back"
                Margin="10"
                BackgroundColor="{DynamicResource ThemeNeutralButtonColor}"
                TextColor="White"
                CornerRadius="8"
                HeightRequest="45"
                Clicked="OnBackClicked"/>

    </VerticalStackLayout>
</ContentPage>