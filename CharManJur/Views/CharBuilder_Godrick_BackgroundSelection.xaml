<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:CharManJur.Converters"
             xmlns:viewmodels="clr-namespace:CharManJur.ViewModels"
             x:Class="CharManJur.Views.CharBuilder_Godrick_BackgroundSelection"
             Shell.NavBarIsVisible="False"
             Title="Character Build - Background Selection">

    <Grid RowDefinitions="Auto, *, Auto"
          ColumnDefinitions="0.35*, 0.65*"
          ColumnSpacing="10"
          Padding="10">

        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
               Text="Character Build - Background Selection"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,10,0,15"
               TextColor="{DynamicResource ThemeDetailBorderColor1}" />

        <ScrollView Grid.Row="1" Grid.Column="0">
            <VerticalStackLayout Spacing="5">

                <CollectionView x:Name="BackgroundsCollectionView"
                        ItemsSource="{Binding Backgrounds}"
                        SelectedItem="{Binding SelectedBackground}"
                        SelectionMode="Single">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="5" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
                                <Border Grid.Column="0" Stroke="{DynamicResource ThemeDetailBorderColor1}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12">
                                    <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="White" VerticalTextAlignment="Center"/>
                                </Border>
                                <!-- Edit Button - Only for custom backgrounds -->
                                <Button Grid.Column="1" 
                                Text="✏️" 
                                BackgroundColor="{DynamicResource ThemeDetailBorderColor1}" 
                                TextColor="White" 
                                CornerRadius="15" 
                                WidthRequest="35" 
                                HeightRequest="35"
                                FontSize="12"
                                IsVisible="{Binding Id, Converter={StaticResource IsCustomBackgroundConverter}}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCustomBackgroundCommand}"
                                CommandParameter="{Binding}"/>
                                <!-- Delete Button - Only for custom backgrounds -->
                                <Button Grid.Column="2" 
                                Text="🗑️" 
                                BackgroundColor="{DynamicResource ThemeDangerButtonColor}" 
                                TextColor="White" 
                                CornerRadius="15" 
                                WidthRequest="35" 
                                HeightRequest="35"
                                FontSize="12"
                                IsVisible="{Binding Id, Converter={StaticResource IsCustomBackgroundConverter}}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCustomBackgroundCommand}"
                                CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <ScrollView Grid.Row="1" Grid.Column="1">
            <VerticalStackLayout Spacing="10" Padding="5">

                <Label Text="{Binding SelectedBackgroundName}"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource ThemeDetailBorderColor1}" />

                <BoxView HeightRequest="2" Color="{DynamicResource ThemeDetailBorderColor1}" />

                <Label Text="{Binding SelectedBackgroundDescription}"
                       FontSize="14"
                       LineBreakMode="WordWrap"
                       TextColor="White" />

                <BoxView HeightRequest="2" Color="{DynamicResource ThemeDetailBorderColor1}" />

                <VerticalStackLayout IsVisible="{Binding HasSelectedBackground}">
                    <Label Text="Stat Bonuses"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{DynamicResource ThemeDetailBorderColor1}" />

                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                        <Label Grid.Column="0" Grid.Row="0" Text="{Binding SelectedBackgroundVigorBonus}" FontSize="14" TextColor="White" />
                        <Label Grid.Column="1" Grid.Row="0" Text="{Binding SelectedBackgroundAgilityBonus}" FontSize="14" TextColor="White" />
                        <Label Grid.Column="0" Grid.Row="1" Text="{Binding SelectedBackgroundMindBonus}" FontSize="14" TextColor="White" />
                        <Label Grid.Column="1" Grid.Row="1" Text="{Binding SelectedBackgroundSpiritBonus}" FontSize="14" TextColor="White" />
                    </Grid>

                    <BoxView HeightRequest="2" Color="{DynamicResource ThemeDetailBorderColor1}" Margin="5"/>

                    <Label Text="Skill Bonuses"
                           FontAttributes="Bold"
                           FontSize="14"
                           TextColor="{DynamicResource ThemeDetailBorderColor1}" />
                    <Label Text="{Binding SelectedBackgroundSkillBonuses}"
                           FontSize="13"
                           LineBreakMode="WordWrap"
                           TextColor="White" />

                    <BoxView HeightRequest="2" Color="{DynamicResource ThemeDetailBorderColor1}" Margin="5"/>

                    <Label Text="Starting Items"
                           FontAttributes="Bold"
                           FontSize="14"
                           TextColor="{DynamicResource ThemeDetailBorderColor1}" />
                    <CollectionView ItemsSource="{Binding SelectedBackgroundStartingItems}"
                                    HeightRequest="120">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="#444444"
                                        StrokeThickness="0.5"
                                        StrokeShape="RoundRectangle 4"
                                        Padding="5">
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                                <Label Grid.Column="0" 
                                                       Text="{Binding Quantity}" 
                                                       FontSize="14" 
                                                       FontAttributes="Bold"
                                                       TextColor="White" />
                                                <Label Grid.Column="1" 
                                                       Text="×" 
                                                       FontSize="14" 
                                                       TextColor="Gray" />
                                                <Label Grid.Column="2" 
                                                       FontSize="14" 
                                                       TextColor="White">
                                                    <Label.Text>
                                                        <Binding Path="ItemDetails.Name" 
                                                                 FallbackValue="Loading..." 
                                                                 TargetNullValue="Unknown Item" />
                                                    </Label.Text>
                                                </Label>
                                            </Grid>
                                            <Label FontSize="12" TextColor="#aaaaaa">
                                                <Label.Text>
                                                    <Binding Path="ItemDetails.BaseDescription" 
                                                             FallbackValue="" 
                                                             TargetNullValue="No description" />
                                                </Label.Text>
                                            </Label>
                                            <Label Text="{Binding PlayerNote}"
                                                   FontSize="12"
                                                   TextColor="#888888"
                                                   IsVisible="{Binding PlayerNote, Converter={StaticResource IsNotNullConverter}}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1"
                                                Text="✕"
                                                BackgroundColor="{DynamicResource ThemeDangerButtonColor}"
                                                TextColor="White"
                                                CornerRadius="10"
                                                WidthRequest="30"
                                                HeightRequest="30"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:BackgroundSelectionViewModel}}, Path=RemoveStartingItemCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding ItemDetails.IsPlayerCreated}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <BoxView HeightRequest="2" Color="{DynamicResource ThemeDetailBorderColor1}"/>

                    <!-- Item Choices -->
                    <Label Text="Item Choices"
                       FontAttributes="Bold"
                       FontSize="14"
                       TextColor="{DynamicResource ThemeDetailBorderColor1}"
                       IsVisible="{Binding ItemChoiceDisplays.Any}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ItemChoiceDisplays}" Spacing="10" Padding="5">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="{DynamicResource ThemeDetailBorderColor1}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10">
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="{Binding Choice.Prompt}" FontAttributes="Bold" FontSize="14" TextColor="#4fc3f7" />
                                        <Label Text="{Binding Choice.Description}" FontSize="12" TextColor="#aaaaaa" IsVisible="{Binding Choice.Description}" />
                                        <!-- ===== REMOVED SelectionMode and SelectedItem ===== -->
                                        <CollectionView ItemsSource="{Binding Options}" HeightRequest="120" SelectionMode="None">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Padding="3">
                                                        <CheckBox IsChecked="{Binding IsSelected}" Color="#4fc3f7" />
                                                        <Label Text="{Binding DisplayName}" FontSize="13" TextColor="White" Margin="30,0,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                        <Button Text="+ Create Custom Item" BackgroundColor="{DynamicResource ThemeCreateButtonColor}" TextColor="White" CornerRadius="8" HeightRequest="35" FontSize="12" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:BackgroundSelectionViewModel}}, Path=CreateCustomItemCommand}" 
                                            CommandParameter="{Binding Choice}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="2" Color="{DynamicResource ThemeDetailBorderColor1}"/>

                    <!-- Language Choices -->
                    <Label Text="Languages"
                           FontAttributes="Bold"
                           FontSize="14"
                           TextColor="{DynamicResource ThemeDetailBorderColor1}"
                           Padding="5"/>

                    <CollectionView ItemsSource="{Binding LanguageDisplays}"
                                    HeightRequest="200"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="3">
                                    <Border Stroke="{Binding IsSelected, Converter={StaticResource LanguageBorderConverter}}"
                                            StrokeThickness="{Binding IsSelected, Converter={StaticResource LanguageBorderThicknessConverter}}"
                                            StrokeShape="RoundRectangle 4"
                                            Padding="8"
                                            BackgroundColor="{Binding IsSelected, Converter={StaticResource LanguageBackgroundConverter}}">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Color="#4fc3f7"
                                                      VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="10,0,0,0">
                                                <Label Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="White" />
                                                <Label Text="{Binding Description}"
                                                       FontSize="11"
                                                       TextColor="#aaaaaa"
                                                       LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:BackgroundSelectionViewModel}}, Path=ToggleLanguageCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <BoxView HeightRequest="2" Color="{DynamicResource ThemeDetailBorderColor1}" Margin="5" />

                    <!-- Familiar Choices -->
                    <Label Text="Familiar Choices"
                       FontAttributes="Bold"
                       FontSize="14"
                       TextColor="{DynamicResource ThemeDetailBorderColor2}"
                       IsVisible="{Binding HasFamiliarChoices}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding FamiliarChoiceDisplays}"
                         Spacing="10"
                         IsVisible="{Binding HasFamiliarChoices}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="{DynamicResource ThemeDetailBorderColor2}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="10">
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="{Binding Choice.Prompt}"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           TextColor="{DynamicResource ThemeDetailBorderColor2}" />
                                        <Label Text="{Binding Choice.Description}"
                                           FontSize="12"
                                           TextColor="#aaaaaa"
                                           IsVisible="{Binding Choice.Description}" />

                                        <!-- ===== NO CHECKBOX, SINGLE SELECTION BY TAP ===== -->
                                        <CollectionView ItemsSource="{Binding Options}"
                                            HeightRequest="120"
                                            SelectionMode="Single">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Padding="3">
                                                        <Border Stroke="{Binding IsSelected, Converter={StaticResource FamiliarBorderConverter}}"
                                                            StrokeThickness="{Binding IsSelected, Converter={StaticResource FamiliarBorderThicknessConverter}}"
                                                            StrokeShape="RoundRectangle 4"
                                                            Padding="8"
                                                            BackgroundColor="{Binding IsSelected, Converter={StaticResource FamiliarBackgroundConverter}}">
                                                            <Label Text="{Binding DisplayName}"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               TextColor="White"
                                                               HorizontalOptions="Center"/>
                                                        </Border>
                                                        <Grid.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding SelectCommand}"
                                                                CommandParameter="{Binding .}"/>
                                                        </Grid.GestureRecognizers>
                                                    </Grid>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>

                                        <Button Text="+ Create Custom Familiar"
                                            BackgroundColor="{DynamicResource ThemeCreateButtonColor}"
                                            TextColor="White"
                                            CornerRadius="8"
                                            HeightRequest="35"
                                            FontSize="12"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:BackgroundSelectionViewModel}}, Path=CreateCustomFamiliarCommand}"
                                            CommandParameter="{Binding Choice}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
              ColumnDefinitions="*, *, *, *, *, *"
              ColumnSpacing="3"
              Margin="0,10,0,0">

            <Button Grid.Column="0"
                Text="Next: Hinderance Selection"
                TextColor="White"
                CornerRadius="8"
                HeightRequest="45"
                Command="{Binding ConfirmBackgroundCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding CanConfirmBackground}" Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource ThemeConfirmButtonColor}"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Button" Binding="{Binding CanConfirmBackground}" Value="False">
                        <Setter Property="BackgroundColor" Value="{DynamicResource ThemeNeutralButtonColor}"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button Grid.Column="4"
                    Text="📋 Summary"
                    BackgroundColor="{DynamicResource ThemeSummaryButtonColor}"
                    TextColor="Black"
                    CornerRadius="8"
                    HeightRequest="45"
                    Clicked="OnCharacterSummaryClicked" />

            <Button Grid.Column="3"
                    Text="💾 Save For Later"
                    BackgroundColor="{DynamicResource ThemeWarningButtonColor}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="40"
                    FontSize="16"
                    Clicked="OnSaveForLaterClicked" />

            <Button Grid.Column="1"
                    Text="← Back"
                    BackgroundColor="{DynamicResource ThemeNeutralButtonColor}"
                    TextColor="White"
                    FontSize="16"
                    CornerRadius="8"
                    HeightRequest="45"
                    Clicked="OnBackClicked" />

            <Button Grid.Column="2"
                    Text="Cancel"
                    BackgroundColor="{DynamicResource ThemeDangerButtonColor}"
                    TextColor="White"
                    FontSize="16"
                    CornerRadius="8"
                    HeightRequest="45"
                    Clicked="OnCancelClicked" />

            <Button Grid.Column="5"
                Text="Create Custom Background"
                    BackgroundColor="{DynamicResource ThemeCreateButtonColor}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="45"
                    Command="{Binding CreateCustomBackgroundCommand}"/>

        </Grid>

    </Grid>
</ContentPage>