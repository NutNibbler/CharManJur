<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:CharManJur.Converters"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             xmlns:views="clr-namespace:CharManJur.Views"
             x:Class="CharManJur.Views.CharBuilder_Godrick_ClassSelection"
             Shell.NavBarIsVisible="False"
             Title="ClassAndFeatureSelection">
    <VerticalStackLayout>
        <!--=====Builder Page Header=====-->
        <Label Text="Character Build - Class Selection"
            FontSize="48"
            FontAttributes="Bold"
            HorizontalOptions="Center"/>

        <!--=====Builder Class Selection Body=====-->
        <Grid RowDefinitions="Auto, *"
          ColumnDefinitions="0.25*, 0.75*"
          ColumnSpacing="10"
          Padding="5">

            <!-- LEFT PANEL: Class List -->
            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="10">
                <skin:SkinPanel HeightRequest="329"
                                StrokeColor="{DynamicResource ThemeSectionBorderColor}"
                                StrokeThickness="1" CornerRadius="8" ContentPadding="4">
                    <ScrollView>
                        <CollectionView x:Name="ClassesCollectionView"
                                        ItemsSource="{Binding Classes}"
                                        SelectedItem="{Binding SelectedClass}"
                                        SelectionMode="Single">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="2,1">
                                        <Border Stroke="{DynamicResource ThemeDetailBorderColor1}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="15"
                                                Margin="6">
                                            <Label Text="{Binding ClassName}"
                                                FontSize="16"
                                                FontAttributes="Bold"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </ScrollView>
                </skin:SkinPanel>

                <skin:SkinHost SkinKey="summary" HeightRequest="40"
                               FallbackColor="{DynamicResource ThemeSummaryButtonColor}">
                    <Button Text="📋 Character Summary"
                            TextColor="Black"
                            CornerRadius="10"
                            Clicked="OnCharacterSummaryClicked" />
                </skin:SkinHost>

                <skin:SkinHost SkinKey="warning" HeightRequest="40"
                               FallbackColor="{DynamicResource ThemeWarningButtonColor}">
                    <Button Text="💾 Save For Later"
                            TextColor="White"
                            CornerRadius="8"
                            FontSize="16"
                            Clicked="OnSaveForLaterClicked" />
                </skin:SkinHost>

                <skin:SkinHost SkinKey="neutral" HeightRequest="40"
                               FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                    <Button Text="← Back"
                            TextColor="White"
                            FontSize="16"
                            CornerRadius="10"
                            Clicked="OnBackClicked"/>
                </skin:SkinHost>

                <skin:SkinHost SkinKey="danger" HeightRequest="40"
                               FallbackColor="{DynamicResource ThemeDangerButtonColor}">
                    <Button Text="Cancel"
                            TextColor="White"
                            FontSize="16"
                            CornerRadius="10"
                            Clicked="OnCancelClicked"/>
                </skin:SkinHost>
            </VerticalStackLayout>

            <!-- RIGHT PANEL: Class Details -->
            <ScrollView Grid.Row="1" Grid.Column="1" HeightRequest="550">
                <VerticalStackLayout Spacing="8" Padding="5" MaximumWidthRequest="1000">

                    <!-- Class Header -->
                    <Grid ColumnDefinitions="0.45*,0.35*,0.20*">
                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding SelectedClassName}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource ThemeDetailBorderColor1}"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="Level-Up Allocation Requirement:"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalTextAlignment="Center"
                               TextColor="{DynamicResource ThemeDetailBorderColor1}"  
                               ToolTipProperties.Text="The Ability Score points you must receive on level-up to get a feature from this class."/>
                        <Label Grid.Row="0" Grid.Column="2" Text="{Binding SelectedClassLevelingSkillBonus}"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="Start"
                               VerticalTextAlignment="Center" />
                    </Grid>

                    <BoxView HeightRequest="2" Color="{DynamicResource ThemeDetailBorderColor1}" />

                    <!-- Recurring Benefit-->
                    <Grid RowDefinitions="Auto,*,*" Padding="3">
                        <Label Grid.Row="0" Grid.Column="0" Text="Recurring Benefit"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource ThemeDetailBorderColor1}" />
                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding SelectedClassRecurringBenefit}"
                               FontSize="13" />
                        <Label Grid.Row="2" Grid.Column="0" Text="{Binding SelectedClassHitpointsBenefit}"
                               FontSize="13" />
                    </Grid>

                    <BoxView HeightRequest="2" Color="{DynamicResource ThemeDetailBorderColor1}" />

                    <!-- Class Description -->
                    <Label Text="{Binding SelectedClassDescription}"
                           FontSize="13"
                           LineBreakMode="WordWrap" />

                    <BoxView HeightRequest="2" Color="{DynamicResource ThemeDetailBorderColor1}" />

                    <!-- Class Detail Table -->
                    <Grid RowDefinitions="Auto, *"
                        Padding="15"
                        RowSpacing="10"
                        IsVisible="{Binding IsShifter}"  >

                        <!-- Header -->
                        <VerticalStackLayout Grid.Row="0" Spacing="5">
                            <Label Text="Trait List"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource ThemeDetailBorderColor1}"
                                   HorizontalOptions="Center" />
                            <Label Text="Select traits based on your Polymorph Dice (PD) investment"
                                   FontSize="14"
                                   TextColor="Gray"
                                   HorizontalOptions="Center" />
                            <BoxView HeightRequest="2" Color="{DynamicResource ThemeDetailBorderColor1}" />
                        </VerticalStackLayout>

                        <!-- Table Header -->
                        <Border Grid.Row="1"
                                Stroke="{DynamicResource ThemeDetailBorderColor1}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="0"
                                BackgroundColor="{DynamicResource ThemePanelBackgroundColor}">
                            <Grid RowDefinitions="Auto, *">

                                <!-- Header Row -->
                                <Border Grid.Row="0"
                                        BackgroundColor="{DynamicResource ThemePanelHeaderBackgroundColor}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="10,8">
                                    <Grid ColumnDefinitions="0.15*, 0.25*, 0.60*"
                                          ColumnSpacing="5">
                                        <Label Grid.Column="0"
                                               Text="PD"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               TextColor="{DynamicResource ThemeWarningButtonColor}"
                                               HorizontalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="Trait"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               TextColor="{DynamicResource ThemeWarningButtonColor}"
                                               HorizontalOptions="Start" />
                                        <Label Grid.Column="2"
                                               Text="Effect"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               TextColor="{DynamicResource ThemeWarningButtonColor}"
                                               HorizontalOptions="Start" />
                                    </Grid>
                                </Border>

                                <!-- Scrollable Table Body -->
                                <ScrollView Grid.Row="1">
                                    <CollectionView x:Name="TraitsCollectionView"
                                                    ItemsSource="{Binding Traits}"
                                                    SelectionMode="None">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Stroke="{DynamicResource ThemeSectionBorderColor}"
                                                        StrokeThickness="0.5"
                                                        StrokeShape="RoundRectangle 4"
                                                        Padding="8,6"
                                                        Margin="4,2">
                                                    <Grid ColumnDefinitions="0.15*, 0.25*, 0.60*"
                                                          ColumnSpacing="5">

                                                        <!-- PD -->
                                                        <Label Grid.Column="0"
                                                               Text="{Binding PD}"
                                                               FontSize="13"
                                                               FontAttributes="Bold"
                                                               TextColor="{Binding PD, Converter={StaticResource PDColorConverter}}"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />

                                                        <!-- Trait Name -->
                                                        <Label Grid.Column="1"
                                                               Text="{Binding TraitName}"
                                                               FontSize="13"
                                                               FontAttributes="Bold"
                                                               HorizontalOptions="Start"
                                                               VerticalOptions="Center" />

                                                        <!-- Effect -->
                                                        <Label Grid.Column="2"
                                                               Text="{Binding Effect}"
                                                               FontSize="12"
                                                               TextColor="Gray"
                                                               LineBreakMode="WordWrap"
                                                               HorizontalOptions="Start"
                                                               VerticalOptions="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </ScrollView>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Features List (Sub-selection) -->
                    <Label Text="Class Features"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource ThemeDetailBorderColor1}"
                            IsVisible="{Binding HasFeatures}" />

                    <CollectionView x:Name="FeaturesCollectionView"
                                    ItemsSource="{Binding SelectedClassFeatures}"
                                    SelectedItem="{Binding SelectedFeature}"
                                    SelectionMode="Single"
                                    MaximumHeightRequest="150"
                                    IsVisible="{Binding HasFeatures}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="3,2">
                                    <Border Stroke="{DynamicResource ThemeSectionBorderColor}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 5"
                                            Padding="8">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="{DynamicResource ThemeDetailBorderColor1}" />
                                                        <Setter Property="Stroke" Value="{DynamicResource ThemeDetailBorderColor1}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Label Text="{Binding Name}"
                                               FontSize="12" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Selected Feature Description -->
                    <skin:SkinPanel StrokeColor="{DynamicResource ThemeDetailBorderColor2}"
                                    StrokeThickness="1" CornerRadius="8" ContentPadding="8"
                                    IsVisible="{Binding HasSelectedFeature}">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding SelectedFeatureName}"
                                   Margin="3"
                                   FontAttributes="Bold"
                                   FontSize="13" />
                            <Label Text="{Binding SelectedFeatureDescription}"
                                   Margin="3"
                                   FontSize="12"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </skin:SkinPanel>

                    <!-- ===== SUB-FEATURE UNLOCK SECTION ===== -->
                    <BoxView HeightRequest="2" 
                             Color="{DynamicResource ThemeDetailBorderColor1}" 
                             IsVisible="{Binding HasAnyUnlockableTypes}" />

                    <Label Text="Unlock Sub-Features"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource ThemeDetailBorderColor1}"
                            IsVisible="{Binding HasAnyUnlockableTypes}" />

                    <Grid RowDefinitions="Auto"
                          ColumnDefinitions="*, *"
                          ColumnSpacing="8"
                          RowSpacing="5"
                          IsVisible="{Binding HasAnyUnlockableTypes}">

                        <!-- Column 0 -->
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                            <!-- Column 0: Blueprint -->
                            <skin:SkinHost SkinKey="generic"
                                FallbackColor="{StaticResource BlueprintColor}">
                                <Button Text="📜 Unlock Blueprint"
                                    TextColor="White"
                                    CornerRadius="8"
                                    FontSize="12"
                                    HeightRequest="35"
                                    IsEnabled="{Binding CanUnlockBlueprints}"
                                    Command="{Binding UnlockBlueprintsCommand}" />
                            </skin:SkinHost>

                            <!-- Column 0: Quip -->
                            <skin:SkinHost SkinKey="generic"
                                FallbackColor="{StaticResource QuipColor}">
                                <Button Text="⚡ Unlock Quip"
                                    TextColor="White"
                                    CornerRadius="8"
                                    FontSize="12"
                                    HeightRequest="35"
                                    IsEnabled="{Binding CanUnlockQuips}"
                                    Command="{Binding UnlockQuipsCommand}" />
                            </skin:SkinHost>
                        </VerticalStackLayout>

                        <!-- Column 1 -->
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                            <!-- Column 1: Spell -->
                            <skin:SkinHost SkinKey="generic"
                                FallbackColor="{StaticResource SpellColor}">
                                <Button Text="🔮 Unlock Spell"
                                    TextColor="White"
                                    CornerRadius="8"
                                    FontSize="12"
                                    HeightRequest="35"
                                    IsEnabled="{Binding CanUnlockSpells}"
                                    Command="{Binding UnlockSpellsCommand}" />
                            </skin:SkinHost>

                            <!-- Column 1: Technique -->
                            <skin:SkinHost SkinKey="generic"
                                FallbackColor="{StaticResource TechniqueColor}">
                                <Button Text="🧠 Unlock Technique"
                                    TextColor="White"
                                    CornerRadius="8"
                                    FontSize="12"
                                    HeightRequest="35"
                                    IsEnabled="{Binding CanUnlockTechniques}"
                                    Command="{Binding UnlockTechniquesCommand}" />
                            </skin:SkinHost>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="2" 
                             Color="{DynamicResource ThemeDetailBorderColor1}" 
                             IsVisible="{Binding HasAnyUnlockableTypes}" />

                    <views:WarriorWeaponPanel IsVisible="{Binding IsWarriorSelected}" MaximumWidthRequest="700" />

                    <!-- ===== STARTING DAMAGE TYPE PROFICIENCY ===== -->
                    <skin:SkinPanel MaximumWidthRequest="700"
                                    StrokeColor="{DynamicResource ThemeDetailBorderColor2}"
                                    StrokeThickness="1" CornerRadius="8" ContentPadding="10"
                                    IsVisible="{Binding HasSelectedClass}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Starting Damage Type Proficiency"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource ThemeDetailBorderColor1}" />
                            <Label Text="Pick the damage type you start proficient in, or choose to decide later. Other types unlock after 5 kills."
                                   FontSize="12"
                                   TextColor="Gray"
                                   LineBreakMode="WordWrap" />

                            <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding StartingOptions}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border StrokeShape="RoundRectangle 6"
                                                Padding="8"
                                                Stroke="{DynamicResource ThemeSectionBorderColor}"
                                                StrokeThickness="1">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Stroke" Value="{DynamicResource ThemeConfirmButtonColor}" />
                                                    <Setter Property="StrokeThickness" Value="3" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <Label Grid.Column="0"
                                                       Text="✔"
                                                       FontSize="16"
                                                       VerticalOptions="Center"
                                                       TextColor="{DynamicResource ThemeConfirmButtonColor}"
                                                       IsVisible="{Binding IsSelected}"
                                                       WidthRequest="20" />
                                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                    <Label Text="{Binding Title}" FontSize="13" FontAttributes="Bold" />
                                                    <Label Text="{Binding Description}"
                                                           FontSize="11"
                                                           TextColor="Gray"
                                                           LineBreakMode="WordWrap" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </skin:SkinPanel>
                    
                    <!-- ===== BUTTON ROW: Select This Class + Clear All ===== -->
                    <Grid ColumnDefinitions="*, *, *" 
                          ColumnSpacing="8"
                          IsVisible="{Binding HasSelectedClass}">

                        <skin:SkinHost Grid.Column="1" SkinKey="confirm" HeightRequest="40"
                                       FallbackColor="{DynamicResource ThemeConfirmButtonColor}">
                            <Button Text="{Binding SelectClassButtonText}"
                                    TextColor="White"
                                    CornerRadius="8"
                                    IsEnabled="{Binding CanSelectClass}"
                                    Command="{Binding ConfirmClassSelectionCommand}" />
                        </skin:SkinHost>

                        <skin:SkinHost Grid.Column="2" SkinKey="danger" HeightRequest="40"
                                       FallbackColor="{DynamicResource ThemeDangerButtonColor}">
                            <Button Text="🗑️ Clear Sub-Features"
                                    TextColor="White"
                                    CornerRadius="8"
                                    FontSize="12"
                                    IsVisible="{Binding HasAnyUnlockableTypes}"
                                    IsEnabled="{Binding HasAnyUnlockableTypes}"
                                    Command="{Binding ClearAllSubFeaturesCommand}" />
                        </skin:SkinHost>
                    </Grid>

                    <!-- Fallback for when no class is selected -->
                    <skin:SkinHost SkinKey="neutral" HeightRequest="40"
                                   FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                        <Button Text="Select a Class to Continue"
                                TextColor="White"
                                CornerRadius="8"
                                IsEnabled="False"
                                IsVisible="{Binding HasSelectedClass, Converter={StaticResource InvertedBoolConverter}}" />
                    </skin:SkinHost>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </VerticalStackLayout>
</ContentPage>