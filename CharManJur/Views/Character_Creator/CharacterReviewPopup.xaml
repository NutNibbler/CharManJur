<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             x:Class="CharManJur.Views.CharacterReviewPopup"
             Title="Character Review"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="📋 Character Summary"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource ThemeDetailBorderColor1}"
                   HorizontalOptions="Center" />

            <BoxView HeightRequest="2" Color="{DynamicResource ThemeDetailBorderColor1}" />

            <!-- Campaign Info -->
            <Label Text="Campaign Details"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="{DynamicResource ThemeDetailBorderColor1}" />

            <skin:SkinPanel StrokeColor="{DynamicResource ThemeDetailBorderColor1}"
                            StrokeThickness="1" CornerRadius="8" ContentPadding="10">
                <VerticalStackLayout Spacing="5">
                    <Label x:Name="lblCampaignType" />
                    <Label x:Name="lblPlayerName" />
                    <Label x:Name="lblCharacterName" />
                </VerticalStackLayout>
            </skin:SkinPanel>

            <!-- Ability Scores -->
            <Label Text="Ability Scores"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="{DynamicResource ThemeDetailBorderColor1}" />

            <skin:SkinPanel StrokeColor="{DynamicResource ThemeDetailBorderColor1}"
                            StrokeThickness="1" CornerRadius="8" ContentPadding="10">
                <VerticalStackLayout Spacing="5">
                    <Label x:Name="lblVigor" />
                    <Label x:Name="lblAgility" />
                    <Label x:Name="lblMind" />
                    <Label x:Name="lblSpirit" />
                    <Label x:Name="lblHp" />
                </VerticalStackLayout>
            </skin:SkinPanel>

            <BoxView HeightRequest="2" Color="{DynamicResource ThemeDetailBorderColor1}" />

            <!-- Race Information -->
            <Label Text="Race Information"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="{DynamicResource ThemeDetailBorderColor1}" />

            <skin:SkinPanel StrokeColor="{DynamicResource ThemeDetailBorderColor1}"
                            StrokeThickness="1" CornerRadius="8" ContentPadding="10">
                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" ColumnSpacing="10" RowSpacing="10">
                    <Label Grid.Row="0" Grid.Column="0" x:Name="lblCharacterRace" />
                    <Label Grid.Row="0" Grid.Column="1" x:Name="lblCharacterRaceFeatureName" />
                    <Border Grid.Row="1" Grid.Column="0" Stroke="{DynamicResource ThemeDetailBorderColor1}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="5">
                        <Label x:Name="lblCharacterRaceDescription" />
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Stroke="{DynamicResource ThemeDetailBorderColor1}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="5">
                        <Label x:Name="lblCharacterRaceFeatureDescription" />
                    </Border>
                </Grid>
            </skin:SkinPanel>

            <BoxView HeightRequest="2" Color="{DynamicResource ThemeDetailBorderColor1}" />

            <!-- Class Information -->
            <Label Text="Class Information"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="{DynamicResource ThemeDetailBorderColor1}" />

            <skin:SkinPanel StrokeColor="{DynamicResource ThemeDetailBorderColor1}"
                            StrokeThickness="1" CornerRadius="8" ContentPadding="10">
                <VerticalStackLayout Spacing="8">
                    <!-- Class Name and Level-Up Requirement -->
                    <Grid ColumnDefinitions="Auto, *, Auto, *" ColumnSpacing="5">
                        <Label Grid.Column="0" Text="Class:" FontAttributes="Bold" FontSize="14" TextColor="{DynamicResource ThemeDetailBorderColor1}" />
                        <Label Grid.Column="1" x:Name="lblCharacterClassName" />
                    </Grid>

                    <!-- Class Description and Feature -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <Border Grid.Column="0" Stroke="{DynamicResource ThemeDetailBorderColor1}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="5">
                            <Label x:Name="lblCharacterClassDescription" />
                        </Border>
                        <Border Grid.Column="1" Stroke="{DynamicResource ThemeDetailBorderColor1}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="5">
                            <VerticalStackLayout Spacing="3">
                                <Label x:Name="lblCharacterClassFeatureName" FontAttributes="Bold" />
                                <Label x:Name="lblCharacterClassFeatureDescription" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </skin:SkinPanel>

            <BoxView HeightRequest="2" Color="{DynamicResource ThemeDetailBorderColor1}" />

            <!-- Sub-Features -->
            <Label Text="Acquired Sub-Features"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="{DynamicResource ThemeDetailBorderColor1}" />

            <skin:SkinPanel StrokeColor="{DynamicResource ThemeDetailBorderColor1}"
                            StrokeThickness="1" CornerRadius="8" ContentPadding="10">
                <VerticalStackLayout Spacing="8">

                    <Label Text="📜 Blueprints"
                           FontAttributes="Bold"
                           FontSize="14"
                           TextColor="#27ae60" />
                    <CollectionView x:Name="BlueprintsCollectionView"
                                    ItemsSource="{Binding AcquiredBlueprints}"
                                    HeightRequest="60">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding BlueprintName}" FontSize="13" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <BoxView HeightRequest="1" Color="Gray" Opacity="0.5" />

                    <Label Text="⚡ Quips"
                           FontAttributes="Bold"
                           FontSize="14"
                           TextColor="#9b59b6" />
                    <CollectionView x:Name="QuipsCollectionView"
                                    ItemsSource="{Binding AcquiredQuips}"
                                    HeightRequest="60">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding QuipName}" FontSize="13" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <BoxView HeightRequest="1" Color="Gray" Opacity="0.5" />

                    <Label Text="🔮 Spells"
                           FontAttributes="Bold"
                           FontSize="14"
                           TextColor="#3498db" />
                    <CollectionView x:Name="SpellsCollectionView"
                                    ItemsSource="{Binding AcquiredSpells}"
                                    HeightRequest="60">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding SpellName}" FontSize="13" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <BoxView HeightRequest="1" Color="Gray" Opacity="0.5" />

                    <Label Text="⚔️ Techniques"
                           FontAttributes="Bold"
                           FontSize="14"
                           TextColor="#e67e22" />
                    <CollectionView x:Name="TechniquesCollectionView"
                                    ItemsSource="{Binding AcquiredTechniques}"
                                    HeightRequest="60">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding TechniqueName}" FontSize="13" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </skin:SkinPanel>

            <BoxView HeightRequest="2" Color="{DynamicResource ThemeDetailBorderColor1}" />

            <!-- Background Information -->
            <Label Text="Background Information"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="{DynamicResource ThemeDetailBorderColor1}" />

            <skin:SkinPanel StrokeColor="{DynamicResource ThemeDetailBorderColor1}"
                            StrokeThickness="1" CornerRadius="8" ContentPadding="10">
                <VerticalStackLayout Spacing="5">
                    <Label x:Name="lblBackgroundName" FontAttributes="Bold" />
                    <Label x:Name="lblBackgroundDescription" LineBreakMode="WordWrap" />

                    <BoxView HeightRequest="1" Color="Gray" Opacity="0.5" />

                    <Label Text="Starting Items:"
                           FontAttributes="Bold"
                           FontSize="14"
                           TextColor="{DynamicResource ThemeDetailBorderColor1}" />
                    <CollectionView x:Name="StartingItemsCollectionView" HeightRequest="60">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding ItemDetails.Name}" FontSize="13" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <BoxView HeightRequest="1" Color="Gray" Opacity="0.5" />

                    <Label Text="Skill Bonuses:"
                           FontAttributes="Bold"
                           FontSize="14"
                           TextColor="{DynamicResource ThemeDetailBorderColor1}" />
                    <CollectionView x:Name="SkillBonusesCollectionView" HeightRequest="40">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding SkillName}: +{Binding Bonus}" FontSize="13" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </skin:SkinPanel>

            <BoxView HeightRequest="2" Color="{DynamicResource ThemeDetailBorderColor1}" />

            <!-- Languages -->
            <Label Text="Languages"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="{DynamicResource ThemeDetailBorderColor1}" />

            <skin:SkinPanel StrokeColor="{DynamicResource ThemeDetailBorderColor1}"
                            StrokeThickness="1" CornerRadius="8" ContentPadding="10">
                <Label x:Name="lblLanguages" LineBreakMode="WordWrap" />
            </skin:SkinPanel>

            <BoxView HeightRequest="2" Color="{DynamicResource ThemeDetailBorderColor1}" />

            <!-- Hinderance -->
            <Label Text="Hinderance"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="{DynamicResource ThemeDangerButtonColor}" />

            <skin:SkinPanel StrokeColor="{DynamicResource ThemeDangerButtonColor}"
                            StrokeThickness="1" CornerRadius="8" ContentPadding="10">
                <VerticalStackLayout Spacing="5">
                    <Label x:Name="lblHinderanceName" FontAttributes="Bold" />
                    <Label x:Name="lblHinderanceDescription" LineBreakMode="WordWrap" />
                    <Label x:Name="lblHinderanceReward" TextColor="{DynamicResource ThemeWarningButtonColor}" />
                </VerticalStackLayout>
            </skin:SkinPanel>

            <!-- Buttons -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <skin:SkinHost Grid.Column="0" SkinKey="neutral" HeightRequest="50"
                               FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                    <Button Text="Return"
                            TextColor="White"
                            CornerRadius="8"
                            Clicked="OnGoBackClicked" />
                </skin:SkinHost>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>