<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CharManJur.Views.CurrencyPreferenceView">

    <VerticalStackLayout Spacing="6">
        <Label Text="Currency Display"
               FontSize="20"
               FontAttributes="Bold" />
        <Label Text="The currency used for your total on the character screen (and shop prices). This only changes how amounts are shown, never what you own. Press Save Changes to apply."
               FontSize="13"
               TextColor="Gray" />
        <Picker Title="Currency"
                ItemsSource="{Binding CurrencyUnitOptions}"
                SelectedIndex="{Binding PendingCurrencyIndex, Mode=TwoWay}" />
    </VerticalStackLayout>
</ContentView>