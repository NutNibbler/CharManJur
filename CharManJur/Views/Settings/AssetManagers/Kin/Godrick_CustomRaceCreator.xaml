<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:CharManJur.Converters"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             x:Class="CharManJur.Views.Godrick_CustomRaceCreator"
             Shell.NavBarIsVisible="False"
             Title="Custom Kin Creator">

    <ContentPage.Resources>
        <converters:IsPairedTypeConverter x:Key="IsPairedTypeConverter" />

        <Style x:Key="RemoveHostStyle" TargetType="skin:SkinHost">
            <Setter Property="SkinKey" Value="generic_small"/>
            <Setter Property="FallbackColor" Value="{DynamicResource ThemeDangerButtonColor}"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="Label">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="{DynamicResource ThemeDetailBorderColor1}"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style x:Key="EntryStyle" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="{DynamicResource ThemePanelBackgroundColor}"/>
            <Setter Property="PlaceholderColor" Value="Gray"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="EditorStyle" TargetType="Editor">
            <Setter Property="BackgroundColor" Value="{DynamicResource ThemePanelBackgroundColor}"/>
            <Setter Property="PlaceholderColor" Value="Gray"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HeightRequest" Value="80"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Padding="10,5">
            <Label Text="{Binding PageTitle}" FontSize="28" FontAttributes="Bold" VerticalTextAlignment="Center"/>
            <skin:SkinHost Grid.Column="1" SkinKey="danger" VerticalOptions="Center"
                           FallbackColor="{DynamicResource ThemeDangerButtonColor}">
                <Button Text="Cancel" TextColor="White" CornerRadius="8" HeightRequest="40" WidthRequest="100" Command="{Binding CancelCommand}"/>
            </skin:SkinHost>
            <skin:SkinHost Grid.Column="2" SkinKey="confirm" VerticalOptions="Center"
                           FallbackColor="{DynamicResource ThemeConfirmButtonColor}">
                <Button Text="{Binding SaveButtonText}" TextColor="White" CornerRadius="8" HeightRequest="40" WidthRequest="120" IsEnabled="{Binding CanSave}" Command="{Binding SaveRaceCommand}"/>
            </skin:SkinHost>
        </Grid>

        <!-- Main Content -->
        <ScrollView Grid.Row="1" Padding="10">
            <VerticalStackLayout Spacing="5">

                <!-- Basic Information -->
                <Label Text="Basic Information" Style="{StaticResource SectionHeaderStyle}"/>
                <Label Text="Kin Name*" Style="{StaticResource FieldLabelStyle}"/>
                <Entry Text="{Binding RaceName}" Placeholder="Enter kin name..." Style="{StaticResource EntryStyle}"/>

                <Label Text="Description" Style="{StaticResource FieldLabelStyle}"/>
                <Editor Text="{Binding Description}" Placeholder="Describe this kin..." Style="{StaticResource EditorStyle}" HeightRequest="80"/>

                <Label Text="Feature Name" Style="{StaticResource FieldLabelStyle}"/>
                <Entry Text="{Binding FeatureName}" Placeholder="Enter feature name..." Style="{StaticResource EntryStyle}"/>

                <Label Text="Feature Description" Style="{StaticResource FieldLabelStyle}"/>
                <Editor Text="{Binding FeatureDescription}" Placeholder="Describe the feature..." Style="{StaticResource EditorStyle}" HeightRequest="80"/>

                <!-- Stat Modifiers -->
                <Label Text="Ability Score Modifiers" Style="{StaticResource SectionHeaderStyle}"/>
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                    <Border Grid.Column="0" BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" Padding="8" Stroke="{StaticResource VigorColor}" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                        <VerticalStackLayout>
                            <Label Text="Vigor" FontAttributes="Bold" TextColor="{StaticResource VigorColor}" HorizontalOptions="Center"/>
                            <Entry Text="{Binding VigorModifier}" Keyboard="Numeric" HorizontalOptions="Center" WidthRequest="60" Style="{StaticResource EntryStyle}"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" Padding="8" Stroke="{StaticResource AgilityColor}" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                        <VerticalStackLayout>
                            <Label Text="Agility" FontAttributes="Bold" TextColor="{StaticResource AgilityColor}" HorizontalOptions="Center"/>
                            <Entry Text="{Binding AgilityModifier}" Keyboard="Numeric" HorizontalOptions="Center" WidthRequest="60" Style="{StaticResource EntryStyle}"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" Padding="8" Stroke="{StaticResource MindColor}" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                        <VerticalStackLayout>
                            <Label Text="Mind" FontAttributes="Bold" TextColor="{StaticResource MindColor}" HorizontalOptions="Center"/>
                            <Entry Text="{Binding MindModifier}" Keyboard="Numeric" HorizontalOptions="Center" WidthRequest="60" Style="{StaticResource EntryStyle}"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="3" BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" Padding="8" Stroke="{StaticResource SpiritColor}" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                        <VerticalStackLayout>
                            <Label Text="Spirit" FontAttributes="Bold" TextColor="{StaticResource SpiritColor}" HorizontalOptions="Center"/>
                            <Entry Text="{Binding SpiritModifier}" Keyboard="Numeric" HorizontalOptions="Center" WidthRequest="60" Style="{StaticResource EntryStyle}"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Skill Bonuses -->
                <Label Text="Skill Bonuses" Style="{StaticResource SectionHeaderStyle}"/>
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="5">
                    <Picker Grid.Column="0" ItemsSource="{Binding PredefinedSkills}" SelectedItem="{Binding SelectedSkillName}" Title="Select Skill..." BackgroundColor="{DynamicResource ThemePanelBackgroundColor}"/>
                    <Entry Grid.Column="1" Text="{Binding SelectedSkillBonus}" Keyboard="Numeric" Placeholder="Bonus" WidthRequest="60" Style="{StaticResource EntryStyle}"/>
                    <skin:SkinHost Grid.Column="2" SkinKey="primary" VerticalOptions="Center"
                                   FallbackColor="{DynamicResource ThemeDetailBorderColor1}">
                        <Button Text="Add" Command="{Binding AddSkillCommand}" IsEnabled="{Binding CanAddSkill}" TextColor="White" CornerRadius="8" HeightRequest="40" Padding="14,0"/>
                    </skin:SkinHost>
                </Grid>

                <CollectionView ItemsSource="{Binding SkillBonuses}" HeightRequest="120">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" Padding="5" BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" Margin="0,2">
                                <Label Grid.Column="0" VerticalTextAlignment="Center">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0} +{1}">
                                            <Binding Path="SkillName"/>
                                            <Binding Path="Bonus"/>
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                                <skin:SkinHost Grid.Column="1" Style="{StaticResource RemoveHostStyle}">
                                    <Button Text="✕" TextColor="White" CornerRadius="15" WidthRequest="30" HeightRequest="30" Padding="0" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveSkillCommand}" CommandParameter="{Binding}"/>
                                </skin:SkinHost>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Limb Sets -->
                <Label Text="Limb Sets" Style="{StaticResource SectionHeaderStyle}"/>
                <Label Text="Add Limb Set" Style="{StaticResource FieldLabelStyle}" TextColor="{DynamicResource ThemeConfirmButtonColor}"/>
                <Grid ColumnDefinitions="*,*,*,*,Auto" ColumnSpacing="5">
                    <Entry Grid.Column="0" Text="{Binding LimbSetName}" Placeholder="Name" Style="{StaticResource EntryStyle}"/>
                    <Picker Grid.Column="1" ItemsSource="{Binding LimbPairTypes}" SelectedItem="{Binding SelectedLimbPairType}" Title="Type" BackgroundColor="{DynamicResource ThemePanelBackgroundColor}"/>
                    <Entry Grid.Column="2" Text="{Binding LimbSetIcon}" Placeholder="Icon" Style="{StaticResource EntryStyle}" WidthRequest="50"/>
                    <Entry Grid.Column="3" Text="{Binding LeftSlotName}" Placeholder="Left name" Style="{StaticResource EntryStyle}" 
                           IsVisible="{Binding SelectedLimbPairType, Converter={StaticResource IsPairedTypeConverter}}"/>
                    <skin:SkinHost Grid.Column="4" SkinKey="generic_small" VerticalOptions="Center"
                                   FallbackColor="{DynamicResource ThemeConfirmButtonColor}">
                        <Button Text="+" Command="{Binding AddLimbSetCommand}" IsEnabled="{Binding CanAddLimbSet}" TextColor="White" CornerRadius="8" HeightRequest="40" WidthRequest="40" Padding="0"/>
                    </skin:SkinHost>
                </Grid>

                <Grid ColumnDefinitions="*,*,*,*,Auto" ColumnSpacing="5" Margin="0,2,0,0">
                    <Grid Grid.Column="0" Grid.ColumnSpan="4" IsVisible="{Binding SelectedLimbPairType, Converter={StaticResource IsPairedTypeConverter}}">
                        <Entry Text="{Binding RightSlotName}" Placeholder="Right name" Style="{StaticResource EntryStyle}"/>
                    </Grid>
                </Grid>

                <CollectionView ItemsSource="{Binding LimbSets}" HeightRequest="150">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" Padding="5" BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" Margin="0,2">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding DisplayName}" FontAttributes="Bold"/>
                                    <Label FontSize="12" TextColor="Gray">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} - {1} slots">
                                                <Binding Path="PairType"/>
                                                <Binding Path="SlotCount"/>
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <Label FontSize="12" TextColor="Gray">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} {1} / {2}">
                                                <Binding Path="Icon"/>
                                                <Binding Path="LeftSlotName"/>
                                                <Binding Path="RightSlotName"/>
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                                <skin:SkinHost Grid.Column="1" Style="{StaticResource RemoveHostStyle}">
                                    <Button Text="✕" TextColor="White" CornerRadius="15" WidthRequest="30" HeightRequest="30" Padding="0" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveLimbSetCommand}" CommandParameter="{Binding}"/>
                                </skin:SkinHost>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="* Required fields" FontSize="12" TextColor="Gray" Margin="0,10"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>