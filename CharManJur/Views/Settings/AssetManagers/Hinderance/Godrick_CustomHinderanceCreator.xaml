<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             x:Class="CharManJur.Views.Godrick_CustomHinderanceCreator"
             Shell.NavBarIsVisible="False"
             Title="Custom Hinderance Creator">

    <ContentPage.Resources>
        <!-- Skin hosts for the small stepper / remove buttons -->
        <Style x:Key="StepperHostStyle" TargetType="skin:SkinHost">
            <Setter Property="SkinKey" Value="generic_small"/>
            <Setter Property="FallbackColor" Value="{DynamicResource ThemeNeutralButtonColor}"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>
        <Style x:Key="RemoveHostStyle" TargetType="skin:SkinHost">
            <Setter Property="SkinKey" Value="generic_small"/>
            <Setter Property="FallbackColor" Value="{DynamicResource ThemeDangerButtonColor}"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>

        <Style x:Key="StepperButtonStyle" TargetType="Button">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="WidthRequest" Value="30"/>
            <Setter Property="HeightRequest" Value="30"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="RemoveButtonStyle" TargetType="Button">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="WidthRequest" Value="30"/>
            <Setter Property="HeightRequest" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="Label">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="{DynamicResource ThemeDangerButtonColor}"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style x:Key="EntryStyle" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="{DynamicResource ThemePanelBackgroundColor}"/>
            <Setter Property="PlaceholderColor" Value="Gray"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="EditorStyle" TargetType="Editor">
            <Setter Property="BackgroundColor" Value="{DynamicResource ThemePanelBackgroundColor}"/>
            <Setter Property="PlaceholderColor" Value="Gray"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HeightRequest" Value="80"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Padding="10,5">
            <Label Grid.Column="0" Text="{Binding PageTitle}" FontSize="28" FontAttributes="Bold" TextColor="{DynamicResource ThemeDangerButtonColor}" VerticalTextAlignment="Center"/>
            <skin:SkinHost Grid.Column="1" SkinKey="neutral" VerticalOptions="Center"
                           FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                <Button Text="Cancel" TextColor="White" CornerRadius="8" HeightRequest="40" WidthRequest="100" Command="{Binding CancelCommand}"/>
            </skin:SkinHost>
            <skin:SkinHost Grid.Column="2" SkinKey="confirm" VerticalOptions="Center"
                           FallbackColor="{DynamicResource ThemeConfirmButtonColor}">
                <Button Text="{Binding SaveButtonText}" TextColor="White" CornerRadius="8" HeightRequest="40" WidthRequest="160" IsEnabled="{Binding CanSave}" Command="{Binding SaveHinderanceCommand}"/>
            </skin:SkinHost>
        </Grid>

        <ScrollView Grid.Row="1" Padding="10">
            <VerticalStackLayout Spacing="5">

                <Label Text="Basic Information" Style="{StaticResource SectionHeaderStyle}"/>
                <Label Text="Hinderance Name*" Style="{StaticResource FieldLabelStyle}"/>
                <Entry Text="{Binding Name}" Placeholder="Enter hinderance name..." Style="{StaticResource EntryStyle}"/>

                <Label Text="Description" Style="{StaticResource FieldLabelStyle}"/>
                <Editor Text="{Binding Description}" Placeholder="Describe this hinderance..." Style="{StaticResource EditorStyle}" HeightRequest="80"/>

                <BoxView Color="{DynamicResource ThemeDangerButtonColor}" HeightRequest="2" Margin="5"/>
                <Label Text="Ability Score Modifiers" Style="{StaticResource SectionHeaderStyle}"/>

                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="5">
                    <Border Grid.Column="0" Padding="3" StrokeThickness="2" Stroke="{StaticResource VigorColor}" StrokeShape="RoundRectangle 4">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="2">
                            <Label Grid.Column="0" Text="Vigor" FontAttributes="Bold" TextColor="{StaticResource VigorColor}" FontSize="16" VerticalOptions="Center" HorizontalTextAlignment="Center" WidthRequest="60"/>
                            <Entry Grid.Column="1" Text="{Binding VigorModifier}" Keyboard="Numeric" FontSize="16" Style="{StaticResource EntryStyle}"/>
                            <skin:SkinHost Grid.Column="2" Style="{StaticResource StepperHostStyle}">
                                <Button Text="−" Style="{StaticResource StepperButtonStyle}" Command="{Binding DecrementVigorCommand}"/>
                            </skin:SkinHost>
                            <skin:SkinHost Grid.Column="3" Style="{StaticResource StepperHostStyle}">
                                <Button Text="+" Style="{StaticResource StepperButtonStyle}" Command="{Binding IncrementVigorCommand}"/>
                            </skin:SkinHost>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Padding="3" StrokeThickness="2" Stroke="{StaticResource AgilityColor}" StrokeShape="RoundRectangle 4">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="2">
                            <Label Grid.Column="0" Text="Agility" FontAttributes="Bold" TextColor="{StaticResource AgilityColor}" FontSize="16" VerticalOptions="Center" HorizontalTextAlignment="Center" WidthRequest="60"/>
                            <Entry Grid.Column="1" Text="{Binding AgilityModifier}" Keyboard="Numeric" FontSize="16" Style="{StaticResource EntryStyle}"/>
                            <skin:SkinHost Grid.Column="2" Style="{StaticResource StepperHostStyle}">
                                <Button Text="−" Style="{StaticResource StepperButtonStyle}" Command="{Binding DecrementAgilityCommand}"/>
                            </skin:SkinHost>
                            <skin:SkinHost Grid.Column="3" Style="{StaticResource StepperHostStyle}">
                                <Button Text="+" Style="{StaticResource StepperButtonStyle}" Command="{Binding IncrementAgilityCommand}"/>
                            </skin:SkinHost>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Padding="3" StrokeThickness="2" Stroke="{StaticResource MindColor}" StrokeShape="RoundRectangle 4">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="2">
                            <Label Grid.Column="0" Text="Mind" FontAttributes="Bold" TextColor="{StaticResource MindColor}" FontSize="16" VerticalOptions="Center" HorizontalTextAlignment="Center" WidthRequest="60"/>
                            <Entry Grid.Column="1" Text="{Binding MindModifier}" Keyboard="Numeric" FontSize="16" Style="{StaticResource EntryStyle}"/>
                            <skin:SkinHost Grid.Column="2" Style="{StaticResource StepperHostStyle}">
                                <Button Text="−" Style="{StaticResource StepperButtonStyle}" Command="{Binding DecrementMindCommand}"/>
                            </skin:SkinHost>
                            <skin:SkinHost Grid.Column="3" Style="{StaticResource StepperHostStyle}">
                                <Button Text="+" Style="{StaticResource StepperButtonStyle}" Command="{Binding IncrementMindCommand}"/>
                            </skin:SkinHost>
                        </Grid>
                    </Border>
                    <Border Grid.Column="3" Padding="3" StrokeThickness="2" Stroke="{StaticResource SpiritColor}" StrokeShape="RoundRectangle 4">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="2">
                            <Label Grid.Column="0" Text="Spirit" FontAttributes="Bold" TextColor="{StaticResource SpiritColor}" FontSize="16" VerticalOptions="Center" HorizontalTextAlignment="Center" WidthRequest="60"/>
                            <Entry Grid.Column="1" Text="{Binding SpiritModifier}" Keyboard="Numeric" FontSize="16" Style="{StaticResource EntryStyle}"/>
                            <skin:SkinHost Grid.Column="2" Style="{StaticResource StepperHostStyle}">
                                <Button Text="−" Style="{StaticResource StepperButtonStyle}" Command="{Binding DecrementSpiritCommand}"/>
                            </skin:SkinHost>
                            <skin:SkinHost Grid.Column="3" Style="{StaticResource StepperHostStyle}">
                                <Button Text="+" Style="{StaticResource StepperButtonStyle}" Command="{Binding IncrementSpiritCommand}"/>
                            </skin:SkinHost>
                        </Grid>
                    </Border>
                </Grid>

                <BoxView Color="{DynamicResource ThemeDangerButtonColor}" HeightRequest="2" Margin="5"/>
                <Label Text="Skill Modifiers" Style="{StaticResource SectionHeaderStyle}"/>
                <Grid ColumnDefinitions="150,Auto,Auto,Auto,Auto" ColumnSpacing="5">
                    <Picker Grid.Column="0" ItemsSource="{Binding PredefinedSkills}" SelectedItem="{Binding SelectedSkillName}" Title="Select Skill..." BackgroundColor="{DynamicResource ThemePanelBackgroundColor}"/>
                    <Entry Grid.Column="1" Text="{Binding SelectedSkillModifierAmount}" Keyboard="Numeric" WidthRequest="60" FontSize="20" HorizontalTextAlignment="Center" Style="{StaticResource EntryStyle}"/>
                    <skin:SkinHost Grid.Column="2" Style="{StaticResource StepperHostStyle}">
                        <Button Text="−" Style="{StaticResource StepperButtonStyle}" Command="{Binding DecrementSkillModifierCommand}"/>
                    </skin:SkinHost>
                    <skin:SkinHost Grid.Column="3" Style="{StaticResource StepperHostStyle}">
                        <Button Text="+" Style="{StaticResource StepperButtonStyle}" Command="{Binding IncrementSkillModifierCommand}"/>
                    </skin:SkinHost>
                    <skin:SkinHost Grid.Column="4" SkinKey="danger" VerticalOptions="Center"
                                   FallbackColor="{DynamicResource ThemeDangerButtonColor}">
                        <Button Text="Add" Command="{Binding AddSkillModifierCommand}" IsEnabled="{Binding CanAddSkillModifier}" TextColor="White" CornerRadius="8" HeightRequest="40" Padding="14,0"/>
                    </skin:SkinHost>
                </Grid>

                <CollectionView ItemsSource="{Binding SkillModifiers}" HeightRequest="100">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" Padding="5" BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" Margin="0,2">
                                <Label Grid.Column="0" VerticalTextAlignment="Center">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="SkillName"/>
                                            <Binding Path="Modifier"/>
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                                <skin:SkinHost Grid.Column="1" Style="{StaticResource RemoveHostStyle}">
                                    <Button Text="✕" Style="{StaticResource RemoveButtonStyle}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveSkillModifierCommand}" CommandParameter="{Binding}"/>
                                </skin:SkinHost>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="* Required fields" FontSize="12" TextColor="Gray" Margin="0,10"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>