<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:CharManJur.Converters"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             x:Class="CharManJur.Views.CustomItemCreatorPage"
             Title="Create Custom Item"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10" MaximumWidthRequest="1200">

            <!-- Header -->
            <Label Text="🛠️ Create Custom Item"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource ThemeDetailBorderColor1}"
                   HorizontalOptions="Center" />

            <BoxView HeightRequest="2" Color="{DynamicResource ThemeDetailBorderColor1}" />

            <!-- ===== BASIC INFO ===== -->
            <Label Text="Basic Information"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="{DynamicResource ThemeDetailBorderColor1}" />

            <skin:SkinPanel StrokeColor="{DynamicResource ThemeDetailBorderColor1}"
                            StrokeThickness="1" CornerRadius="8" ContentPadding="10">
                <VerticalStackLayout Spacing="8">

                    <!-- Name (Required) -->
                    <Label Text="Name *" FontAttributes="Bold" FontSize="14" />
                    <Entry x:Name="entryName"
                       Text="{Binding Name, Mode=TwoWay}"
                       Placeholder="Enter item name"
                       BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" />

                    <!-- Category -->
                    <Label Text="Category" FontAttributes="Bold" FontSize="14" />
                    <Picker x:Name="pickerCategory"
                            Title="Select Category"
                            TitleColor="Gray"
                            BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" />

                    <Label x:Name="lblCategoryHelp"
                           FontSize="11"
                           TextColor="Gray"
                           LineBreakMode="WordWrap"
                           IsVisible="False" />
                    
                    <!-- Description -->
                    <Label Text="Description" FontAttributes="Bold" FontSize="14" />
                    <Editor x:Name="editorDescription"
                            Placeholder="Enter description"
                            BackgroundColor="{DynamicResource ThemePanelBackgroundColor}"
                            HeightRequest="60"
                            AutoSize="TextChanges" />

                    <!-- Size -->
                    <Label Text="Size" FontAttributes="Bold" FontSize="14" />
                    <Picker x:Name="pickerSize"
                            Title="Select Size"
                            TitleColor="Gray"
                            BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" />

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <!-- Value -->
                        <VerticalStackLayout>
                            <Label Text="Value (Chips)" FontAttributes="Bold" FontSize="14" />
                            <Entry x:Name="entryValue"
                                   Placeholder="0"
                                   Keyboard="Numeric"
                                   BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" />
                        </VerticalStackLayout>

                        <!-- Rarity -->
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Rarity" FontAttributes="Bold" FontSize="14" />
                            <Picker x:Name="pickerRarity"
                                    Title="Select Rarity"
                                    TitleColor="Gray"
                                    BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <!-- QtyLimit -->
                        <VerticalStackLayout>
                            <Label Text="Qty Limit" FontAttributes="Bold" FontSize="14" />
                            <Entry x:Name="entryQtyLimit"
                                   Placeholder="Stack threshold"
                                   Keyboard="Numeric"
                                   BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" />
                        </VerticalStackLayout>

                        <!-- Uses -->
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Uses" FontAttributes="Bold" FontSize="14" />
                            <Entry x:Name="entryUses"
                                   Placeholder="Max uses"
                                   Keyboard="Numeric"
                                   BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Stackable -->
                    <Label Text="Stackable?" FontAttributes="Bold" FontSize="14" />
                    <CheckBox x:Name="chkStackable" Color="{DynamicResource ThemeDetailBorderColor1}" />
                    <!-- Usage die (ammo-style) -->
                    <Label Text="Usage die?" FontAttributes="Bold" FontSize="14" />
                    <CheckBox x:Name="chkUsageDie" Color="{DynamicResource ThemeDetailBorderColor1}" />

                    <VerticalStackLayout x:Name="usageDieSection" Spacing="6" IsVisible="False">
                        <Label Text="Starting die" FontAttributes="Bold" FontSize="14" />
                        <Picker x:Name="pickerUsageDie"
                                Title="Select Die"
                                TitleColor="Gray"
                                BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" />
                        <Label Text="This item carries a die. When the die is rolled, a 1 or 2 shrinks it one size, and a D4 that does so is used up. Usage-die items don't stack. Uses still work alongside the die."
                               FontSize="11" TextColor="Gray" LineBreakMode="WordWrap" />
                        <Label Text="Hybrid usage?" FontAttributes="Bold" FontSize="14" />
                        <CheckBox x:Name="chkHybrid" Color="{DynamicResource ThemeDetailBorderColor1}" />
                        <Label Text="Needs a Uses value as well as the die. When the die is rolled, a 1 or 2 spends one Use instead of shrinking the die. At 0 uses the item is empty."
                               FontSize="11" TextColor="Gray" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </skin:SkinPanel>

            <!-- ===== WEAPON INFO ===== -->
            <Label Text="⚔️ Weapon Information"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="{DynamicResource ThemeWarningButtonColor}"
                   IsVisible="{Binding Source={x:Reference pickerCategory}, Path=SelectedItem, Converter={StaticResource IsWeaponCategoryConverter}}" />

            <skin:SkinPanel StrokeColor="{DynamicResource ThemeWarningButtonColor}"
                            StrokeThickness="1" CornerRadius="8" ContentPadding="10"
                            IsVisible="{Binding Source={x:Reference pickerCategory}, Path=SelectedItem, Converter={StaticResource IsWeaponCategoryConverter}}">
                <VerticalStackLayout Spacing="8">

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <VerticalStackLayout>
                            <Label Text="Weapon Type" FontAttributes="Bold" FontSize="14" />
                            <Picker x:Name="pickerWeaponKind"
                                    Title="Melee, Thrown or Ranged"
                                    TitleColor="Gray"
                                    BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Damage Type" FontAttributes="Bold" FontSize="14" />
                            <Picker x:Name="pickerDamageType"
                                    Title="Piercing, Bludgeoning or Slashing"
                                    TitleColor="Gray"
                                    BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Label x:Name="lblRangedNote"
                           Text="Ranged weapons are always Piercing."
                           FontSize="11"
                           TextColor="Gray"
                           IsVisible="False" />

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <!-- Damage Die -->
                        <VerticalStackLayout>
                            <Label Text="Damage Die" FontAttributes="Bold" FontSize="14" />
                            <Picker x:Name="pickerWeaponDamage"
                                    Title="Select Damage Die"
                                    TitleColor="Gray"
                                    BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" />
                        </VerticalStackLayout>

                        <!-- Weapon Speed -->
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Weapon Speed" FontAttributes="Bold" FontSize="14" />
                            <Picker x:Name="pickerWeaponSpeed"
                                    Title="Select Weapon Speed"
                                    TitleColor="Gray"
                                    BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Weapon Effects -->
                    <Label Text="Weapon Effects" FontAttributes="Bold" FontSize="14" />
                    <CollectionView x:Name="cvWeaponEffects"
                                    ItemsSource="{Binding WeaponEffects}"
                                    SelectionMode="None"
                                    HeightRequest="120">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="3">
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              Color="{DynamicResource ThemeWarningButtonColor}" />
                                    <Label Text="{Binding DisplayName}"
                                           FontSize="13"
                                           Margin="30,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </skin:SkinPanel>

            <!-- ===== ARMOR INFO ===== -->
            <Label Text="🛡️ Armor Information"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="{DynamicResource ThemeConfirmButtonColor}"
                   IsVisible="{Binding Source={x:Reference pickerCategory}, Path=SelectedItem, Converter={StaticResource IsArmorCategoryConverter}}" />

            <skin:SkinPanel StrokeColor="{DynamicResource ThemeConfirmButtonColor}"
                            StrokeThickness="1" CornerRadius="8" ContentPadding="10"
                            IsVisible="{Binding Source={x:Reference pickerCategory}, Path=SelectedItem, Converter={StaticResource IsArmorCategoryConverter}}">
                <VerticalStackLayout Spacing="8">

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <!-- Armor Type -->
                        <VerticalStackLayout>
                            <Label Text="Armor Type" FontAttributes="Bold" FontSize="14" />
                            <Picker x:Name="pickerArmorType"
                                    TitleColor="Gray"
                                    BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" />
                        </VerticalStackLayout>

                        <!-- Armor Value -->
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Armor Value" FontAttributes="Bold" FontSize="14" />
                            <Entry x:Name="entryArmorValue"
                                   Placeholder="AC bonus"
                                   Keyboard="Numeric"
                                   BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" />
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </skin:SkinPanel>

            <!-- ===== CONTAINER INFO ===== -->
            <Label x:Name="lblContainerHeader"
                   Text="🎒 Container Information"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="{DynamicResource ThemeSectionBorderColor}"
                   IsVisible="False" />

            <skin:SkinPanel x:Name="borderContainer"
                            StrokeColor="{DynamicResource ThemeSectionBorderColor}"
                            StrokeThickness="1" CornerRadius="8" ContentPadding="10"
                            IsVisible="False">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Inventory Slots Provided" FontAttributes="Bold" FontSize="14" />
                    <Entry x:Name="entryContainerSlots"
                           Placeholder="e.g. 12 for a sack, 1 for a mouse pouch"
                           Keyboard="Numeric"
                           BackgroundColor="{DynamicResource ThemePanelBackgroundColor}" />
                    <Label Text="Added to a familiar's inventory while the container is equipped."
                           FontSize="11" TextColor="Gray" />
                </VerticalStackLayout>
            </skin:SkinPanel>

            <BoxView HeightRequest="2" Color="{DynamicResource ThemeDetailBorderColor1}" />

            <!-- ===== FOOTER BUTTONS ===== -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <skin:SkinHost Grid.Column="0" SkinKey="neutral"
                               FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                    <Button Text="Cancel"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="50"
                            Clicked="OnCancelClicked" />
                </skin:SkinHost>

                <skin:SkinHost Grid.Column="1" SkinKey="confirm"
                               FallbackColor="{DynamicResource ThemeConfirmButtonColor}">
                    <Button Text="Create Item"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="50"
                            FontAttributes="Bold"
                            Clicked="OnCreateClicked" />
                </skin:SkinHost>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>