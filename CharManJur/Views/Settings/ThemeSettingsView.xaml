<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             x:Class="CharManJur.Views.ThemeSettingsView">

    <VerticalStackLayout Spacing="15">

        <Label Text="Edits preview immediately. Save Changes to keep them."
               FontSize="14"
               TextColor="Gray"
               HorizontalOptions="Center"/>

        <!-- ===== Base theme ===== -->
        <Label Text="Base Theme" FontSize="24" FontAttributes="Bold"/>
        <Label Text="Dark and Light are built in. Your color edits are remembered separately for each."
               FontSize="12"
               TextColor="Gray"/>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <skin:SkinHost Grid.Column="0" SkinKey="neutral"
                           FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                <skin:SkinHost.Triggers>
                    <DataTrigger TargetType="skin:SkinHost" Binding="{Binding IsDarkThemeSelected}" Value="True">
                        <Setter Property="SkinKey" Value="primary"/>
                        <Setter Property="FallbackColor" Value="{DynamicResource ThemePrimaryButtonColor}"/>
                    </DataTrigger>
                </skin:SkinHost.Triggers>
                <Button Text="🌙 Dark"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="45"
                        Command="{Binding SelectDarkThemeCommand}"/>
            </skin:SkinHost>

            <skin:SkinHost Grid.Column="1" SkinKey="neutral"
                           FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                <skin:SkinHost.Triggers>
                    <DataTrigger TargetType="skin:SkinHost" Binding="{Binding IsLightThemeSelected}" Value="True">
                        <Setter Property="SkinKey" Value="primary"/>
                        <Setter Property="FallbackColor" Value="{DynamicResource ThemePrimaryButtonColor}"/>
                    </DataTrigger>
                </skin:SkinHost.Triggers>
                <Button Text="☀️ Light"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="45"
                        Command="{Binding SelectLightThemeCommand}"/>
            </skin:SkinHost>
        </Grid>

        <BoxView HeightRequest="2" Color="Gray" Margin="0,5"/>

        <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding ThemeColors}">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,6" ColumnDefinitions="*,70,60,70" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="{Binding DisplayName}" FontSize="16" VerticalTextAlignment="Center"/>

                        <Label Grid.Column="1" Text="{Binding HexValue}" FontSize="12" TextColor="Gray" VerticalTextAlignment="Center"/>

                        <BoxView Grid.Column="2" Color="{Binding PreviewColor}" WidthRequest="32" HeightRequest="32" CornerRadius="6"/>

                        <skin:SkinHost Grid.Column="3" SkinKey="primary"
                                       FallbackColor="{DynamicResource ThemePrimaryButtonColor}">
                            <Button Text="Edit"
                                    FontSize="12"
                                    TextColor="White"
                                    CornerRadius="6"
                                    HeightRequest="36"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditColorCommand}"
                                    CommandParameter="{Binding .}"/>
                        </skin:SkinHost>
                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <skin:SkinHost SkinKey="danger" FallbackColor="{DynamicResource ThemeDangerButtonColor}">
            <Button Text="Reset All to Defaults"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="45"
                    Command="{Binding ResetToDefaultsCommand}"/>
        </skin:SkinHost>

        <BoxView HeightRequest="2" Color="Gray" Margin="0,15"/>

        <Label Text="Saved Themes"
               FontSize="24"
               FontAttributes="Bold"/>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Grid.Column="0" Placeholder="Theme name" Text="{Binding NewThemeName}"/>
            <skin:SkinHost Grid.Column="1" SkinKey="primary"
                           FallbackColor="{DynamicResource ThemePrimaryButtonColor}">
                <Button Text="Save Current as Theme"
                        TextColor="White"
                        CornerRadius="8"
                        Command="{Binding SaveCurrentAsThemeCommand}"/>
            </skin:SkinHost>
        </Grid>

        <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding SavedThemeNames}">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,4" ColumnDefinitions="*,80,80" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="{Binding .}" FontSize="16" VerticalTextAlignment="Center"/>

                        <skin:SkinHost Grid.Column="1" SkinKey="primary"
                                       FallbackColor="{DynamicResource ThemePrimaryButtonColor}">
                            <Button Text="Load"
                                    FontSize="12"
                                    TextColor="White"
                                    CornerRadius="6"
                                    HeightRequest="36"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.LoadThemeCommand}"
                                    CommandParameter="{Binding .}"/>
                        </skin:SkinHost>

                        <skin:SkinHost Grid.Column="2" SkinKey="danger"
                                       FallbackColor="{DynamicResource ThemeDangerButtonColor}">
                            <Button Text="Delete"
                                    FontSize="12"
                                    TextColor="White"
                                    CornerRadius="6"
                                    HeightRequest="36"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteThemeCommand}"
                                    CommandParameter="{Binding .}"/>
                        </skin:SkinHost>
                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentView>