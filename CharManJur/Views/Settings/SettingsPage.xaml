<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:CharManJur.Converters"
             xmlns:views="clr-namespace:CharManJur.Views"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             x:Class="CharManJur.Views.SettingsPage"
             Shell.NavBarIsVisible="False"
             Title="Settings">

    <ContentPage.Resources>
        <converters:LoadedButtonTextConverter x:Key="LoadedButtonTextConverter" />
        <converters:IsNotLocalPackConverter x:Key="IsNotLocalPackConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="0" Spacing="0">

            <Label Text="Settings"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,15"/>

            <!-- ===== Tab Header (neutral by default, primary while selected) ===== -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4" Padding="10,0">

                <skin:SkinHost Grid.Column="0" SkinKey="neutral"
                               FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                    <skin:SkinHost.Triggers>
                        <DataTrigger TargetType="skin:SkinHost" Binding="{Binding IsGeneralTabSelected}" Value="True">
                            <Setter Property="SkinKey" Value="primary"/>
                            <Setter Property="FallbackColor" Value="{DynamicResource ThemePrimaryButtonColor}"/>
                        </DataTrigger>
                    </skin:SkinHost.Triggers>
                    <Button Text="General"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="45"
                            Command="{Binding SelectGeneralTabCommand}"/>
                </skin:SkinHost>

                <skin:SkinHost Grid.Column="1" SkinKey="neutral"
                               FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                    <skin:SkinHost.Triggers>
                        <DataTrigger TargetType="skin:SkinHost" Binding="{Binding IsThemeTabSelected}" Value="True">
                            <Setter Property="SkinKey" Value="primary"/>
                            <Setter Property="FallbackColor" Value="{DynamicResource ThemePrimaryButtonColor}"/>
                        </DataTrigger>
                    </skin:SkinHost.Triggers>
                    <Button Text="Theme"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="45"
                            Command="{Binding SelectThemeTabCommand}"/>
                </skin:SkinHost>

                <skin:SkinHost Grid.Column="2" SkinKey="neutral"
                               FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                    <skin:SkinHost.Triggers>
                        <DataTrigger TargetType="skin:SkinHost" Binding="{Binding IsSkinsTabSelected}" Value="True">
                            <Setter Property="SkinKey" Value="primary"/>
                            <Setter Property="FallbackColor" Value="{DynamicResource ThemePrimaryButtonColor}"/>
                        </DataTrigger>
                    </skin:SkinHost.Triggers>
                    <Button Text="Skins"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="45"
                            Command="{Binding SelectSkinsTabCommand}"/>
                </skin:SkinHost>

                <skin:SkinHost Grid.Column="3" SkinKey="neutral"
                               FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                    <skin:SkinHost.Triggers>
                        <DataTrigger TargetType="skin:SkinHost" Binding="{Binding IsAssetManagerTabSelected}" Value="True">
                            <Setter Property="SkinKey" Value="primary"/>
                            <Setter Property="FallbackColor" Value="{DynamicResource ThemePrimaryButtonColor}"/>
                        </DataTrigger>
                    </skin:SkinHost.Triggers>
                    <Button Text="Asset Manager"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="45"
                            Command="{Binding SelectAssetManagerTabCommand}"/>
                </skin:SkinHost>
            </Grid>

            <!-- ===== Save Changes bar (applies to whichever tab has pending edits) ===== -->
            <Grid ColumnDefinitions="*" Padding="10" ColumnSpacing="10">
                <Label Grid.Column="0"
                       Text="⚠️ You have unsaved changes"
                       TextColor="{DynamicResource ThemeWarningButtonColor}"
                       VerticalTextAlignment="Center"
                       IsVisible="{Binding HasUnsavedChanges}"/>
            </Grid>

            <VerticalStackLayout Padding="20" Spacing="15">

                <!-- ===== GENERAL TAB ===== -->
                <VerticalStackLayout IsVisible="{Binding IsGeneralTabSelected}" Spacing="15">
                    <views:CurrencyPreferenceView />
                </VerticalStackLayout>

                <!-- ===== THEME TAB ===== -->
                <views:ThemeSettingsView IsVisible="{Binding IsThemeTabSelected}" />

                <!-- ===== SKINS TAB ===== -->
                <views:SkinsSettingsView IsVisible="{Binding IsSkinsTabSelected}" />

                <!-- ===== ASSET MANAGER TAB ===== -->
                <VerticalStackLayout IsVisible="{Binding IsAssetManagerTabSelected}" Spacing="15">
                    <ScrollView HeightRequest="200" MaximumWidthRequest="600" Padding="5">
                        <Grid RowDefinitions="*,*,*,*,*,*,*,*,*,*" Margin="5" RowSpacing="5">
                            <skin:SkinHost Grid.Row="0" SkinKey="primary" FallbackColor="{DynamicResource ThemePrimaryButtonColor}">
                                <Button Text="🗃️ Item Manager"
                                        TextColor="White" CornerRadius="8" HeightRequest="45"
                                        Command="{Binding OpenItemManagerCommand}"/>
                            </skin:SkinHost>
                            <skin:SkinHost Grid.Row="1" SkinKey="primary" FallbackColor="{DynamicResource ThemePrimaryButtonColor}">
                                <Button Text="👤 Background Manager"
                                        TextColor="White" CornerRadius="8" HeightRequest="45"
                                        Command="{Binding OpenBackgroundManagerCommand}"/>
                            </skin:SkinHost>
                            <skin:SkinHost Grid.Row="2" SkinKey="primary" FallbackColor="{DynamicResource ThemePrimaryButtonColor}">
                                <Button Text="🐐 Familiar Manager"
                                        TextColor="White" CornerRadius="8" HeightRequest="45"
                                        Command="{Binding OpenFamiliarManagerCommand}"/>
                            </skin:SkinHost>
                            <skin:SkinHost Grid.Row="3" SkinKey="primary" FallbackColor="{DynamicResource ThemePrimaryButtonColor}">
                                <Button Text="🗃️ Race Manager"
                                        TextColor="White" CornerRadius="8" HeightRequest="45"
                                        Command="{Binding OpenRaceManagerCommand}"/>
                            </skin:SkinHost>
                            <skin:SkinHost Grid.Row="4" SkinKey="primary" FallbackColor="{DynamicResource ThemePrimaryButtonColor}">
                                <Button Text="🗃️ Hinderance Manager"
                                        TextColor="White" CornerRadius="8" HeightRequest="45"
                                        Command="{Binding OpenHinderanceManagerCommand}"/>
                            </skin:SkinHost>
                            <skin:SkinHost Grid.Row="5" SkinKey="primary" FallbackColor="{DynamicResource ThemePrimaryButtonColor}">
                                <Button Text="📜 Blueprint Manager"
                                        TextColor="White" CornerRadius="8" HeightRequest="45"
                                        Command="{Binding OpenBlueprintManagerCommand}"/>
                            </skin:SkinHost>
                            <skin:SkinHost Grid.Row="6" SkinKey="primary" FallbackColor="{DynamicResource ThemePrimaryButtonColor}">
                                <Button Text="🔮 Spell Manager"
                                        TextColor="White" CornerRadius="8" HeightRequest="45"
                                        Command="{Binding OpenSpellManagerCommand}"/>
                            </skin:SkinHost>
                            <skin:SkinHost Grid.Row="7" SkinKey="primary" FallbackColor="{DynamicResource ThemePrimaryButtonColor}">
                                <Button Text="⚡ Quip Manager"
                                        TextColor="White" CornerRadius="8" HeightRequest="45"
                                        Command="{Binding OpenQuipManagerCommand}"/>
                            </skin:SkinHost>
                            <skin:SkinHost Grid.Row="8" SkinKey="primary" FallbackColor="{DynamicResource ThemePrimaryButtonColor}">
                                <Button Text="🧠 Technique Manager"
                                        TextColor="White" CornerRadius="8" HeightRequest="45"
                                        Command="{Binding OpenTechniqueManagerCommand}"/>
                            </skin:SkinHost>
                            <skin:SkinHost Grid.Row="9" SkinKey="primary" FallbackColor="{DynamicResource ThemePrimaryButtonColor}">
                                <Button Text="🐺 Shifter Trait Manager"
                                        TextColor="White" CornerRadius="8" HeightRequest="45"
                                        Command="{Binding OpenTraitManagerCommand}"/>
                            </skin:SkinHost>
                        </Grid>
                    </ScrollView>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" MaximumWidthRequest="800">
                        <skin:SkinHost Grid.Column="0" SkinKey="warning" FallbackColor="{DynamicResource ThemeWarningButtonColor}">
                            <Button Text="📤 Save Pack"
                                    TextColor="White" CornerRadius="8" HeightRequest="45"
                                    Command="{Binding ExportCommand}"/>
                        </skin:SkinHost>
                        <skin:SkinHost Grid.Column="1" SkinKey="confirm" FallbackColor="{DynamicResource ThemeConfirmButtonColor}">
                            <Button Text="📥 Import Pack"
                                    TextColor="White" CornerRadius="8" HeightRequest="45"
                                    Command="{Binding ImportCommand}"/>
                        </skin:SkinHost>
                        <skin:SkinHost Grid.Column="2" SkinKey="create" FallbackColor="{DynamicResource ThemeCreateButtonColor}">
                            <Button Text="📋 Copy To"
                                    TextColor="White" CornerRadius="8" HeightRequest="45"
                                    Command="{Binding CopyToCommand}"/>
                        </skin:SkinHost>
                    </Grid>

                    <Label Text="Installed Packs" FontSize="20" FontAttributes="Bold"/>

                    <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding InstalledPacks}" MaximumWidthRequest="1000">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <skin:SkinPanel StrokeColor="{DynamicResource ThemeSectionBorderColor}" StrokeThickness="1" CornerRadius="8" ContentPadding="8">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="4" Margin="5">
                                            <Label Grid.Column="0" Text="{Binding Name}" FontSize="16" FontAttributes="Bold" VerticalTextAlignment="Center"/>

                                            <skin:SkinHost Grid.Column="1" SkinKey="generic_small"
                                                           FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                                                <Button Text="▾"
                                                        FontSize="14"
                                                        TextColor="White" CornerRadius="6" WidthRequest="36" HeightRequest="36" Padding="0"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleExpandedCommand}"
                                                        CommandParameter="{Binding .}"/>
                                            </skin:SkinHost>

                                            <skin:SkinHost Grid.Column="2" SkinKey="confirm"
                                                           FallbackColor="{DynamicResource ThemeConfirmButtonColor}">
                                                <Button Text="{Binding IsLoaded, Converter={StaticResource LoadedButtonTextConverter}}"
                                                        FontSize="12"
                                                        TextColor="White" CornerRadius="6" HeightRequest="36"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.TogglePackLoadedCommand}"
                                                        CommandParameter="{Binding .}"/>
                                            </skin:SkinHost>

                                            <skin:SkinHost Grid.Column="3" SkinKey="primary"
                                                           FallbackColor="{DynamicResource ThemePrimaryButtonColor}">
                                                <Button Text="Update"
                                                        FontSize="12"
                                                        TextColor="White" CornerRadius="6" HeightRequest="36"
                                                        IsVisible="{Binding PackId, Converter={StaticResource IsNotLocalPackConverter}}"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.UpdatePackCommand}"
                                                        CommandParameter="{Binding .}"/>
                                            </skin:SkinHost>

                                            <skin:SkinHost Grid.Column="4" SkinKey="danger"
                                                           FallbackColor="{DynamicResource ThemeDangerButtonColor}">
                                                <Button Text="Delete"
                                                        FontSize="12"
                                                        TextColor="White" CornerRadius="6" HeightRequest="36"
                                                        IsVisible="{Binding PackId, Converter={StaticResource IsNotLocalPackConverter}}"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeletePackCommand}"
                                                        CommandParameter="{Binding .}"/>
                                            </skin:SkinHost>
                                        </Grid>

                                        <Label Text="{Binding Description}" FontSize="12" TextColor="Gray"
                                               IsVisible="{Binding Description, Converter={StaticResource IsNotNullConverter}}"/>

                                        <Label Text="{Binding ItemCount, StringFormat='{0} custom asset(s)'}" FontSize="12" TextColor="Gray" Margin="5"/>

                                        <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="4" Margin="0,4,0,0">
                                            <BoxView HeightRequest="1" Color="Gray"/>
                                            <Label Text="{Binding Details}" FontSize="13" LineBreakMode="WordWrap"
                                                   IsVisible="{Binding Details, Converter={StaticResource IsNotNullConverter}}"/>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </skin:SkinPanel>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>

            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="2" Margin="10" MaximumWidthRequest="600">
                <skin:SkinHost Grid.Column="0" SkinKey="neutral"
                               FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                    <Button Text="← Back"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="45"
                            Clicked="OnBackClicked"/>
                </skin:SkinHost>
                <skin:SkinHost Grid.Column="1" SkinKey="confirm"
                               FallbackColor="{DynamicResource ThemeConfirmButtonColor}">
                    <Button Text="💾 Save Changes"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="40"
                            IsEnabled="{Binding HasUnsavedChanges}"
                            Command="{Binding SaveChangesCommand}"/>
                </skin:SkinHost>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>