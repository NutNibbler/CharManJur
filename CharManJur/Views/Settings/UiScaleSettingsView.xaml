<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             x:Class="CharManJur.Views.UiScaleSettingsView">

    <ContentView.Resources>
        <Style x:Key="ScaleStepHost" TargetType="skin:SkinHost">
            <Setter Property="SkinKey" Value="generic_small" />
            <Setter Property="FallbackColor" Value="{DynamicResource ThemeNeutralButtonColor}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentView.Resources>

    <skin:SkinPanel StrokeColor="{DynamicResource ThemeDetailBorderColor1}"
                    StrokeThickness="1" CornerRadius="8" ContentPadding="12">
        <VerticalStackLayout Spacing="10">

            <Label Text="UI Scale"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource ThemeDetailBorderColor1}" />

            <Label x:Name="HelpLabel"
                   FontSize="12"
                   TextColor="Gray"
                   LineBreakMode="WordWrap" />

            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                <skin:SkinHost Grid.Column="0" Style="{StaticResource ScaleStepHost}">
                    <Button Text="−" TextColor="White" CornerRadius="6" FontSize="16"
                            WidthRequest="34" HeightRequest="34" Padding="0"
                            Clicked="OnMinusClicked" />
                </skin:SkinHost>

                <Slider x:Name="ScaleSlider" Grid.Column="1"
                        Minimum="50" Maximum="150"
                        VerticalOptions="Center"
                        ValueChanged="OnSliderChanged" />

                <skin:SkinHost Grid.Column="2" Style="{StaticResource ScaleStepHost}">
                    <Button Text="+" TextColor="White" CornerRadius="6" FontSize="16"
                            WidthRequest="34" HeightRequest="34" Padding="0"
                            Clicked="OnPlusClicked" />
                </skin:SkinHost>
            </Grid>

            <Label x:Name="ValueLabel"
                   FontSize="16"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <HorizontalStackLayout Spacing="8">
                <skin:SkinHost SkinKey="confirm" FallbackColor="{DynamicResource ThemeConfirmButtonColor}">
                    <Button Text="Apply" TextColor="White" CornerRadius="8"
                            WidthRequest="120" HeightRequest="38" Padding="14,0"
                            Clicked="OnApplyClicked" />
                </skin:SkinHost>
                <skin:SkinHost SkinKey="neutral" FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                    <Button Text="Reset to 100%" TextColor="White" CornerRadius="8"
                            WidthRequest="140" HeightRequest="38" Padding="14,0"
                            Clicked="OnResetClicked" />
                </skin:SkinHost>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </skin:SkinPanel>
</ContentView>