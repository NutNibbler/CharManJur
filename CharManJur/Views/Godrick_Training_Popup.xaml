<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:CharManJur.Converters"
             xmlns:viewmodels="clr-namespace:CharManJur.ViewModels"
             xmlns:skin="clr-namespace:CharManJur.Controls"
             x:Class="CharManJur.Views.Godrick_Training_Popup"
             Title="Skill Training"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto"
          Padding="20"
          RowSpacing="10">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="5">
            <Label Text="🎯 Skill Training"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource ThemeDetailBorderColor1}"
                   HorizontalOptions="Center" />

            <Label Text="Assign your training points to your chosen skills."
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalOptions="Center" />

            <BoxView HeightRequest="2" Color="{DynamicResource ThemeDetailBorderColor1}" />

            <Label x:Name="lblAvailablePoints"
                   Text="{Binding AvailablePoints, StringFormat='Available Points: {0}'}"
                   FontAttributes="Bold"
                   FontSize="16"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Skills List -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="8">

                <!-- ========================================= -->
                <!-- === VIGOR SKILLS === -->
                <!-- ========================================= -->
                <skin:SkinPanel StrokeColor="{StaticResource VigorColor}"
                                StrokeThickness="1" CornerRadius="8" ContentPadding="10">
                    <VerticalStackLayout Spacing="5">

                        <!-- Header with Stat Breakdown -->
                        <Label FontAttributes="Bold" FontSize="14" TextColor="{StaticResource VigorColor}">
                            <Label.Text>
                                <MultiBinding StringFormat="VIGOR SKILLS ({0})">
                                    <Binding Path="VigorDisplay" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>

                        <BoxView HeightRequest="1" Color="{StaticResource VigorColor}" />

                        <!-- Column Headers -->
                        <Grid ColumnDefinitions="0.20*, 0.10*, 0.12*, 0.12*, 0.12*, 0.10*, 0.14*" 
                              ColumnSpacing="3">
                            <Label Grid.Row="0" Grid.Column="0" Text="Skill" FontSize="11" FontAttributes="Bold" TextColor="Gray" />
                            <Label Grid.Row="0" Grid.Column="1" Text="Base" FontSize="11" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="2" Text="ASM" FontSize="11" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="3" Text="Creation Bonuses" FontSize="11" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="4" Text="Training" FontSize="11" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="5" Text="Used" FontSize="11" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="6" Text="Total" FontSize="11" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="Gray" Opacity="0.5" />

                        <!-- Vigor Skills Container -->
                        <VerticalStackLayout x:Name="VigorSkillsContainer" Spacing="3" />

                    </VerticalStackLayout>
                </skin:SkinPanel>

                <!-- ========================================= -->
                <!-- === AGILITY SKILLS === -->
                <!-- ========================================= -->
                <skin:SkinPanel StrokeColor="{StaticResource AgilityColor}"
                                StrokeThickness="1" CornerRadius="8" ContentPadding="10">
                    <VerticalStackLayout Spacing="5">

                        <Label FontAttributes="Bold" FontSize="14" TextColor="{StaticResource AgilityColor}">
                            <Label.Text>
                                <MultiBinding StringFormat="AGILITY SKILLS ({0})">
                                    <Binding Path="AgilityDisplay" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>

                        <BoxView HeightRequest="1" Color="{StaticResource AgilityColor}" />

                        <Grid ColumnDefinitions="0.20*, 0.10*, 0.12*, 0.12*, 0.12*, 0.10*, 0.14*" 
                              ColumnSpacing="3">
                            <Label Grid.Row="0" Grid.Column="0" Text="Skill" FontSize="11" FontAttributes="Bold" TextColor="Gray" />
                            <Label Grid.Row="0" Grid.Column="1" Text="Base" FontSize="11" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="2" Text="ASM" FontSize="11" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="3" Text="Creation Bonuses" FontSize="11" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="4" Text="Training" FontSize="11" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="5" Text="Used" FontSize="11" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="6" Text="Total" FontSize="11" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="Gray" Opacity="0.5" />

                        <VerticalStackLayout x:Name="AgilitySkillsContainer" Spacing="3" />

                    </VerticalStackLayout>
                </skin:SkinPanel>

                <!-- ========================================= -->
                <!-- === MIND SKILLS === -->
                <!-- ========================================= -->
                <skin:SkinPanel StrokeColor="{StaticResource MindColor}"
                                StrokeThickness="1" CornerRadius="8" ContentPadding="10">
                    <VerticalStackLayout Spacing="5">

                        <Label FontAttributes="Bold" FontSize="14" TextColor="{StaticResource MindColor}">
                            <Label.Text>
                                <MultiBinding StringFormat="MIND SKILLS ({0})">
                                    <Binding Path="MindDisplay" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>

                        <BoxView HeightRequest="1" Color="{StaticResource MindColor}" />

                        <Grid ColumnDefinitions="0.20*, 0.10*, 0.12*, 0.12*, 0.12*, 0.10*, 0.14*" 
                              ColumnSpacing="3">
                            <Label Grid.Row="0" Grid.Column="0" Text="Skill" FontSize="11" FontAttributes="Bold" TextColor="Gray" />
                            <Label Grid.Row="0" Grid.Column="1" Text="Base" FontSize="11" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="2" Text="ASM" FontSize="11" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="3" Text="Creation Bonuses" FontSize="11" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="4" Text="Training" FontSize="11" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="5" Text="Used" FontSize="11" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="6" Text="Total" FontSize="11" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="Gray" Opacity="0.5" />

                        <VerticalStackLayout x:Name="MindSkillsContainer" Spacing="3" />

                    </VerticalStackLayout>
                </skin:SkinPanel>

                <!-- ========================================= -->
                <!-- === SPIRIT SKILLS === -->
                <!-- ========================================= -->
                <skin:SkinPanel StrokeColor="{StaticResource SpiritColor}"
                                StrokeThickness="1" CornerRadius="8" ContentPadding="10">
                    <VerticalStackLayout Spacing="5">

                        <Label FontAttributes="Bold" FontSize="14" TextColor="{StaticResource SpiritColor}">
                            <Label.Text>
                                <MultiBinding StringFormat="SPIRIT SKILLS ({0})">
                                    <Binding Path="SpiritDisplay" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>

                        <BoxView HeightRequest="1" Color="{StaticResource SpiritColor}" />

                        <Grid ColumnDefinitions="0.20*, 0.10*, 0.12*, 0.12*, 0.12*, 0.10*, 0.14*" 
                              ColumnSpacing="3">
                            <Label Grid.Row="0" Grid.Column="0" Text="Skill" FontSize="11" FontAttributes="Bold" TextColor="Gray" />
                            <Label Grid.Row="0" Grid.Column="1" Text="Base" FontSize="11" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="2" Text="ASM" FontSize="11" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="3" Text="Creation Bonuses" FontSize="11" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="4" Text="Training" FontSize="11" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="5" Text="Used" FontSize="11" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="6" Text="Total" FontSize="11" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="Gray" Opacity="0.5" />

                        <VerticalStackLayout x:Name="SpiritSkillsContainer" Spacing="3" />

                    </VerticalStackLayout>
                </skin:SkinPanel>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" 
              ColumnDefinitions="*, *" 
              ColumnSpacing="10">

            <!-- Live Game Mode Buttons -->
            <Grid x:Name="LiveGameModeButtons"
                  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                  IsVisible="{Binding IsInCharacterCreation, Converter={StaticResource InvertedBoolConverter}}"
                  ColumnDefinitions="*, *"
                  ColumnSpacing="10">

                <skin:SkinHost Grid.Column="0" SkinKey="confirm"
                               FallbackColor="{DynamicResource ThemeConfirmButtonColor}">
                    <Button Text="Award Training Point"
                            TextColor="White"
                            FontSize="14"
                            CornerRadius="8"
                            HeightRequest="45"
                            Clicked="OnAwardTrainingPointClicked" />
                </skin:SkinHost>

                <skin:SkinHost Grid.Column="1" SkinKey="primary"
                               FallbackColor="{DynamicResource ThemeDetailBorderColor1}">
                    <Button Text="Return"
                            TextColor="White"
                            FontSize="16"
                            CornerRadius="8"
                            HeightRequest="45"
                            Clicked="OnReturnClicked" />
                </skin:SkinHost>
            </Grid>

            <!-- Character Creation Mode Buttons -->
            <Grid x:Name="CreationModeButtons"
                  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                  IsVisible="{Binding IsInCharacterCreation}"
                  ColumnDefinitions="*, *"
                  ColumnSpacing="10">

                <skin:SkinHost Grid.Column="0" SkinKey="neutral"
                               FallbackColor="{DynamicResource ThemeNeutralButtonColor}">
                    <Button Text="← Back"
                            TextColor="White"
                            FontSize="16"
                            CornerRadius="8"
                            HeightRequest="45"
                            Clicked="OnBackClicked" />
                </skin:SkinHost>

                <skin:SkinHost Grid.Column="1" SkinKey="confirm"
                               FallbackColor="{DynamicResource ThemeConfirmButtonColor}">
                    <Button Text="✅ Confirm"
                            TextColor="White"
                            FontSize="16"
                            CornerRadius="8"
                            HeightRequest="45"
                            FontAttributes="Bold"
                            Clicked="OnConfirmClicked" />
                </skin:SkinHost>
            </Grid>

        </Grid>

    </Grid>
</ContentPage>